mknd:CVE-2020-0041 a d3f:Vulnerability,
        owl:NamedIndividual ;
    rdfs:comment """In binder_transaction of binder.c, there is a possible out of bounds write due to an incorrect bounds check. This could lead to local escalation of privilege with no additional execution privileges needed. User interaction is not needed for exploitation.
Product: Android
Versions: Android kernel
Android ID: A-145988638
References: Upstream kernel""" ;
    mknd:attackComplexity mknd:CVSS-AttackComplexity-Low ;
    mknd:attackVector mknd:CVSS-AttackVector-Local ;
    mknd:availabilityImpact mknd:CVSS-AvailabilityImpact-High ;
    mknd:confidentialityImpact mknd:CVSS-ConfidentialityImpact-High ;
    mknd:cvssBaseScore 7.8 ;
    mknd:cvssExploitabilityScore 1.8 ;
    mknd:cvssImpactScore 5.9 ;
    mknd:integrityImpact mknd:CVSS-IntegrityImpact-High ;
    mknd:privilegesRequired mknd:CVSS-PrivilegesRequired-Low ;
    mknd:scope mknd:CVSS-Scope-Unchanged ;
    mknd:userInteraction mknd:CVSS-UserInteraction-None .

