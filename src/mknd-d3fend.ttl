@prefix : <https://w3id.org/mknd/alignment/d3fend#> .
@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mknd: <https://w3id.org/mknd/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/mknd/alignment/d3fend> .

<https://w3id.org/mknd/alignment/d3fend> rdf:type owl:Ontology ;
                                          owl:versionIRI <https://w3id.org/mknd/alignment/d3fend/0.4.0> ;
                                          owl:imports <http://d3fend.mitre.org/ontologies/d3fend/0.14.0/d3fend.owl> ;
                                          dcterms:creator <https://orcid.org/0000-0001-7399-6740> ;
                                          dcterms:description "Every MKND statement about a MITRE D3FEND term: subclass links, restrictions and inverses on D3FEND classes and properties, and icon annotations. Imports a pinned D3FEND release; upgrading D3FEND touches this module only. No terms are minted in the D3FEND namespace."@en ;
                                          dcterms:license <https://opensource.org/license/mit> ;
                                          dcterms:modified "2026-10-29"^^xsd:date ;
                                          dcterms:publisher <https://mekanoid.io> ;
                                          dcterms:title "MKND alignment to MITRE D3FEND"@en ;
                                          owl:versionInfo "0.4.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  https://w3id.org/mknd/context
mknd:context rdf:type owl:AnnotationProperty .


###  https://w3id.org/mknd/icon
mknd:icon rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes
d3f:analyzes owl:inverseOf mknd:analyzed-by .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#has-goal
d3f:has-goal rdfs:range d3f:UseCaseGoal .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#identified-by
d3f:identified-by owl:inverseOf d3f:identifies .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with
d3f:may-be-associated-with rdf:type owl:ObjectProperty ,
                                    owl:SymmetricProperty .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#recorded-in
d3f:recorded-in owl:inverseOf d3f:records .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#updates
d3f:updates owl:inverseOf mknd:updated-by .


###  https://w3id.org/mknd/analyzed-by
mknd:analyzed-by rdf:type owl:ObjectProperty .


###  https://w3id.org/mknd/attackComplexity
mknd:attackComplexity rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty .


###  https://w3id.org/mknd/attackVector
mknd:attackVector rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty .


###  https://w3id.org/mknd/availabilityImpact
mknd:availabilityImpact rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty .


###  https://w3id.org/mknd/confidentialityImpact
mknd:confidentialityImpact rdf:type owl:ObjectProperty ,
                                    owl:FunctionalProperty .


###  https://w3id.org/mknd/exploitCodeMaturity
mknd:exploitCodeMaturity rdf:type owl:ObjectProperty ,
                                  owl:FunctionalProperty .


###  https://w3id.org/mknd/integrityImpact
mknd:integrityImpact rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty .


###  https://w3id.org/mknd/privilegesRequired
mknd:privilegesRequired rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty .


###  https://w3id.org/mknd/remediationLevel
mknd:remediationLevel rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty .


###  https://w3id.org/mknd/scope
mknd:scope rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty .


###  https://w3id.org/mknd/severityRating
mknd:severityRating rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty .


###  https://w3id.org/mknd/updated-by
mknd:updated-by rdf:type owl:ObjectProperty .


###  https://w3id.org/mknd/userInteraction
mknd:userInteraction rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty .


#################################################################
#    Data properties
#################################################################

###  http://d3fend.mitre.org/ontologies/d3fend.owl#identifier
d3f:identifier rdfs:subPropertyOf owl:topDataProperty .


#################################################################
#    Classes
#################################################################

###  http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationRule
d3f:ApplicationRule rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty d3f:creates ;
                                      owl:someValuesFrom mknd:ActionableItem
                                    ] .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#Command
d3f:Command rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty d3f:has-goal ;
                              owl:someValuesFrom d3f:UseCaseGoal
                            ] .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableBinary
d3f:ExecutableBinary rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty d3f:enables ;
                                       owl:someValuesFrom d3f:Subroutine
                                     ] .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#IPAddress
d3f:IPAddress rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty d3f:used-by ;
                                owl:someValuesFrom mknd:Socket
                              ] ;
              mknd:icon "ip.svg" .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#Log
d3f:Log rdfs:subClassOf d3f:Record ;
        mknd:icon "log.svg"^^xsd:anyURI .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTrafficAnalysisSoftware
d3f:NetworkTrafficAnalysisSoftware rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty d3f:implements ;
                                                     owl:someValuesFrom d3f:NetworkTrafficAnalysis
                                                   ] .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#Record
d3f:Record mknd:icon "file.svg"^^xsd:anyURI .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#Software
d3f:Software rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty d3f:may-contain ;
                               owl:someValuesFrom d3f:Vulnerability
                             ] ;
             mknd:icon "software.svg" .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine
d3f:Subroutine rdfs:subClassOf mknd:MekaThing ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty d3f:invoked-by ;
                                 owl:someValuesFrom d3f:ExecutableBinary
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty d3f:uses ;
                                 owl:someValuesFrom d3f:IPAddress
                               ] ;
               skos:altLabel "Function"@en ;
               mknd:context "https://posts.specterops.io/on-detection-tactical-to-function-810c14798f63"^^xsd:anyURI .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount
d3f:UserAccount rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty d3f:identified-by ;
                                  owl:someValuesFrom mknd:Username
                                ] ;
                mknd:icon "user-account.svg" .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#UserAction
d3f:UserAction owl:disjointWith mknd:MachineAction .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#Vulnerability
d3f:Vulnerability rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty d3f:may-be-contained-by ;
                                    owl:someValuesFrom d3f:Software
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:attackComplexity ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-AttackComplexity
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:attackVector ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-AttackVector
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:availabilityImpact ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-AvailabilityImpact
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:confidentialityImpact ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-ConfidentialityImpact
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:exploitCodeMaturity ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-ExploitCodeMaturity
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:integrityImpact ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-IntegrityImpact
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:privilegesRequired ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-PrivilegesRequired
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:remediationLevel ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-RemediationLevel
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:scope ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-Scope
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:severityRating ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-SeverityType
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mknd:userInteraction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass mknd:CVSS-UserInteraction
                                  ] ;
                  mknd:icon "vulnerability.svg"^^xsd:anyURI .


###  https://w3id.org/mknd/ActionableItem
mknd:ActionableItem rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-AttackComplexity
mknd:CVSS-AttackComplexity rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-AttackVector
mknd:CVSS-AttackVector rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-AvailabilityImpact
mknd:CVSS-AvailabilityImpact rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-ConfidentialityImpact
mknd:CVSS-ConfidentialityImpact rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-ExploitCodeMaturity
mknd:CVSS-ExploitCodeMaturity rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-IntegrityImpact
mknd:CVSS-IntegrityImpact rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-PrivilegesRequired
mknd:CVSS-PrivilegesRequired rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-RemediationLevel
mknd:CVSS-RemediationLevel rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-Scope
mknd:CVSS-Scope rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-SeverityType
mknd:CVSS-SeverityType rdf:type owl:Class .


###  https://w3id.org/mknd/CVSS-UserInteraction
mknd:CVSS-UserInteraction rdf:type owl:Class .


###  https://w3id.org/mknd/MachineAction
mknd:MachineAction rdf:type owl:Class .


###  https://w3id.org/mknd/MekaThing
mknd:MekaThing rdf:type owl:Class .


###  https://w3id.org/mknd/Socket
mknd:Socket rdf:type owl:Class .


###  https://w3id.org/mknd/Username
mknd:Username rdf:type owl:Class .


