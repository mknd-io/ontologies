@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mknd: <https://w3id.org/mknd/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

xsd:date a rdfs:Datatype .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

mknd: a owl:Ontology ;
    dcterms:created "2022-04-02"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-7399-6740> ;
    dcterms:description "Mekanoid Ontology (MKND) is a public ontology for semantic knowledge graph applications. It is defined with a purpose to make trusted and autonomous cybersecurity prevention and response possible. It is a superset of the MITRE D3FEND ontology, and is designed to be used in conjunction with it. Mekanoid is a work in progress, and is subject to change."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:modified "2026-10-29"^^xsd:date ;
    dcterms:publisher <https://mekanoid.io> ;
    dcterms:title "Mekanoid Ontology (MKND)"@en ;
    vann:preferredNamespacePrefix "mknd" ;
    vann:preferredNamespaceUri "https://w3id.org/mknd/"^^xsd:anyURI ;
    rdfs:comment "Use of the MKND, and the associated references from this ontology are subject to the Terms of Use. Copyright 2021 Neon Lane Co DBA Mekanoid Corporation."@en ;
    owl:imports <https://w3id.org/mknd/alignment/d3fend> ;
    owl:priorVersion <https://mekanoid.io/ontology/0.3.0/> ;
    owl:versionIRI <https://w3id.org/mknd/0.4.0/> ;
    owl:versionInfo "0.4.0" .

mknd:ASN a owl:Class ;
    rdfs:label "ASN"@en ;
    rdfs:comment "Autonomous System Number"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty mknd:value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        d3f:Identifier,
        mknd:MekaThing .

mknd:Advisory a owl:Class ;
    rdfs:label "Advisory"@en ;
    rdfs:isDefinedBy "https://csrc.nist.gov/glossary/term/advisory"^^xsd:anyURI ;
    rdfs:subClassOf d3f:Document,
        mknd:MekaThing ;
    skos:definition "Notification of significant new trends or developments regarding the threat to the information systems of an organization. This notification may include analytical insights into trends, intentions, technologies, or tactics of an adversary targeting information systems. Rationale: General definition of a commonly understood term."@en .

mknd:CriticalVulnerability a owl:Class ;
    rdfs:label "Critical Severity Vulnerability" ;
    rdfs:subClassOf d3f:Vulnerability ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( d3f:Vulnerability [ a owl:Class ;
                        owl:unionOf ( [ a owl:Class ;
                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                owl:onProperty mknd:cvssBaseScore ;
                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:decimal ;
                                                        owl:withRestrictions ( [ xsd:minInclusive 9.0 ] ) ] ] [ a owl:Restriction ;
                                                owl:onProperty mknd:cvssBaseScore ;
                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:decimal ;
                                                        owl:withRestrictions ( [ xsd:maxInclusive 10.0 ] ) ] ] ) ] [ a owl:Restriction ;
                                    owl:hasValue mknd:CVSS-SeverityType-Critical ;
                                    owl:onProperty mknd:severityRating ] ) ] ) ] .

mknd:DNS-Service a owl:NamedIndividual,
        mknd:NetworkServiceProtocol ;
    rdfs:label "DNS Service"@en ;
    rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Domain_Name_System" ;
    mknd:provided-by <https://w3id.org/mknd/10.1.12.1:53> .

mknd:EmailSenderString a owl:Class ;
    rdfs:label "Email Sender"@en ;
    rdfs:comment "A string showing a combination of a name and the email address in angle brackets."@en ;
    rdfs:subClassOf mknd:Observable ;
    skos:example "Britney Greenman <mexragasu@gmail.com>" .

mknd:EmailSubjectString a owl:Class ;
    rdfs:label "Email Subject"@en ;
    rdfs:subClassOf mknd:Observable ;
    skos:example "Fwd: Fwd: Re: RE: RE: LOL" .

mknd:FTP-Service a owl:NamedIndividual,
        mknd:NetworkServiceProtocol ;
    rdfs:label "FTP Service"@en .

mknd:HTTP-Service a owl:NamedIndividual,
        mknd:NetworkServiceProtocol ;
    rdfs:label "HTTP Service" .

mknd:HighVulnerability a owl:Class ;
    rdfs:label "High Severity Vulnerability" ;
    rdfs:subClassOf d3f:Vulnerability ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( d3f:Vulnerability [ a owl:Class ;
                        owl:unionOf ( [ a owl:Class ;
                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                owl:onProperty mknd:cvssBaseScore ;
                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:decimal ;
                                                        owl:withRestrictions ( [ xsd:minInclusive 7.0 ] ) ] ] [ a owl:Restriction ;
                                                owl:onProperty mknd:cvssBaseScore ;
                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:decimal ;
                                                        owl:withRestrictions ( [ xsd:maxExclusive 9.0 ] ) ] ] ) ] [ a owl:Restriction ;
                                    owl:hasValue mknd:CVSS-AvailabilityImpact-High ;
                                    owl:onProperty mknd:severityRating ] ) ] ) ] .

mknd:IOCRule a owl:Class ;
    rdfs:label "IOC" ;
    rdfs:subClassOf mknd:DetectionRule .

mknd:IPv4 a owl:Class ;
    rdfs:label "IP Address v4"@en ;
    rdfs:subClassOf d3f:IPAddress .

mknd:IPv6 a owl:Class ;
    rdfs:label "IP Address v6"@en ;
    rdfs:subClassOf d3f:IPAddress .

mknd:LowSeverityVulnerability a owl:Class ;
    rdfs:label "Low Severity Vulnerability" ;
    rdfs:subClassOf d3f:Vulnerability ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( d3f:Vulnerability [ a owl:Class ;
                        owl:unionOf ( [ a owl:Class ;
                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                owl:onProperty mknd:cvssBaseScore ;
                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:decimal ;
                                                        owl:withRestrictions ( [ xsd:minExclusive 0.0 ] ) ] ] [ a owl:Restriction ;
                                                owl:onProperty mknd:cvssBaseScore ;
                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:decimal ;
                                                        owl:withRestrictions ( [ xsd:maxExclusive 4.0 ] ) ] ] ) ] [ a owl:Restriction ;
                                    owl:hasValue mknd:CVSS-AttackComplexity-Low ;
                                    owl:onProperty mknd:severityRating ] ) ] ) ] .

mknd:MACAddress a owl:Class ;
    rdfs:label "MAC Address"@en ;
    rdfs:subClassOf d3f:Identifier,
        mknd:Observable ;
    skos:example "00-1B-63-84-45-E6",
        "00:1b:63:84:45:e6" .

mknd:MD5 a owl:Class ;
    rdfs:label "MD5 Hash"@en ;
    rdfs:comment "MD5 cryptographic hash value"@en ;
    rdfs:subClassOf mknd:Hash .

mknd:Malware a owl:Class ;
    rdfs:label "Malicious Software" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:associated-with ;
            owl:someValuesFrom d3f:DomainName ],
        [ a owl:Restriction ;
            owl:onProperty d3f:associated-with ;
            owl:someValuesFrom d3f:IPAddress ],
        [ a owl:Restriction ;
            owl:onProperty d3f:identified-by ;
            owl:someValuesFrom d3f:FileHash ],
        [ a owl:Restriction ;
            owl:onProperty d3f:identified-by ;
            owl:someValuesFrom d3f:URL ],
        [ a owl:Restriction ;
            owl:onProperty d3f:identified-by ;
            owl:someValuesFrom mknd:Hash ],
        [ a owl:Restriction ;
            owl:onProperty mknd:mayBeIndicatedBy ;
            owl:someValuesFrom d3f:DomainName ],
        [ a owl:Restriction ;
            owl:onProperty mknd:mayBeIndicatedBy ;
            owl:someValuesFrom d3f:IPAddress ],
        [ a owl:Restriction ;
            owl:onProperty mknd:mayBeIndicatedBy ;
            owl:someValuesFrom mknd:FileName ],
        d3f:Software,
        mknd:MekaThing ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( d3f:Software [ a owl:Restriction ;
                        owl:onProperty d3f:has-goal ;
                        owl:someValuesFrom d3f:OffensiveTechnique ] ) ] ;
    skos:altLabel "Malware" .

mknd:MediumSeverityVulnerability a owl:Class ;
    rdfs:label "Medium Severity Vulnerability" ;
    rdfs:subClassOf d3f:Vulnerability ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( d3f:Vulnerability [ a owl:Class ;
                        owl:unionOf ( [ a owl:Class ;
                                    owl:intersectionOf ( [ a owl:Restriction ;
                                                owl:onProperty mknd:cvssBaseScore ;
                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:decimal ;
                                                        owl:withRestrictions ( [ xsd:minInclusive 4.0 ] ) ] ] [ a owl:Restriction ;
                                                owl:onProperty mknd:cvssBaseScore ;
                                                owl:someValuesFrom [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:decimal ;
                                                        owl:withRestrictions ( [ xsd:maxExclusive 7.0 ] ) ] ] ) ] [ a owl:Restriction ;
                                    owl:hasValue mknd:CVSS-SeverityType-Medium ;
                                    owl:onProperty mknd:severityRating ] ) ] ) ] .

mknd:NPMPackage a owl:Class ;
    rdfs:label "NPM Package" ;
    rdfs:subClassOf d3f:SoftwarePackage,
        mknd:MekaThing .

mknd:Neon_Lane_Co_DBA_Mekanoid_Corporation a d3f:Organization,
        owl:NamedIndividual ;
    rdfs:label "Mekanoid Corporation" .

mknd:Operation a owl:Class ;
    rdfs:label "Operation"@en ;
    rdfs:subClassOf mknd:MekaThing ;
    mknd:context "https://posts.specterops.io/on-detection-tactical-to-function-810c14798f63"^^xsd:anyURI .

mknd:Path a owl:Class ;
    rdfs:label "Path"@en ;
    rdfs:subClassOf mknd:Observable ;
    skos:definition "A generic URI string pointing to location of a directory or file on one or multiple systems." .

mknd:Payload a owl:Class ;
    rdfs:label "Payload"@en ;
    rdfs:subClassOf mknd:MekaThing .

mknd:PrivateIPAddress a owl:Class ;
    rdfs:label "Private IP Address"@en ;
    rdfs:isDefinedBy "https://en.wikipedia.org/wiki/IP_address#Private_addresses"^^xsd:anyURI ;
    rdfs:subClassOf d3f:IPAddress ;
    skos:example "10.0.0.1",
        "192.168.0.1" ;
    mknd:icon "ip.svg" .

mknd:PublicIPAddress a owl:Class ;
    rdfs:label "Public IP Address"@en ;
    rdfs:comment "A public IP address is a globally routable unicast IP address, meaning that the address is not an address reserved for use in private networks, such as those reserved by RFC 1918, or the various IPv6 address formats of local scope or site-local scope, for example for link-local addressing. Public IP addresses may be used for communication between hosts on the global Internet. In a home situation, a public IP address is the IP address assigned to the home's network by the ISP. In this case, it is also locally visible by logging into the router configuration."@en ;
    rdfs:isDefinedBy "https://en.wikipedia.org/wiki/IP_address#Public_address"^^xsd:anyURI ;
    rdfs:subClassOf d3f:IPAddress ;
    skos:example "4.2.2.1",
        "8.8.8.8" ;
    mknd:icon "ip.svg" .

mknd:SHA1 a owl:Class ;
    rdfs:label "SHA-1 Hash"@en ;
    rdfs:comment "SHA-1 cryptographic hash value"@en ;
    rdfs:subClassOf mknd:Hash .

mknd:SHA256 a owl:Class ;
    rdfs:label "SHA-256 Hash"@en ;
    rdfs:comment "SHA-256 cryptographic hash value"@en ;
    rdfs:subClassOf mknd:Hash .

mknd:SHA512 a owl:Class ;
    rdfs:label "SHA-512 Hash"@en ;
    rdfs:subClassOf mknd:Hash .

mknd:SSH-Service a owl:NamedIndividual,
        mknd:NetworkServiceProtocol ;
    rdfs:label "SSH Service"@en .

mknd:SSL-Service a owl:NamedIndividual,
        mknd:NetworkServiceProtocol ;
    rdfs:label "SSL Service" ;
    skos:altLabel "HTTPS Service" .

mknd:SecurityPolicy a owl:Class ;
    rdfs:label "Security Policy" ;
    rdfs:subClassOf d3f:ApplicationRule,
        mknd:Control ;
    mknd:icon "cube.svg"^^xsd:anyURI .

mknd:Sigma a owl:Class ;
    rdfs:label "Sigma Rule"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:contained-by ;
            owl:someValuesFrom d3f:ConfigurationFile ],
        mknd:DetectionRule ;
    mknd:icon "rule-sigma.svg" .

mknd:Signature a owl:Class ;
    rdfs:label "Signature"@en ;
    rdfs:subClassOf mknd:DetectionRule .

mknd:Ticket a owl:Class ;
    rdfs:label "Ticket"@en ;
    rdfs:subClassOf mknd:ActionableItem ;
    skos:altLabel "Issue"@en,
        "Task"@en ;
    mknd:icon "ticket.svg" .

mknd:UseCaseGoal-Upload a d3f:UseCaseGoal,
        owl:NamedIndividual ;
    rdfs:label "Upload" .

mknd:Username a owl:Class ;
    rdfs:label "Username"@en ;
    rdfs:subClassOf mknd:Observable .

mknd:Yara a owl:Class ;
    rdfs:label "YARA Rule"@en ;
    rdfs:subClassOf mknd:DetectionRule ;
    mknd:icon "rule-yara.svg" .

mknd:analyzed-by a owl:ObjectProperty ;
    rdfs:label "analyzed by"@en .

mknd:attackComplexity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "attack complexity" ;
    rdfs:range mknd:CVSS-AttackComplexity ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:attackVector a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "attack vector"@en ;
    rdfs:range mknd:CVSS-AttackVector ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:availabilityImpact a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "availability impact"@en ;
    rdfs:range mknd:CVSS-AvailabilityImpact ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:confidentialityImpact a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "confidentiality impact"@en ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:connected-by a owl:ObjectProperty ;
    rdfs:label "connected by"@en ;
    rdfs:subPropertyOf d3f:d3fend-catalog-object-property ;
    owl:inverseOf d3f:connects .

mknd:context a owl:AnnotationProperty ;
    rdfs:label "context"@en ;
    rdfs:subPropertyOf rdfs:comment .

mknd:cpe a owl:DatatypeProperty ;
    rdfs:label "CPE" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf d3f:identifier ;
    skos:example "cpe:2.3:a:apple:icloud:1.0:*:*:*:*:macos:*:*" .

mknd:exploitCodeMaturity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "exploit code maturity" ;
    rdfs:range mknd:CVSS-ExploitCodeMaturity ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:extCategory a owl:DatatypeProperty ;
    rdfs:label "category" ;
    rdfs:subPropertyOf mknd:vendorProperty .

mknd:extPriority a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Priority"@en ;
    rdfs:comment "Priority as defined by the 3rd party vendor responsible for creating the Artifact."@en ;
    rdfs:subPropertyOf mknd:extClassification .

mknd:extRisk a owl:DatatypeProperty ;
    rdfs:label "Risk"@en ;
    rdfs:comment "Risk as defined by the 3rd party vendor responsible for creating the Artifact."@en ;
    rdfs:subPropertyOf mknd:extClassification .

mknd:extSeverity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Severity"@en ;
    rdfs:comment "Severity as defined by the 3rd party vendor responsible for creating the Artifact."@en ;
    rdfs:subPropertyOf mknd:extClassification .

mknd:extStatus a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Status of the Artifact as defined by the 3rd party vendor software responsible for generating it."@en ;
    rdfs:subPropertyOf mknd:vendorProperty .

mknd:extThreat a owl:DatatypeProperty ;
    rdfs:label "Threat Level"@en ;
    rdfs:comment "Threat Level as defined by the 3rd party vendor responcible for creating the Artifact."@en ;
    rdfs:subPropertyOf mknd:extClassification .

mknd:extType a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:subPropertyOf mknd:vendorProperty .

mknd:extUrgency a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Urgency"@en ;
    rdfs:comment "Urgency as defined by the 3rd party vendor responsible for generating the Artifact."@en ;
    rdfs:subPropertyOf mknd:extClassification .

mknd:external-id a owl:DatatypeProperty ;
    rdfs:label "external ID"@en ;
    rdfs:subPropertyOf d3f:identifier,
        mknd:vendorProperty ;
    skos:altLabel "vendor ID" ;
    skos:definition "Mekanoid data property that represents an identifier assigned by an external system or vendor. It is applicable to entities such as hosts and user accounts, providing a unique string-based identifier that aligns with external records or systems. This property facilitates the integration and mapping of internal entities with external references, enhancing cross-system data coherence and identification." .

mknd:http_server a d3f:SoftwareProduct,
        d3f:WebServerApplication,
        owl:NamedIndividual ;
    rdfs:label "HTTP server application"@en .

mknd:icon a owl:AnnotationProperty ;
    rdfs:label "has icon"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:anyURI .

mknd:id a owl:DatatypeProperty ;
    rdfs:label "ID"@en ;
    rdfs:subPropertyOf d3f:identifier ;
    skos:definition "Mekanoid ID" .

mknd:importBucketName a owl:DatatypeProperty ;
    rdfs:label "S3 bucket name"@en .

mknd:importBucketUrl a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "S3 bucket URL"@en ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf mknd:hasURL .

mknd:importFileName a owl:DatatypeProperty ;
    rdfs:label "filename"@en ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf owl:topDataProperty .

mknd:importId a owl:DatatypeProperty ;
    rdfs:label "import ID"@en ;
    rdfs:subPropertyOf d3f:identifier .

mknd:indicatedBy a owl:ObjectProperty ;
    rdfs:label "indicated by"@en ;
    rdfs:subPropertyOf mknd:mayBeIndicatedBy ;
    owl:inverseOf mknd:indicates .

mknd:integrityImpact a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "integrity impact"@en ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:isolated-by a owl:ObjectProperty ;
    rdfs:label "isolated by"@en ;
    rdfs:subPropertyOf d3f:d3fend-catalog-object-property .

mknd:lastAccessedEpoch a owl:DatatypeProperty ;
    rdfs:label "last accessed"@en ;
    rdfs:subPropertyOf mknd:dateTimeEpoch .

mknd:lastSeenEpoch a owl:DatatypeProperty ;
    rdfs:label "last seen (epoch)"@en ;
    rdfs:subPropertyOf mknd:dateTimeEpoch .

mknd:lastStatusChangeEpoch a owl:DatatypeProperty ;
    rdfs:label "last status change"@en ;
    rdfs:subPropertyOf mknd:dateTimeEpoch .

mknd:lastUpdated a owl:DatatypeProperty ;
    rdfs:label "last updated at" ;
    rdfs:subPropertyOf mknd:updated ;
    skos:altLabel "last modified at" .

mknd:lastUpdatedEpoch a owl:DatatypeProperty ;
    rdfs:label "last modified"@en ;
    rdfs:subPropertyOf mknd:dateTimeEpoch .

mknd:last_modified a owl:DatatypeProperty ;
    rdfs:label "last modified" ;
    rdfs:subPropertyOf mknd:updated .

mknd:mkndObjectProperty a owl:ObjectProperty ;
    rdfs:label "MKND object property"@en ;
    rdfs:subPropertyOf mknd:supports .

mknd:privilegesRequired a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "privileges required"@en ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:provided-by a owl:ObjectProperty ;
    rdfs:label "provided by"@en ;
    rdfs:subPropertyOf d3f:d3fend-catalog-object-property ;
    owl:inverseOf d3f:provides .

mknd:remediationLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "remediation level" ;
    rdfs:range mknd:CVSS-RemediationLevel ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:reportConfidence a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "report confidence" ;
    rdfs:range mknd:CVSS-ReportConfidence ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:scope a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "scope"@en ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:size a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has size"@en ;
    rdfs:domain d3f:File ;
    rdfs:range xsd:byte .

mknd:stringValue a owl:DatatypeProperty ;
    rdfs:label "is"@en ;
    rdfs:comment "the object is represented by the following string value"@en ;
    rdfs:domain mknd:Observable ;
    rdfs:range xsd:string .

mknd:timeCreatedEpoch a owl:DatatypeProperty ;
    rdfs:label "created at (epoch)"@en ;
    rdfs:comment "Time when the entity had been created at the point of origin."@en ;
    rdfs:subPropertyOf mknd:dateTimeEpoch .

mknd:updated-by a owl:ObjectProperty ;
    rdfs:label "updated by" ;
    rdfs:subPropertyOf d3f:modified-by .

mknd:userInteraction a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "user interaction"@en ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:vectorString a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "vector" ;
    rdfs:domain d3f:Vulnerability ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

mknd:version a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "CVSS version" ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

mknd:ApplicationUserAccount a owl:Class ;
    rdfs:label "Application User Account" ;
    rdfs:subClassOf d3f:UserAccount .

mknd:AutomatedTaskRun a owl:Class ;
    rdfs:label "Automated Task Run" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mknd:TaskPattern ;
            owl:onProperty d3f:invoked-by ],
        mknd:MachineAction,
        mknd:TaskRun .

mknd:CVSS-AttackComplexity-High a owl:NamedIndividual,
        mknd:CVSS-AttackComplexity ;
    rdfs:label "High" ;
    owl:differentFrom mknd:CVSS-AttackComplexity-Low ;
    skos:altLabel "AC:H" ;
    skos:definition """A successful attack depends on conditions beyond the attacker's control. That is, a successful attack cannot be accomplished at will, but requires the attacker to invest in some measurable amount of effort in preparation or execution against the vulnerable component before a successful attack can be expected. For example, a successful attack may depend on an attacker overcoming any of the following conditions:
- The attacker must gather knowledge about the environment in which the vulnerable target/component exists. For example, a requirement to collect details on target configuration settings, sequence numbers, or shared secrets.
- The attacker must prepare the target environment to improve exploit reliability. For example, repeated exploitation to win a race condition, or overcoming advanced exploit mitigation techniques.
- The attacker must inject themselves into the logical network path between the target and the resource requested by the victim in order to read and/or modify network communications (e.g., a man in the middle attack).""" ;
    mknd:value "HIGH" ;
    mknd:version 3.1 .

mknd:CVSS-Scope-Changed a owl:NamedIndividual,
        mknd:CVSS-Scope ;
    rdfs:label "Changed" ;
    owl:differentFrom mknd:CVSS-Scope-Unchanged ;
    skos:altLabel "S:C" ;
    skos:definition "An exploited vulnerability can affect resources beyond the security scope managed by the security authority of the vulnerable component. In this case, the vulnerable component and the impacted component are different and managed by different security authorities." ;
    mknd:value "CHANGED" ;
    mknd:version 3.1 .

mknd:CVSS-UserInteraction-None a owl:NamedIndividual,
        mknd:CVSS-UserInteraction ;
    rdfs:label "None" ;
    owl:differentFrom mknd:CVSS-UserInteraction-Required ;
    skos:altLabel "UI:N" ;
    skos:definition "The vulnerable system can be exploited without interaction from any user." ;
    mknd:value "NONE" .

mknd:Connection a owl:Class ;
    rdfs:label "Connection"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mknd:Integration ;
            owl:onProperty d3f:enables ],
        [ a owl:Restriction ;
            owl:onProperty d3f:enables ;
            owl:someValuesFrom mknd:Task ],
        [ a owl:Restriction ;
            owl:onProperty mknd:supports ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( d3f:SoftwareProduct d3f:SoftwareService ) ] ],
        mknd:SystemObject ;
    mknd:icon "connection.svg"^^xsd:anyURI .

mknd:Control a owl:Class ;
    rdfs:label "Control"@en ;
    rdfs:subClassOf mknd:MekaThing .

mknd:Detection a owl:Class ;
    rdfs:label "Finding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:produces ;
            owl:someValuesFrom mknd:ActionableItem ],
        [ a owl:Restriction ;
            owl:allValuesFrom mknd:DetectionRule ;
            owl:onProperty d3f:created-by ],
        d3f:DigitalEvent ;
    skos:altLabel "Alert"@en,
        "Detection"@en,
        "Signal"@en ;
    mknd:icon "signal.svg" .

mknd:FileName a owl:Class ;
    rdfs:label "File Name"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:used-by ;
            owl:someValuesFrom d3f:File ],
        mknd:Observable .

mknd:Filter a owl:Class ;
    rdfs:label "Filter"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:used-by ;
            owl:someValuesFrom mknd:TaskPattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom mknd:AppUser ;
            owl:onProperty d3f:created-by ],
        mknd:SystemObject ;
    skos:definition "A logical statement specifying scope for a Report or a Task Pattern. Identifies one or more Artifacts with or without specific relationships between them, essentially a subgraph. e.g. a FILTER statement within a SPARQL query." .

mknd:Incident a owl:Class ;
    rdfs:label "Incident"@en ;
    rdfs:comment "A ticket or a case associated with a cybersecurity incident." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mknd:IncidentStatus ;
            owl:onProperty d3f:records ],
        mknd:ActionableItem ;
    skos:altLabel "Case"@en ;
    mknd:icon "case.svg" .

mknd:IncidentStatus-Closed a owl:NamedIndividual,
        mknd:IncidentStatus ;
    rdfs:label "Closed" .

mknd:IncidentStatus-Open a owl:NamedIndividual,
        mknd:IncidentStatus ;
    rdfs:label "Open" .

mknd:IncidentStatus-Unknown a owl:NamedIndividual,
        mknd:IncidentStatus ;
    rdfs:label "Unknown" .

mknd:MachineAction a owl:Class ;
    rdfs:label "Machine Action" ;
    rdfs:subClassOf d3f:DigitalEvent,
        mknd:MekaThing ;
    skos:definition "An action performed by an automapted process, script, or an application following a high level objective. May contain a single or miple Commands. Managing systems and application resources by interacting with API endpoints are examples of machine actions." .

mknd:ManualTaskRun a owl:Class ;
    rdfs:label "Manual Task Run" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mknd:AppUser ;
            owl:onProperty d3f:invoked-by ],
        d3f:UserAction,
        mknd:TaskRun .

mknd:Tenant a owl:Class ;
    rdfs:label "Tenant"@en ;
    rdfs:comment "Mekanoid Tenant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:may-be-accessed-by ;
            owl:someValuesFrom mknd:AppUser ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mknd:teamId ],
        mknd:SystemObject ;
    mknd:icon "biz-unit.svg"^^xsd:anyURI .

mknd:cvssExploitabilityScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "exploitability score" ;
    rdfs:domain d3f:Vulnerability ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

mknd:cvssImpactScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "impact score" ;
    rdfs:domain d3f:Vulnerability ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

mknd:firstSeen a owl:DatatypeProperty ;
    rdfs:label "first seen"@en ;
    rdfs:comment "The first time the enity had been observed by the application."@en ;
    rdfs:subPropertyOf mknd:timeSeen .

mknd:firstSeenEpoch a owl:DatatypeProperty ;
    rdfs:label "first seen (epoch)"@en ;
    rdfs:subPropertyOf mknd:dateTimeEpoch .

mknd:hasURL a owl:DatatypeProperty ;
    rdfs:label "has URL"@en ;
    rdfs:domain d3f:File,
        mknd:Report ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf mknd:reference .

mknd:indicates a owl:ObjectProperty ;
    rdfs:label "indicates"@en ;
    rdfs:subPropertyOf mknd:mayIndicate .

mknd:lastSeen a owl:DatatypeProperty ;
    rdfs:label "last seen"@en ;
    rdfs:comment "The last time the entity had been observed by the application."@en ;
    rdfs:subPropertyOf mknd:timeSeen .

mknd:reference a owl:DatatypeProperty ;
    rdfs:label "has reference" ;
    rdfs:subPropertyOf owl:topDataProperty .

mknd:teamId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "team ID"@en ;
    rdfs:subPropertyOf d3f:identifier ;
    owl:propertyDisjointWith mknd:userId .

mknd:templateId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "template ID"@en ;
    rdfs:subPropertyOf d3f:identifier .

mknd:timeCreated a owl:DatatypeProperty ;
    rdfs:label "created at"@en ;
    rdfs:comment "Time when the entity had been created at the point of origin."@en ;
    rdfs:subPropertyOf mknd:dateTime .

mknd:usesNetworkPort a owl:DatatypeProperty ;
    rdfs:label "uses port" ;
    rdfs:comment "uses network port number" ;
    rdfs:range xsd:positiveInteger .

mknd:CVSS-AttackVector-Adjacent a owl:NamedIndividual,
        mknd:CVSS-AttackVector ;
    rdfs:label "Adjacent" ;
    skos:altLabel "AV:A" ;
    skos:definition "The vulnerable component is bound to the network stack, but the attack is limited at the protocol level to a logically adjacent topology. This can mean an attack must be launched from the same shared physical (e.g., Bluetooth or IEEE 802.11) or logical (e.g., local IP subnet) network, or from within a secure or otherwise limited administrative domain (e.g., MPLS, secure VPN to an administrative network zone). One example of an Adjacent attack would be an ARP (IPv4) or neighbor discovery (IPv6) flood leading to a denial of service on the local LAN segment (e.g., CVE‑2013‑6014)." ;
    mknd:value "ADJACENT" ;
    mknd:version 3.1 .

mknd:CVSS-AttackVector-Local a owl:NamedIndividual,
        mknd:CVSS-AttackVector ;
    rdfs:label "Local" ;
    skos:altLabel "AV:L" ;
    skos:definition """The vulnerable component is not bound to the network stack and the attacker’s path is via read/write/execute capabilities. Either:
- the attacker exploits the vulnerability by accessing the target system locally (e.g., keyboard, console), or remotely (e.g., SSH); or
- the attacker relies on User Interaction by another person to perform actions required to exploit the vulnerability (e.g., using social engineering techniques to trick a legitimate user into opening a malicious document).""" ;
    mknd:value "LOCAL" ;
    mknd:version 3.1 .

mknd:CVSS-AttackVector-Network a owl:NamedIndividual,
        mknd:CVSS-AttackVector ;
    rdfs:label "Network" ;
    skos:altLabel "AV:N" ;
    skos:definition "The vulnerable component is bound to the network stack and the set of possible attackers extends beyond the other options listed below, up to and including the entire Internet. Such a vulnerability is often termed “remotely exploitable” and can be thought of as an attack being exploitable at the protocol level one or more network hops away (e.g., across one or more routers). An example of a network attack is an attacker causing a denial of service (DoS) by sending a specially crafted TCP packet across a wide area network (e.g., CVE‑2004‑0230)." ;
    mknd:value "NETWORK" ;
    mknd:version 3.1 .

mknd:CVSS-AttackVector-Physical a owl:NamedIndividual,
        mknd:CVSS-AttackVector ;
    rdfs:label "Physical" ;
    skos:altLabel "AV:P" ;
    skos:definition "The attack requires the attacker to physically touch or manipulate the vulnerable component. Physical interaction may be brief (e.g., evil maid attack1) or persistent. An example of such an attack is a cold boot attack in which an attacker gains access to disk encryption keys after physically accessing the target system. Other examples include peripheral attacks via FireWire/USB Direct Memory Access (DMA)." ;
    mknd:value "PHYSICAL" ;
    mknd:version 3.1 .

mknd:CVSS-AvailabilityImpact-Low a owl:NamedIndividual,
        mknd:CVSS-AvailabilityImpact ;
    rdfs:label "Low" ;
    skos:altLabel "A:L" ;
    skos:definition "Performance is reduced or there are interruptions in resource availability. Even if repeated exploitation of the vulnerability is possible, the attacker does not have the ability to completely deny service to legitimate users. The resources in the impacted component are either partially available all of the time, or fully available only some of the time, but overall there is no direct, serious consequence to the impacted component." ;
    mknd:value "LOW" .

mknd:CVSS-AvailabilityImpact-None a owl:NamedIndividual,
        mknd:CVSS-AvailabilityImpact ;
    rdfs:label "None" ;
    skos:altLabel "A:N" ;
    skos:definition "There is no impact to availability within the impacted component." ;
    mknd:value "NONE" .

mknd:CVSS-ConfidentialityImpact-High a owl:NamedIndividual,
        mknd:CVSS-ConfidentialityImpact ;
    rdfs:label "High" ;
    skos:altLabel "C:H" ;
    skos:definition "There is a total loss of confidentiality, resulting in all resources within the impacted component being divulged to the attacker. Alternatively, access to only some restricted information is obtained, but the disclosed information presents a direct, serious impact. For example, an attacker steals the administrator's password, or private encryption keys of a web server." ;
    mknd:value "HIGH" .

mknd:CVSS-ConfidentialityImpact-Low a owl:NamedIndividual,
        mknd:CVSS-ConfidentialityImpact ;
    rdfs:label "Low" ;
    skos:altLabel "C:L" ;
    skos:definition "There is some loss of confidentiality. Access to some restricted information is obtained, but the attacker does not have control over what information is obtained, or the amount or kind of loss is limited. The information disclosure does not cause a direct, serious loss to the impacted component." ;
    mknd:value "LOW" .

mknd:CVSS-ConfidentialityImpact-None a owl:NamedIndividual,
        mknd:CVSS-ConfidentialityImpact ;
    rdfs:label "None" ;
    skos:altLabel "C:N" ;
    skos:definition "There is no loss of confidentiality within the impacted component." ;
    mknd:value "NONE" .

mknd:CVSS-ExploitCodeMaturity-Functional a owl:NamedIndividual,
        mknd:CVSS-ExploitCodeMaturity ;
    rdfs:label "Functional" ;
    skos:altLabel "E:F" ;
    skos:definition "Functional exploit code is available. The code works in most situations where the vulnerability exists." ;
    mknd:value "FUNCTIONAL" .

mknd:CVSS-ExploitCodeMaturity-High a owl:NamedIndividual,
        mknd:CVSS-ExploitCodeMaturity ;
    rdfs:label "High" ;
    skos:altLabel "E:H" ;
    skos:definition "Functional autonomous code exists, or no exploit is required (manual trigger) and details are widely available. Exploit code works in every situation, or is actively being delivered via an autonomous agent (such as a worm or virus). Network-connected systems are likely to encounter scanning or exploitation attempts. Exploit development has reached the level of reliable, widely available, easy-to-use automated tools." ;
    mknd:value "HIGH" .

mknd:CVSS-ExploitCodeMaturity-NotDefined a owl:NamedIndividual,
        mknd:CVSS-ExploitCodeMaturity ;
    rdfs:label "Not Defined (X)" ;
    skos:altLabel "E:X" ;
    skos:definition "Assigning this value indicates there is insufficient information to choose one of the other values, and has no impact on the overall Temporal Score, i.e., it has the same effect on scoring as assigning High." ;
    mknd:value "X" .

mknd:CVSS-ExploitCodeMaturity-ProofOfConcept a owl:NamedIndividual,
        mknd:CVSS-ExploitCodeMaturity ;
    rdfs:label "Proof-of-Concept" ;
    skos:altLabel "E:P" ;
    skos:definition "Proof-of-concept exploit code is available, or an attack demonstration is not practical for most systems. The code or technique is not functional in all situations and may require substantial modification by a skilled attacker." ;
    mknd:value "P" .

mknd:CVSS-ExploitCodeMaturity-Unproven a owl:NamedIndividual,
        mknd:CVSS-ExploitCodeMaturity ;
    rdfs:label "Unproven (U)" ;
    skos:altLabel "E:U" ;
    skos:definition "No exploit code is available, or an exploit is theoretical." ;
    mknd:value "U" .

mknd:CVSS-IntegrityImpact-High a owl:NamedIndividual,
        mknd:CVSS-IntegrityImpact ;
    rdfs:label "High" ;
    skos:altLabel "I:H" ;
    skos:definition "There is a total loss of integrity, or a complete loss of protection. For example, the attacker is able to modify any/all files protected by the impacted component. Alternatively, only some files can be modified, but malicious modification would present a direct, serious consequence to the impacted component." ;
    mknd:value "HIGH" .

mknd:CVSS-IntegrityImpact-Low a owl:NamedIndividual,
        mknd:CVSS-IntegrityImpact ;
    rdfs:label "Low" ;
    skos:altLabel "I:L" ;
    skos:definition "Modification of data is possible, but the attacker does not have control over the consequence of a modification, or the amount of modification is limited. The data modification does not have a direct, serious impact on the impacted component." ;
    mknd:value "LOW" .

mknd:CVSS-IntegrityImpact-None a owl:NamedIndividual,
        mknd:CVSS-IntegrityImpact ;
    rdfs:label "None" ;
    skos:altLabel "I:N" ;
    skos:definition "There is no loss of integrity within the impacted component." ;
    mknd:value "NONE" .

mknd:CVSS-PrivilegesRequired-High a owl:NamedIndividual,
        mknd:CVSS-PrivilegesRequired ;
    rdfs:label "High" ;
    skos:altLabel "PR:H" ;
    skos:definition "The attacker requires privileges that provide significant (e.g., administrative) control over the vulnerable component allowing access to component-wide settings and files." ;
    mknd:value "HIGH" .

mknd:CVSS-PrivilegesRequired-Low a owl:NamedIndividual,
        mknd:CVSS-PrivilegesRequired ;
    rdfs:label "Low" ;
    skos:altLabel "PR:L" ;
    skos:definition "The attacker requires privileges that provide basic user capabilities that could normally affect only settings and files owned by a user. Alternatively, an attacker with Low privileges has the ability to access only non-sensitive resources." ;
    mknd:value "LOW" .

mknd:CVSS-PrivilegesRequired-None a owl:NamedIndividual,
        mknd:CVSS-PrivilegesRequired ;
    rdfs:label "None" ;
    skos:altLabel "PR:N" ;
    skos:definition "The attacker is unauthorized prior to attack, and therefore does not require any access to settings or files of the vulnerable system to carry out an attack." ;
    mknd:value "NONE" .

mknd:CVSS-RemediationLevel-NotDefined a owl:NamedIndividual,
        mknd:CVSS-RemediationLevel ;
    rdfs:label "Not Defined (X)" ;
    skos:altLabel "RL:X" ;
    skos:definition "Assigning this value indicates there is insufficient information to choose one of the other values, and has no impact on the overall Temporal Score, i.e., it has the same effect on scoring as assigning Unavailable." ;
    mknd:value "X" .

mknd:CVSS-RemediationLevel-OfficialFix a owl:NamedIndividual,
        mknd:CVSS-RemediationLevel ;
    rdfs:label "Official Fix (O)" ;
    skos:altLabel "RL:O" ;
    skos:definition "A complete vendor solution is available. Either the vendor has issued an official patch, or an upgrade is available." ;
    mknd:value "O" .

mknd:CVSS-RemediationLevel-TemporaryFix a owl:NamedIndividual,
        mknd:CVSS-RemediationLevel ;
    rdfs:label "Temporary Fix (T)" ;
    skos:altLabel "RL:T" ;
    skos:definition "There is an official but temporary fix available. This includes instances where the vendor issues a temporary hotfix, tool, or workaround." ;
    mknd:value "T" .

mknd:CVSS-RemediationLevel-Unavailable a owl:NamedIndividual,
        mknd:CVSS-RemediationLevel ;
    rdfs:label "Unavailable (U)" ;
    skos:altLabel "RL:U" ;
    skos:definition "There is either no solution available or it is impossible to apply." ;
    mknd:value "U" .

mknd:CVSS-RemediationLevel-Workaround a owl:NamedIndividual,
        mknd:CVSS-RemediationLevel ;
    rdfs:label "Workaround (W)" ;
    skos:altLabel "RL:W" ;
    skos:definition "There is an unofficial, non-vendor solution available. In some cases, users of the affected technology will create a patch of their own or provide steps to work around or otherwise mitigate the vulnerability." ;
    mknd:value "W" .

mknd:CVSS-ReportConfidence-Confirmed a owl:NamedIndividual,
        mknd:CVSS-ReportConfidence ;
    rdfs:label "Confirmed" ;
    skos:altLabel "RC:C" ;
    skos:definition "Detailed reports exist, or functional reproduction is possible (functional exploits may provide this). Source code is available to independently verify the assertions of the research, or the author or vendor of the affected code has confirmed the presence of the vulnerability." ;
    mknd:value "CONFIRMED" ;
    mknd:version 3.1 .

mknd:CVSS-ReportConfidence-NotDefined a owl:NamedIndividual,
        mknd:CVSS-ReportConfidence ;
    rdfs:label "Not Defined (X)" ;
    skos:altLabel "RC:X" ;
    skos:definition "Assigning this value indicates there is insufficient information to choose one of the other values, and has no impact on the overall Temporal Score, i.e., it has the same effect on scoring as assigning Confirmed." ;
    mknd:value "X" .

mknd:CVSS-ReportConfidence-Reasonable a owl:NamedIndividual,
        mknd:CVSS-ReportConfidence ;
    rdfs:label "Reasonable (R)" ;
    skos:altLabel "RC:R" ;
    skos:definition "Significant details are published, but researchers either do not have full confidence in the root cause, or do not have access to source code to fully confirm all of the interactions that may lead to the result. Reasonable confidence exists, however, that the bug is reproducible and at least one impact is able to be verified (proof-of-concept exploits may provide this). An example is a detailed write-up of research into a vulnerability with an explanation (possibly obfuscated or “left as an exercise to the reader”) that gives assurances on how to reproduce the results." ;
    mknd:value "R" .

mknd:CVSS-ReportConfidence-Unknown a owl:NamedIndividual,
        mknd:CVSS-ReportConfidence ;
    rdfs:label "Unknown (U)" ;
    skos:altLabel "RC:U" ;
    skos:definition "There are reports of impacts that indicate a vulnerability is present. The reports indicate that the cause of the vulnerability is unknown, or reports may differ on the cause or impacts of the vulnerability. Reporters are uncertain of the true nature of the vulnerability, and there is little confidence in the validity of the reports or whether a static Base Score can be applied given the differences described. An example is a bug report which notes that an intermittent but non-reproducible crash occurs, with evidence of memory corruption suggesting that denial of service, or possible more serious impacts, may result." ;
    mknd:value "U" .

mknd:CVSS-Scope-Unchanged a owl:NamedIndividual,
        mknd:CVSS-Scope ;
    rdfs:label "Unchanged" ;
    skos:altLabel "S:U" ;
    skos:definition "An exploited vulnerability can only affect resources managed by the same security authority. In this case, the vulnerable component and the impacted component are either the same, or both are managed by the same security authority." ;
    mknd:value "UNCHANGED" .

mknd:CVSS-SecurityRequirement-High a owl:NamedIndividual,
        mknd:CVSS-SecurityRequirement ;
    rdfs:label "High" ;
    skos:definition "Loss of [Confidentiality | Integrity | Availability] is likely to have a catastrophic adverse effect on the organization or individuals associated with the organization (e.g., employees, customers)." .

mknd:CVSS-SecurityRequirement-Low a owl:NamedIndividual,
        mknd:CVSS-SecurityRequirement ;
    rdfs:label "Low" ;
    skos:definition "Loss of [Confidentiality | Integrity | Availability] is likely to have only a limited adverse effect on the organization or individuals associated with the organization (e.g., employees, customers)." .

mknd:CVSS-SecurityRequirement-Medium a owl:NamedIndividual,
        mknd:CVSS-SecurityRequirement ;
    rdfs:label "Medium" ;
    skos:definition "Loss of [Confidentiality | Integrity | Availability] is likely to have a serious adverse effect on the organization or individuals associated with the organization (e.g., employees, customers)." .

mknd:CVSS-SecurityRequirement-NotDefined a owl:NamedIndividual,
        mknd:CVSS-SecurityRequirement ;
    rdfs:label "Not Defined (X)" ;
    skos:definition "Assigning this value indicates there is insufficient information to choose one of the other values, and has no impact on the overall Environmental Score, i.e., it has the same effect on scoring as assigning Medium." .

mknd:CVSS-SeverityType-High a owl:NamedIndividual,
        mknd:CVSS-SeverityType ;
    rdfs:label "High" ;
    mknd:value "HIGH" .

mknd:CVSS-SeverityType-Low a owl:NamedIndividual,
        mknd:CVSS-SeverityType ;
    rdfs:label "Low" ;
    mknd:value "LOW" .

mknd:CVSS-SeverityType-None a owl:NamedIndividual,
        mknd:CVSS-SeverityType ;
    rdfs:label "None" ;
    mknd:value "NONE" .

mknd:CVSS-UserInteraction-Required a owl:NamedIndividual,
        mknd:CVSS-UserInteraction ;
    rdfs:label "Required" ;
    skos:altLabel "UI:R" ;
    skos:definition "Successful exploitation of this vulnerability requires a user to take some action before the vulnerability can be exploited. For example, a successful exploit may only be possible during the installation of an application by a system administrator." ;
    mknd:value "REQUIRED" .

mknd:DataTemplate a owl:Class ;
    rdfs:label "Data Template" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:invoked-by ;
            owl:someValuesFrom mknd:TaskRun ],
        [ a owl:Restriction ;
            owl:onProperty d3f:maps ;
            owl:someValuesFrom d3f:WebAPIResource ],
        [ a owl:Restriction ;
            owl:onProperty d3f:used-by ;
            owl:someValuesFrom mknd:Task ],
        mknd:SystemObject ;
    mknd:icon "file.svg" .

mknd:EmailAddress a owl:Class ;
    rdfs:label "Email Address" ;
    rdfs:comment "An email address identifies an email box to which messages are delivered." ;
    rdfs:subClassOf mknd:Observable ;
    mknd:icon "email-address.svg" .

mknd:ICMP a owl:NamedIndividual,
        mknd:CommunicationProtocol ;
    rdfs:label "ICMP" .

mknd:Integration a owl:Class ;
    rdfs:label "Integration"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:contains ;
            owl:someValuesFrom mknd:Task ],
        [ a owl:Restriction ;
            owl:onProperty d3f:enabled-by ;
            owl:someValuesFrom mknd:Connection ],
        [ a owl:Restriction ;
            owl:onProperty d3f:enables ;
            owl:someValuesFrom d3f:DefensiveTactic ],
        [ a owl:Restriction ;
            owl:onProperty d3f:implements ;
            owl:someValuesFrom d3f:DefensiveTechnique ],
        mknd:SystemObject .

mknd:Report a owl:Class ;
    rdfs:label "Analysis Report"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:analyzes ;
            owl:someValuesFrom d3f:DomainName ],
        [ a owl:Restriction ;
            owl:onProperty d3f:analyzes ;
            owl:someValuesFrom d3f:FileHash ],
        [ a owl:Restriction ;
            owl:onProperty d3f:analyzes ;
            owl:someValuesFrom d3f:IPAddress ],
        [ a owl:Restriction ;
            owl:onProperty d3f:analyzes ;
            owl:someValuesFrom d3f:URL ],
        [ a owl:Restriction ;
            owl:onProperty d3f:analyzes ;
            owl:someValuesFrom mknd:EmailAddress ],
        [ a owl:Restriction ;
            owl:onProperty d3f:analyzes ;
            owl:someValuesFrom mknd:Hash ],
        [ a owl:Restriction ;
            owl:onProperty d3f:analyzes ;
            owl:someValuesFrom mknd:Socket ],
        [ a owl:Restriction ;
            owl:allValuesFrom mknd:Verdict ;
            owl:onProperty d3f:produces ],
        d3f:Document,
        d3f:Record,
        mknd:MekaThing ;
    skos:definition "A document containing the results of an assessment or analysis of an artifact." ;
    mknd:icon "doc.svg"^^xsd:anyURI .

mknd:Socket a owl:Class ;
    rdfs:label "Network Socket"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:uses ;
            owl:someValuesFrom d3f:IPAddress ],
        [ a owl:Restriction ;
            owl:allValuesFrom mknd:CommunicationProtocol ;
            owl:onProperty d3f:uses ],
        [ a owl:Restriction ;
            owl:onProperty mknd:usesNetworkPort ;
            owl:someValuesFrom xsd:positiveInteger ],
        d3f:Identifier,
        mknd:Observable ;
    skos:example "51.89.163.40:443" ;
    mknd:icon "network.svg" .

mknd:TCP a owl:NamedIndividual,
        mknd:CommunicationProtocol ;
    rdfs:label "TCP" .

mknd:TaskRunLog a owl:Class ;
    rdfs:label "Task Run Log" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:created-by ;
            owl:someValuesFrom mknd:TaskRun ],
        d3f:EventLog,
        mknd:SystemObject ;
    mknd:icon "log.svg"^^xsd:anyURI .

mknd:UDP a owl:NamedIndividual,
        mknd:CommunicationProtocol ;
    rdfs:label "UDP" ;
    rdfs:isDefinedBy "https://en.wikipedia.org/wiki/User_Datagram_Protocol" ;
    skos:altLabel "User Datagram Protocol"@en .

mknd:Verdict a owl:Class ;
    rdfs:label "Verdict"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:evaluates ;
            owl:someValuesFrom d3f:DomainName ],
        [ a owl:Restriction ;
            owl:onProperty d3f:evaluates ;
            owl:someValuesFrom d3f:FileHash ],
        [ a owl:Restriction ;
            owl:onProperty d3f:evaluates ;
            owl:someValuesFrom d3f:IPAddress ],
        [ a owl:Restriction ;
            owl:onProperty d3f:evaluates ;
            owl:someValuesFrom d3f:URL ],
        [ a owl:Restriction ;
            owl:onProperty d3f:evaluates ;
            owl:someValuesFrom mknd:EmailAddress ],
        [ a owl:Restriction ;
            owl:onProperty d3f:evaluates ;
            owl:someValuesFrom mknd:Hash ],
        [ a owl:Restriction ;
            owl:onProperty d3f:evaluates ;
            owl:someValuesFrom mknd:Socket ],
        [ a owl:Restriction ;
            owl:onProperty d3f:produced-by ;
            owl:someValuesFrom d3f:Assessment ],
        [ a owl:Restriction ;
            owl:onClass mknd:Report ;
            owl:onProperty d3f:recorded-in ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        d3f:Proposition,
        mknd:MekaThing ;
    skos:definition "A summary of an assessment for an observable or an IoC." .

mknd:mayIndicate a owl:ObjectProperty ;
    rdfs:label "may indicate"@en .

mknd:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    skos:example "Integration x supports product or service y." .

mknd:updated a owl:DatatypeProperty ;
    rdfs:label "modified at",
        "updated at" ;
    rdfs:subPropertyOf mknd:dateTime ;
    skos:altLabel "modified at" .

mknd:userId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "user ID"@en ;
    rdfs:subPropertyOf d3f:identifier .

mknd:ActionableItem a owl:Class ;
    rdfs:label "Actionable Item"@en ;
    rdfs:comment "A foundational element for analyst workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:created-by ;
            owl:someValuesFrom d3f:ApplicationRule ],
        d3f:Record,
        mknd:MekaThing .

mknd:CVSS-AttackComplexity-Low a owl:NamedIndividual,
        mknd:CVSS-AttackComplexity ;
    rdfs:label "Low" ;
    skos:altLabel "AC:L" ;
    skos:definition "Specialized access conditions or extenuating circumstances do not exist. An attacker can expect repeatable success when attacking the vulnerable component." ;
    mknd:value "LOW" ;
    mknd:version 3.1 .

mknd:CVSS-AvailabilityImpact-High a owl:NamedIndividual,
        mknd:CVSS-AvailabilityImpact ;
    rdfs:label "High" ;
    skos:altLabel "A:H" ;
    skos:definition "There is a total loss of availability, resulting in the attacker being able to fully deny access to resources in the impacted component; this loss is either sustained (while the attacker continues to deliver the attack) or persistent (the condition persists even after the attack has completed). Alternatively, the attacker has the ability to deny some availability, but the loss of availability presents a direct, serious consequence to the impacted component (e.g., the attacker cannot disrupt existing connections, but can prevent new connections; the attacker can repeatedly exploit a vulnerability that, in each instance of a successful attack, leaks a only small amount of memory, but after repeated exploitation causes a service to become completely unavailable)." ;
    mknd:value "HIGH" ;
    mknd:version 3.1 .

mknd:CVSS-Scope a owl:Class ;
    rdfs:label "Scope" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-Scope-Changed mknd:CVSS-Scope-Unchanged ) ] ;
    skos:altLabel "S" ;
    skos:definition """The Scope metric captures whether a vulnerability in one vulnerable component impacts resources in components beyond its security scope.

Formally, a security authority is a mechanism (e.g., an application, an operating system, firmware, a sandbox environment) that defines and enforces access control in terms of how certain subjects/actors (e.g., human users, processes) can access certain restricted objects/resources (e.g., files, CPU, memory) in a controlled manner. All the subjects and objects under the jurisdiction of a single security authority are considered to be under one security scope. If a vulnerability in a vulnerable component can affect a component which is in a different security scope than the vulnerable component, a Scope change occurs. Intuitively, whenever the impact of a vulnerability breaches a security/trust boundary and impacts components outside the security scope in which vulnerable component resides, a Scope change occurs.

The security scope of a component encompasses other components that provide functionality solely to that component, even if these other components have their own security authority. For example, a database used solely by one application is considered part of that application’s security scope even if the database has its own security authority, e.g., a mechanism controlling access to database records based on database users and associated database privileges.

The Base Score is greatest when a scope change occurs.""" .

mknd:CVSS-SeverityType-Critical a owl:NamedIndividual,
        mknd:CVSS-SeverityType ;
    rdfs:label "Critical" ;
    mknd:value "CRITICAL" .

mknd:CVSS-SeverityType-Medium a owl:NamedIndividual,
        mknd:CVSS-SeverityType ;
    rdfs:label "Medium" ;
    mknd:value "MEDIUM" .

mknd:CVSS-UserInteraction a owl:Class ;
    rdfs:label "User Interaction" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-UserInteraction-None mknd:CVSS-UserInteraction-Required ) ] ;
    skos:altLabel "UI" ;
    skos:definition "This metric captures the requirement for a human user, other than the attacker, to participate in the successful compromise of the vulnerable component. This metric determines whether the vulnerability can be exploited solely at the will of the attacker, or whether a separate user (or user-initiated process) must participate in some manner. The Base Score is greatest when no user interaction is required." .

mknd:TaskTemplate a owl:Class ;
    rdfs:label "Task Template" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mknd:templateId ],
        mknd:SystemObject ;
    mknd:icon "file.svg"^^xsd:anyURI .

mknd:dateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has timestamp"@en ;
    rdfs:domain mknd:MekaThing ;
    rdfs:range xsd:dateTimeStamp ;
    skos:definition "A date and time associated with the entity"@en ;
    skos:example "2002-10-10T12:00:00-05:00" .

mknd:timeSeen a owl:DatatypeProperty ;
    rdfs:label "seen at"@en ;
    rdfs:comment "A timestamp associated with a point in time when the entity had been observed by the application in some way."@en ;
    rdfs:subPropertyOf mknd:dateTime .

mknd:value a owl:DatatypeProperty ;
    rdfs:label "has value"@en ;
    rdfs:comment "A value parameter to be passed to Tasks"@en ;
    rdfs:subPropertyOf owl:topDataProperty .

mknd:AppUser a owl:Class ;
    rdfs:label "Mekanoid User Account" ;
    rdfs:comment "Mekanoid User Account" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:accessed-by ;
            owl:someValuesFrom d3f:User ],
        [ a owl:Restriction ;
            owl:onProperty d3f:creates ;
            owl:someValuesFrom mknd:Filter ],
        [ a owl:Restriction ;
            owl:onProperty d3f:creates ;
            owl:someValuesFrom mknd:TaskPattern ],
        [ a owl:Restriction ;
            owl:onProperty d3f:executes ;
            owl:someValuesFrom mknd:ManualTaskRun ],
        [ a owl:Restriction ;
            owl:onProperty d3f:may-access ;
            owl:someValuesFrom mknd:Tenant ],
        [ a owl:Restriction ;
            owl:onProperty mknd:userId ;
            owl:someValuesFrom xsd:string ],
        mknd:ApplicationUserAccount,
        mknd:SystemObject .

mknd:CVSS-AttackComplexity a owl:Class ;
    rdfs:label "Attack Complexity" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-AttackComplexity-High mknd:CVSS-AttackComplexity-Low ) ] ;
    skos:altLabel "AC" ;
    skos:definition "This metric describes the conditions beyond the attacker’s control that must exist in order to exploit the vulnerability. As described below, such conditions may require the collection of more information about the target, or computational exceptions. Importantly, the assessment of this metric excludes any requirements for user interaction in order to exploit the vulnerability (such conditions are captured in the User Interaction metric). If a specific configuration is required for an attack to succeed, the Base metrics should be scored assuming the vulnerable component is in that configuration. The Base Score is greatest for the least complex attacks." .

mknd:CVSS-ConfidentialityImpact a owl:Class ;
    rdfs:label "Confidentiality Impact" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-ConfidentialityImpact-High mknd:CVSS-ConfidentialityImpact-Low mknd:CVSS-ConfidentialityImpact-None ) ] ;
    skos:altLabel "C" ;
    skos:definition "This metric measures the impact to the confidentiality of the information resources managed by a software component due to a successfully exploited vulnerability. Confidentiality refers to limiting information access and disclosure to only authorized users, as well as preventing access by, or disclosure to, unauthorized ones. The Base Score is greatest when the loss to the impacted component is highest." .

mknd:CVSS-IntegrityImpact a owl:Class ;
    rdfs:label "Integrity Impact" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-IntegrityImpact-High mknd:CVSS-IntegrityImpact-Low mknd:CVSS-IntegrityImpact-None ) ] ;
    skos:altLabel "I" ;
    skos:definition "This metric measures the impact to integrity of a successfully exploited vulnerability. Integrity refers to the trustworthiness and veracity of information. The Base Score is greatest when the consequence to the impacted component is highest." .

mknd:CVSS-PrivilegesRequired a owl:Class ;
    rdfs:label "Privileges Required" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-PrivilegesRequired-High mknd:CVSS-PrivilegesRequired-Low mknd:CVSS-PrivilegesRequired-None ) ] ;
    skos:altLabel "PR" ;
    skos:definition "This metric describes the level of privileges an attacker must possess before successfully exploiting the vulnerability. The Base Score is greatest if no privileges are required." .

mknd:CommunicationProtocol a owl:Class ;
    rdfs:label "Communication Protocol"@en ;
    rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Communication_protocol" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:used-by ;
            owl:someValuesFrom d3f:NetworkPackets ],
        [ a owl:Restriction ;
            owl:onProperty d3f:used-by ;
            owl:someValuesFrom d3f:NetworkService ],
        [ a owl:Restriction ;
            owl:onProperty d3f:used-by ;
            owl:someValuesFrom d3f:NetworkSession ],
        mknd:MekaThing ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:ICMP mknd:TCP mknd:UDP ) ] .

mknd:IncidentStatus a owl:Class ;
    rdfs:label "Incident Status" ;
    rdfs:subClassOf mknd:MekaThing ;
    skos:definition "Normalized status of an Incident" .

mknd:Task a owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:comment "An abstract concept. Something to be done." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:accesses ;
            owl:someValuesFrom d3f:NetworkResource ],
        [ a owl:Restriction ;
            owl:onProperty d3f:uses ;
            owl:someValuesFrom mknd:DataTemplate ],
        [ a owl:Restriction ;
            owl:allValuesFrom mknd:Integration ;
            owl:onProperty d3f:contained-by ],
        [ a owl:Restriction ;
            owl:allValuesFrom mknd:TaskTemplate ;
            owl:onProperty d3f:uses ],
        mknd:SystemObject ;
    skos:altLabel "Atomic Task" ;
    mknd:icon "task.svg"^^xsd:anyURI .

mknd:TaskPattern a owl:Class ;
    rdfs:label "Task Pattern" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:created-by ;
            owl:someValuesFrom mknd:AppUser ],
        [ a owl:Restriction ;
            owl:onProperty d3f:invokes ;
            owl:someValuesFrom mknd:AutomatedTaskRun ],
        mknd:SystemObject ;
    mknd:icon "flow.svg"^^xsd:anyURI .

mknd:mayBeIndicatedBy a owl:ObjectProperty ;
    rdfs:label "may be indicated by"@en ;
    owl:inverseOf mknd:mayIndicate .

mknd:severityRating a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "severity" ;
    rdfs:range mknd:CVSS-SeverityType ;
    rdfs:subPropertyOf mknd:hasCVSSMetric .

mknd:CVSS-AvailabilityImpact a owl:Class ;
    rdfs:label "Availability Impact" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-AvailabilityImpact-High mknd:CVSS-AvailabilityImpact-Low mknd:CVSS-AvailabilityImpact-None ) ] ;
    skos:altLabel "A" ;
    skos:definition "This metric measures the impact to the availability of the impacted component resulting from a successfully exploited vulnerability. While the Confidentiality and Integrity impact metrics apply to the loss of confidentiality or integrity of data (e.g., information, files) used by the impacted component, this metric refers to the loss of availability of the impacted component itself, such as a networked service (e.g., web, database, email). Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component. The Base Score is greatest when the consequence to the impacted component is highest." .

mknd:CVSS-SecurityRequirement a owl:Class ;
    rdfs:label "Security Requirement" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-SecurityRequirement-High mknd:CVSS-SecurityRequirement-Low mknd:CVSS-SecurityRequirement-Medium mknd:CVSS-SecurityRequirement-NotDefined ) ] ;
    skos:definition """These metrics enable the analyst to customize the CVSS score depending on the importance of the affected IT asset to a user’s organization, measured in terms of Confidentiality, Integrity, and Availability. That is, if an IT asset supports a business function for which Availability is most important, the analyst can assign a greater value to Availability relative to Confidentiality and Integrity. Each Security Requirement has three possible values: Low, Medium, or High.

The full effect on the environmental score is determined by the corresponding Modified Base Impact metrics. That is, these metrics modify the environmental score by reweighting the Modified Confidentiality, Integrity, and Availability impact metrics. For example, the Modified Confidentiality impact (MC) metric has increased weight if the Confidentiality Requirement (CR) is High. Likewise, the Modified Confidentiality impact metric has decreased weight if the Confidentiality Requirement is Low. The Modified Confidentiality impact metric weighting is neutral if the Confidentiality Requirement is Medium. This same process is applied to the Integrity and Availability requirements.

Note that the Confidentiality Requirement will not affect the Environmental score if the (Modified Base) confidentiality impact is set to None. Also, increasing the Confidentiality Requirement from Medium to High will not change the Environmental score when the (Modified Base) impact metrics are set to High. This is because the Modified Impact Sub-Score (part of the Modified Base Score that calculates impact) is already at a maximum value of 10.""" .

mknd:DetectionRule a owl:Class ;
    rdfs:label "Detection Rule"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:creates ;
            owl:someValuesFrom mknd:Detection ],
        d3f:ApplicationRule ;
    mknd:icon "rule.svg" .

mknd:NetworkServiceProtocol a owl:Class ;
    rdfs:label "Network Service" ;
    rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Application_layer#Protocols" ;
    rdfs:subClassOf mknd:MekaThing .

mknd:TaskRun a owl:Class ;
    rdfs:label "Task Run" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:creates ;
            owl:someValuesFrom mknd:TaskRunLog ],
        [ a owl:Restriction ;
            owl:onProperty d3f:executes ;
            owl:someValuesFrom d3f:DefensiveTechnique ],
        [ a owl:Restriction ;
            owl:onProperty d3f:uses ;
            owl:someValuesFrom mknd:DataTemplate ],
        [ a owl:Restriction ;
            owl:onProperty d3f:uses ;
            owl:someValuesFrom mknd:TaskTemplate ],
        d3f:DigitalEvent,
        mknd:SystemObject ;
    mknd:icon "task.svg"^^xsd:anyURI .

mknd:extClassification a owl:DatatypeProperty ;
    rdfs:label "classification"@en ;
    rdfs:comment "An external classification that may apply to the artifact. Typically provided by a 3rd party vendor."@en ;
    rdfs:subPropertyOf mknd:vendorProperty .

mknd:vendorProperty a owl:DatatypeProperty ;
    rdfs:label "vendor property" .

mknd:CVSS-AttackVector a owl:Class ;
    rdfs:label "Attack Vector" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-AttackVector-Adjacent mknd:CVSS-AttackVector-Local mknd:CVSS-AttackVector-Network mknd:CVSS-AttackVector-Physical ) ] ;
    skos:altLabel "AV" ;
    skos:definition "This metric reflects the context by which vulnerability exploitation is possible. This metric value (and consequently the Base Score) will be larger the more remote (logically, and physically) an attacker can be in order to exploit the vulnerable component. The assumption is that the number of potential attackers for a vulnerability that could be exploited from across a network is larger than the number of potential attackers that could exploit a vulnerability requiring physical access to a device, and therefore warrants a greater Base Score." .

mknd:CVSS-ReportConfidence a owl:Class ;
    rdfs:label "Report Confidence" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-ReportConfidence-Confirmed mknd:CVSS-ReportConfidence-NotDefined mknd:CVSS-ReportConfidence-Reasonable mknd:CVSS-ReportConfidence-Unknown ) ] ;
    skos:altLabel "RC" ;
    skos:definition "This metric measures the degree of confidence in the existence of the vulnerability and the credibility of the known technical details. Sometimes only the existence of vulnerabilities is publicized, but without specific details. For example, an impact may be recognized as undesirable, but the root cause may not be known. The vulnerability may later be corroborated by research which suggests where the vulnerability may lie, though the research may not be certain. Finally, a vulnerability may be confirmed through acknowledgment by the author or vendor of the affected technology. The urgency of a vulnerability is higher when a vulnerability is known to exist with certainty. This metric also suggests the level of technical knowledge available to would-be attackers. The more a vulnerability is validated by the vendor or other reputable sources, the higher the score." .

mknd:dateTimeEpoch a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has epoch"@en ;
    rdfs:comment "A Unix epoch timestamp associated with the entity"@en ;
    rdfs:range xsd:long ;
    skos:definition "A Unix epoch timestamp associated with the entity"@en ;
    skos:example "990577200"^^xsd:long .

mknd:CVSS-ExploitCodeMaturity a owl:Class ;
    rdfs:label "Exploit Code Maturity" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-ExploitCodeMaturity-Functional mknd:CVSS-ExploitCodeMaturity-High mknd:CVSS-ExploitCodeMaturity-NotDefined mknd:CVSS-ExploitCodeMaturity-ProofOfConcept mknd:CVSS-ExploitCodeMaturity-Unproven ) ] ;
    skos:altLabel "E" ;
    skos:definition "This metric measures the likelihood of the vulnerability being attacked, and is typically based on the current state of exploit techniques, exploit code availability, or active, “in-the-wild” exploitation. Public availability of easy-to-use exploit code increases the number of potential attackers by including those who are unskilled, thereby increasing the severity of the vulnerability. Initially, real-world exploitation may only be theoretical. Publication of proof-of-concept code, functional exploit code, or sufficient technical details necessary to exploit the vulnerability may follow. Furthermore, the exploit code available may progress from a proof-of-concept demonstration to exploit code that is successful in exploiting the vulnerability consistently. In severe cases, it may be delivered as the payload of a network-based worm or virus or other automated attack tools." .

mknd:CVSS-RemediationLevel a owl:Class ;
    rdfs:label "Remediation Level" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-RemediationLevel-NotDefined mknd:CVSS-RemediationLevel-OfficialFix mknd:CVSS-RemediationLevel-TemporaryFix mknd:CVSS-RemediationLevel-Unavailable mknd:CVSS-RemediationLevel-Workaround ) ] ;
    skos:altLabel "RL" ;
    skos:definition "The Remediation Level of a vulnerability is an important factor for prioritization. The typical vulnerability is unpatched when initially published. Workarounds or hotfixes may offer interim remediation until an official patch or upgrade is issued. Each of these respective stages adjusts the Temporal Score downwards, reflecting the decreasing urgency as remediation becomes final. The list of possible values is presented in Table 10. The less official and permanent a fix, the higher the vulnerability score." .

mknd:CVSS-SeverityType a owl:Class ;
    rdfs:label "Severity Type" ;
    rdfs:comment "Qualitative Severity Rating" ;
    rdfs:subClassOf mknd:CVSS ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( mknd:CVSS-SeverityType-Critical mknd:CVSS-SeverityType-High mknd:CVSS-SeverityType-Low mknd:CVSS-SeverityType-Medium mknd:CVSS-SeverityType-None ) ] ;
    skos:definition "Specifies the CVSS base, temporal, threat, or environmental severity type." .

mknd:Hash a owl:Class ;
    rdfs:label "Hash"@en ;
    rdfs:comment "A hash is a grouping of characteristics unique to the result of applying a mathematical algorithm that maps data of arbitrary size to a bit string (the 'hash') and is a one-way function, that is, a function which is practically infeasible to invert. This is commonly used for integrity checking of data. [based on https://en.wikipedia.org/wiki/Cryptographic_hash_function]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:associated-with ;
            owl:someValuesFrom mknd:Verdict ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:hexBinary ;
            owl:onProperty mknd:value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        d3f:Identifier,
        mknd:MekaThing ;
    mknd:icon "hash.svg" .

mknd:Observable a owl:Class ;
    rdfs:label "Observable"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty d3f:associated-with ;
            owl:someValuesFrom mknd:Incident ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty mknd:value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        mknd:MekaThing ;
    skos:definition "A notable string value useful which may offer helpful hints to during cybersecurity investigations." ;
    mknd:icon "pin.svg" .

mknd:cvssBaseScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "base score" ;
    rdfs:domain d3f:Vulnerability ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

mknd:SystemObject a owl:Class ;
    rdfs:label "Mekanoid Object" ;
    rdfs:subClassOf mknd:MekaThing ;
    skos:definition "A foundational class in the Mekanoid ontology representing the core system objects. It serves as a superclass for various entities including integrations, app users, task patterns, templates, connections, task runs, tenants, task run logs, data templates, and tasks. This class is integral to organizing and defining the structure and relationships of system objects within the Mekanoid framework."@en ;
    mknd:icon "mekanoid.svg"^^xsd:anyURI .

mknd:hasCVSSMetric a owl:ObjectProperty ;
    rdfs:label "has CVSS metric" ;
    rdfs:domain d3f:Vulnerability .

mknd:CVSS a owl:Class ;
    rdfs:label "CVSS Metric" ;
    rdfs:isDefinedBy "https://www.first.org/cvss/v3.1/specification-document"^^xsd:anyURI .

mknd:MekaThing a owl:Class ;
    rdfs:label "Mekanoid Thing"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mknd:timeSeen ;
            owl:someValuesFrom xsd:dateTimeStamp ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTimeStamp ;
            owl:onProperty mknd:firstSeen ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:long ;
            owl:onProperty mknd:firstSeenEpoch ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTimeStamp ;
            owl:onProperty mknd:lastSeen ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTimeStamp ;
            owl:onProperty mknd:timeCreated ] ;
    skos:altLabel "Mekanoid Ontology Item" ;
    mknd:icon "mekanoid.svg"^^xsd:anyURI .

[] owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger .

[] a owl:AllDisjointClasses ;
    owl:members ( mknd:CVSS-AttackComplexity mknd:CVSS-AttackVector mknd:CVSS-AvailabilityImpact mknd:CVSS-ConfidentialityImpact mknd:CVSS-ExploitCodeMaturity mknd:CVSS-IntegrityImpact mknd:CVSS-PrivilegesRequired mknd:CVSS-RemediationLevel mknd:CVSS-ReportConfidence mknd:CVSS-Scope mknd:CVSS-SecurityRequirement mknd:CVSS-SeverityType mknd:CVSS-UserInteraction ) .

[] a owl:AllDisjointClasses ;
    owl:members ( mknd:Task mknd:TaskPattern mknd:TaskRun mknd:TaskRunLog mknd:TaskTemplate ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-AttackVector-Adjacent mknd:CVSS-AttackVector-Local mknd:CVSS-AttackVector-Network mknd:CVSS-AttackVector-Physical ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-AvailabilityImpact-High mknd:CVSS-AvailabilityImpact-Low mknd:CVSS-AvailabilityImpact-None ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-ConfidentialityImpact-High mknd:CVSS-ConfidentialityImpact-Low mknd:CVSS-ConfidentialityImpact-None ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-ExploitCodeMaturity-Functional mknd:CVSS-ExploitCodeMaturity-High mknd:CVSS-ExploitCodeMaturity-NotDefined mknd:CVSS-ExploitCodeMaturity-ProofOfConcept mknd:CVSS-ExploitCodeMaturity-Unproven ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-IntegrityImpact-High mknd:CVSS-IntegrityImpact-Low mknd:CVSS-IntegrityImpact-None ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-PrivilegesRequired-High mknd:CVSS-PrivilegesRequired-Low mknd:CVSS-PrivilegesRequired-None ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-RemediationLevel-NotDefined mknd:CVSS-RemediationLevel-OfficialFix mknd:CVSS-RemediationLevel-TemporaryFix mknd:CVSS-RemediationLevel-Unavailable mknd:CVSS-RemediationLevel-Workaround ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-ReportConfidence-Confirmed mknd:CVSS-ReportConfidence-NotDefined mknd:CVSS-ReportConfidence-Reasonable mknd:CVSS-ReportConfidence-Unknown ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-SecurityRequirement-High mknd:CVSS-SecurityRequirement-Low mknd:CVSS-SecurityRequirement-Medium mknd:CVSS-SecurityRequirement-NotDefined ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:CVSS-SeverityType-Critical mknd:CVSS-SeverityType-High mknd:CVSS-SeverityType-Low mknd:CVSS-SeverityType-Medium mknd:CVSS-SeverityType-None ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:ICMP mknd:TCP mknd:UDP ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( mknd:IncidentStatus-Closed mknd:IncidentStatus-Open mknd:IncidentStatus-Unknown ) .

[] a owl:AllDisjointProperties ;
    owl:members ( mknd:cvssBaseScore mknd:cvssExploitabilityScore mknd:cvssImpactScore ) .

