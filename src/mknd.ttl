###  https://w3id.org/mknd/Integration
mknd:Integration rdf:type owl:Class ;
                 rdfs:subClassOf mknd:SystemObject ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty d3f:contains ;
                                   owl:someValuesFrom mknd:Task
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty d3f:enabled-by ;
                                   owl:someValuesFrom mknd:Connection
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty d3f:enables ;
                                   owl:someValuesFrom d3f:DefensiveTactic
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty d3f:implements ;
                                   owl:someValuesFrom d3f:DefensiveTechnique
                                 ] ;
                 rdfs:label "Integration"@en .


###  https://w3id.org/mknd/LowSeverityVulnerability
mknd:LowSeverityVulnerability rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( d3f:Vulnerability
                                                                         [ rdf:type owl:Class ;
                                                                           owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                  owl:onProperty mknd:cvssBaseScore ;
                                                                                                                  owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                       owl:onDatatype xsd:decimal ;
                                                                                                                                       owl:withRestrictions ( [ xsd:minExclusive 0.0
                                                                                                                                                              ]
                                                                                                                                                            )
                                                                                                                                     ]
                                                                                                                ]
                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                  owl:onProperty mknd:cvssBaseScore ;
                                                                                                                  owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                       owl:onDatatype xsd:decimal ;
                                                                                                                                       owl:withRestrictions ( [ xsd:maxExclusive 4.0
                                                                                                                                                              ]
                                                                                                                                                            )
                                                                                                                                     ]
                                                                                                                ]
                                                                                                              ) ;
                                                                                           rdf:type owl:Class
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty mknd:severityRating ;
                                                                                           owl:hasValue mknd:CVSS-AttackComplexity-Low
                                                                                         ]
                                                                                       )
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf d3f:Vulnerability ;
                              rdfs:label "Low Severity Vulnerability" .


