###  https://w3id.org/mknd/Filter
mknd:Filter rdf:type owl:Class ;
            rdfs:subClassOf mknd:SystemObject ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty d3f:used-by ;
                              owl:someValuesFrom mknd:TaskPattern
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty d3f:created-by ;
                              owl:allValuesFrom mknd:AppUser
                            ] ;
            rdfs:label "Filter"@en ;
            skos:definition "A logical statement specifying scope for a Report or a Task Pattern. Identifies one or more Artifacts with or without specific relationships between them, essentially a subgraph. e.g. a FILTER statement within a SPARQL query." .


###  https://w3id.org/mknd/Hash
mknd:Hash rdf:type owl:Class ;
          rdfs:subClassOf d3f:Identifier ,
                          mknd:MekaThing ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty d3f:associated-with ;
                            owl:someValuesFrom mknd:Verdict
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mknd:value ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:hexBinary
                          ] ;
          rdfs:comment "A hash is a grouping of characteristics unique to the result of applying a mathematical algorithm that maps data of arbitrary size to a bit string (the 'hash') and is a one-way function, that is, a function which is practically infeasible to invert. This is commonly used for integrity checking of data. [based on https://en.wikipedia.org/wiki/Cryptographic_hash_function]"@en ;
          rdfs:label "Hash"@en ;
          mknd:icon "hash.svg" .


###  https://w3id.org/mknd/HighVulnerability
mknd:HighVulnerability rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( d3f:Vulnerability
                                                                  [ rdf:type owl:Class ;
                                                                    owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty mknd:cvssBaseScore ;
                                                                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                owl:onDatatype xsd:decimal ;
                                                                                                                                owl:withRestrictions ( [ xsd:minInclusive 7.0
                                                                                                                                                       ]
                                                                                                                                                     )
                                                                                                                              ]
                                                                                                         ]
                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty mknd:cvssBaseScore ;
                                                                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                owl:onDatatype xsd:decimal ;
                                                                                                                                owl:withRestrictions ( [ xsd:maxExclusive 9.0
                                                                                                                                                       ]
                                                                                                                                                     )
                                                                                                                              ]
                                                                                                         ]
                                                                                                       ) ;
                                                                                    rdf:type owl:Class
                                                                                  ]
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty mknd:severityRating ;
                                                                                    owl:hasValue mknd:CVSS-AvailabilityImpact-High
                                                                                  ]
                                                                                )
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf d3f:Vulnerability ;
                       rdfs:label "High Severity Vulnerability" .


