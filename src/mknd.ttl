          mknd:icon "rule-yara.svg" .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/mknd/CVSS-AttackComplexity-High
mknd:CVSS-AttackComplexity-High rdf:type owl:NamedIndividual ,
                                         mknd:CVSS-AttackComplexity ;
                                owl:differentFrom mknd:CVSS-AttackComplexity-Low ;
                                mknd:value "HIGH" ;
                                mknd:version 3.1 ;
                                rdfs:label "High" ;
                                skos:altLabel "AC:H" ;
                                skos:definition """A successful attack depends on conditions beyond the attacker's control. That is, a successful attack cannot be accomplished at will, but requires the attacker to invest in some measurable amount of effort in preparation or execution against the vulnerable component before a successful attack can be expected. For example, a successful attack may depend on an attacker overcoming any of the following conditions:
- The attacker must gather knowledge about the environment in which the vulnerable target/component exists. For example, a requirement to collect details on target configuration settings, sequence numbers, or shared secrets.
- The attacker must prepare the target environment to improve exploit reliability. For example, repeated exploitation to win a race condition, or overcoming advanced exploit mitigation techniques.
- The attacker must inject themselves into the logical network path between the target and the resource requested by the victim in order to read and/or modify network communications (e.g., a man in the middle attack).""" .


###  https://w3id.org/mknd/CVSS-AttackComplexity-Low
mknd:CVSS-AttackComplexity-Low rdf:type owl:NamedIndividual ,
                                        mknd:CVSS-AttackComplexity ;
                               mknd:value "LOW" ;
                               mknd:version 3.1 ;
                               rdfs:label "Low" ;
                               skos:altLabel "AC:L" ;
                               skos:definition "Specialized access conditions or extenuating circumstances do not exist. An attacker can expect repeatable success when attacking the vulnerable component." .


###  https://w3id.org/mknd/CVSS-AttackVector-Adjacent
mknd:CVSS-AttackVector-Adjacent rdf:type owl:NamedIndividual ,
                                         mknd:CVSS-AttackVector ;
                                mknd:value "ADJACENT" ;
                                mknd:version 3.1 ;
                                rdfs:label "Adjacent" ;
                                skos:altLabel "AV:A" ;
                                skos:definition "The vulnerable component is bound to the network stack, but the attack is limited at the protocol level to a logically adjacent topology. This can mean an attack must be launched from the same shared physical (e.g., Bluetooth or IEEE 802.11) or logical (e.g., local IP subnet) network, or from within a secure or otherwise limited administrative domain (e.g., MPLS, secure VPN to an administrative network zone). One example of an Adjacent attack would be an ARP (IPv4) or neighbor discovery (IPv6) flood leading to a denial of service on the local LAN segment (e.g., CVE‑2013‑6014)." .


###  https://w3id.org/mknd/CVSS-AttackVector-Local
mknd:CVSS-AttackVector-Local rdf:type owl:NamedIndividual ,
                                      mknd:CVSS-AttackVector ;
                             mknd:value "LOCAL" ;
                             mknd:version 3.1 ;
                             rdfs:label "Local" ;
                             skos:altLabel "AV:L" ;
                             skos:definition """The vulnerable component is not bound to the network stack and the attacker’s path is via read/write/execute capabilities. Either:
- the attacker exploits the vulnerability by accessing the target system locally (e.g., keyboard, console), or remotely (e.g., SSH); or
- the attacker relies on User Interaction by another person to perform actions required to exploit the vulnerability (e.g., using social engineering techniques to trick a legitimate user into opening a malicious document).""" .


###  https://w3id.org/mknd/CVSS-AttackVector-Network
mknd:CVSS-AttackVector-Network rdf:type owl:NamedIndividual ,
                                        mknd:CVSS-AttackVector ;
                               mknd:value "NETWORK" ;
                               mknd:version 3.1 ;
                               rdfs:label "Network" ;
                               skos:altLabel "AV:N" ;
                               skos:definition "The vulnerable component is bound to the network stack and the set of possible attackers extends beyond the other options listed below, up to and including the entire Internet. Such a vulnerability is often termed “remotely exploitable” and can be thought of as an attack being exploitable at the protocol level one or more network hops away (e.g., across one or more routers). An example of a network attack is an attacker causing a denial of service (DoS) by sending a specially crafted TCP packet across a wide area network (e.g., CVE‑2004‑0230)." .


###  https://w3id.org/mknd/CVSS-AttackVector-Physical
mknd:CVSS-AttackVector-Physical rdf:type owl:NamedIndividual ,
                                         mknd:CVSS-AttackVector ;
                                mknd:value "PHYSICAL" ;
                                mknd:version 3.1 ;
                                rdfs:label "Physical" ;
                                skos:altLabel "AV:P" ;
                                skos:definition "The attack requires the attacker to physically touch or manipulate the vulnerable component. Physical interaction may be brief (e.g., evil maid attack1) or persistent. An example of such an attack is a cold boot attack in which an attacker gains access to disk encryption keys after physically accessing the target system. Other examples include peripheral attacks via FireWire/USB Direct Memory Access (DMA)." .


###  https://w3id.org/mknd/CVSS-AvailabilityImpact-High
mknd:CVSS-AvailabilityImpact-High rdf:type owl:NamedIndividual ,
                                           mknd:CVSS-AvailabilityImpact ;
                                  mknd:value "HIGH" ;
                                  mknd:version 3.1 ;
                                  rdfs:label "High" ;
                                  skos:altLabel "A:H" ;
                                  skos:definition "There is a total loss of availability, resulting in the attacker being able to fully deny access to resources in the impacted component; this loss is either sustained (while the attacker continues to deliver the attack) or persistent (the condition persists even after the attack has completed). Alternatively, the attacker has the ability to deny some availability, but the loss of availability presents a direct, serious consequence to the impacted component (e.g., the attacker cannot disrupt existing connections, but can prevent new connections; the attacker can repeatedly exploit a vulnerability that, in each instance of a successful attack, leaks a only small amount of memory, but after repeated exploitation causes a service to become completely unavailable)." .


###  https://w3id.org/mknd/CVSS-AvailabilityImpact-Low
mknd:CVSS-AvailabilityImpact-Low rdf:type owl:NamedIndividual ,
                                          mknd:CVSS-AvailabilityImpact ;
                                 mknd:value "LOW" ;
                                 rdfs:label "Low" ;
                                 skos:altLabel "A:L" ;
                                 skos:definition "Performance is reduced or there are interruptions in resource availability. Even if repeated exploitation of the vulnerability is possible, the attacker does not have the ability to completely deny service to legitimate users. The resources in the impacted component are either partially available all of the time, or fully available only some of the time, but overall there is no direct, serious consequence to the impacted component." .


###  https://w3id.org/mknd/CVSS-AvailabilityImpact-None
mknd:CVSS-AvailabilityImpact-None rdf:type owl:NamedIndividual ,
                                           mknd:CVSS-AvailabilityImpact ;
                                  mknd:value "NONE" ;
                                  rdfs:label "None" ;
                                  skos:altLabel "A:N" ;
                                  skos:definition "There is no impact to availability within the impacted component." .


###  https://w3id.org/mknd/CVSS-ConfidentialityImpact-High
mknd:CVSS-ConfidentialityImpact-High rdf:type owl:NamedIndividual ,
                                              mknd:CVSS-ConfidentialityImpact ;
                                     mknd:value "HIGH" ;
                                     rdfs:label "High" ;
                                     skos:altLabel "C:H" ;
                                     skos:definition "There is a total loss of confidentiality, resulting in all resources within the impacted component being divulged to the attacker. Alternatively, access to only some restricted information is obtained, but the disclosed information presents a direct, serious impact. For example, an attacker steals the administrator's password, or private encryption keys of a web server." .


###  https://w3id.org/mknd/CVSS-ConfidentialityImpact-Low
mknd:CVSS-ConfidentialityImpact-Low rdf:type owl:NamedIndividual ,
                                             mknd:CVSS-ConfidentialityImpact ;
                                    mknd:value "LOW" ;
                                    rdfs:label "Low" ;
                                    skos:altLabel "C:L" ;
                                    skos:definition "There is some loss of confidentiality. Access to some restricted information is obtained, but the attacker does not have control over what information is obtained, or the amount or kind of loss is limited. The information disclosure does not cause a direct, serious loss to the impacted component." .


###  https://w3id.org/mknd/CVSS-ConfidentialityImpact-None
mknd:CVSS-ConfidentialityImpact-None rdf:type owl:NamedIndividual ,
                                              mknd:CVSS-ConfidentialityImpact ;
                                     mknd:value "NONE" ;
                                     rdfs:label "None" ;
                                     skos:altLabel "C:N" ;
                                     skos:definition "There is no loss of confidentiality within the impacted component." .


###  https://w3id.org/mknd/CVSS-ExploitCodeMaturity-Functional
mknd:CVSS-ExploitCodeMaturity-Functional rdf:type owl:NamedIndividual ,
                                                  mknd:CVSS-ExploitCodeMaturity ;
                                         mknd:value "FUNCTIONAL" ;
                                         rdfs:label "Functional" ;
                                         skos:altLabel "E:F" ;
                                         skos:definition "Functional exploit code is available. The code works in most situations where the vulnerability exists." .


###  https://w3id.org/mknd/CVSS-ExploitCodeMaturity-High
mknd:CVSS-ExploitCodeMaturity-High rdf:type owl:NamedIndividual ,
                                            mknd:CVSS-ExploitCodeMaturity ;
                                   mknd:value "HIGH" ;
                                   rdfs:label "High" ;
                                   skos:altLabel "E:H" ;
                                   skos:definition "Functional autonomous code exists, or no exploit is required (manual trigger) and details are widely available. Exploit code works in every situation, or is actively being delivered via an autonomous agent (such as a worm or virus). Network-connected systems are likely to encounter scanning or exploitation attempts. Exploit development has reached the level of reliable, widely available, easy-to-use automated tools." .


###  https://w3id.org/mknd/CVSS-ExploitCodeMaturity-NotDefined
mknd:CVSS-ExploitCodeMaturity-NotDefined rdf:type owl:NamedIndividual ,
                                                  mknd:CVSS-ExploitCodeMaturity ;
                                         mknd:value "X" ;
                                         rdfs:label "Not Defined (X)" ;
                                         skos:altLabel "E:X" ;
                                         skos:definition "Assigning this value indicates there is insufficient information to choose one of the other values, and has no impact on the overall Temporal Score, i.e., it has the same effect on scoring as assigning High." .


###  https://w3id.org/mknd/CVSS-ExploitCodeMaturity-ProofOfConcept
mknd:CVSS-ExploitCodeMaturity-ProofOfConcept rdf:type owl:NamedIndividual ,
                                                      mknd:CVSS-ExploitCodeMaturity ;
                                             mknd:value "P" ;
                                             rdfs:label "Proof-of-Concept" ;
                                             skos:altLabel "E:P" ;
                                             skos:definition "Proof-of-concept exploit code is available, or an attack demonstration is not practical for most systems. The code or technique is not functional in all situations and may require substantial modification by a skilled attacker." .


###  https://w3id.org/mknd/CVSS-ExploitCodeMaturity-Unproven
mknd:CVSS-ExploitCodeMaturity-Unproven rdf:type owl:NamedIndividual ,
                                                mknd:CVSS-ExploitCodeMaturity ;
                                       mknd:value "U" ;
                                       rdfs:label "Unproven (U)" ;
                                       skos:altLabel "E:U" ;
                                       skos:definition "No exploit code is available, or an exploit is theoretical." .


###  https://w3id.org/mknd/CVSS-IntegrityImpact-High
mknd:CVSS-IntegrityImpact-High rdf:type owl:NamedIndividual ,
                                        mknd:CVSS-IntegrityImpact ;
                               mknd:value "HIGH" ;
                               rdfs:label "High" ;
                               skos:altLabel "I:H" ;
                               skos:definition "There is a total loss of integrity, or a complete loss of protection. For example, the attacker is able to modify any/all files protected by the impacted component. Alternatively, only some files can be modified, but malicious modification would present a direct, serious consequence to the impacted component." .


###  https://w3id.org/mknd/CVSS-IntegrityImpact-Low
mknd:CVSS-IntegrityImpact-Low rdf:type owl:NamedIndividual ,
                                       mknd:CVSS-IntegrityImpact ;
                              mknd:value "LOW" ;
                              rdfs:label "Low" ;
                              skos:altLabel "I:L" ;
                              skos:definition "Modification of data is possible, but the attacker does not have control over the consequence of a modification, or the amount of modification is limited. The data modification does not have a direct, serious impact on the impacted component." .


###  https://w3id.org/mknd/CVSS-IntegrityImpact-None
mknd:CVSS-IntegrityImpact-None rdf:type owl:NamedIndividual ,
                                        mknd:CVSS-IntegrityImpact ;
                               mknd:value "NONE" ;
                               rdfs:label "None" ;
                               skos:altLabel "I:N" ;
                               skos:definition "There is no loss of integrity within the impacted component." .


###  https://w3id.org/mknd/CVSS-PrivilegesRequired-High
mknd:CVSS-PrivilegesRequired-High rdf:type owl:NamedIndividual ,
                                           mknd:CVSS-PrivilegesRequired ;
                                  mknd:value "HIGH" ;
                                  rdfs:label "High" ;
                                  skos:altLabel "PR:H" ;
                                  skos:definition "The attacker requires privileges that provide significant (e.g., administrative) control over the vulnerable component allowing access to component-wide settings and files." .


###  https://w3id.org/mknd/CVSS-PrivilegesRequired-Low
mknd:CVSS-PrivilegesRequired-Low rdf:type owl:NamedIndividual ,
                                          mknd:CVSS-PrivilegesRequired ;
                                 mknd:value "LOW" ;
                                 rdfs:label "Low" ;
                                 skos:altLabel "PR:L" ;
                                 skos:definition "The attacker requires privileges that provide basic user capabilities that could normally affect only settings and files owned by a user. Alternatively, an attacker with Low privileges has the ability to access only non-sensitive resources." .


###  https://w3id.org/mknd/CVSS-PrivilegesRequired-None
mknd:CVSS-PrivilegesRequired-None rdf:type owl:NamedIndividual ,
                                           mknd:CVSS-PrivilegesRequired ;
                                  mknd:value "NONE" ;
                                  rdfs:label "None" ;
                                  skos:altLabel "PR:N" ;
                                  skos:definition "The attacker is unauthorized prior to attack, and therefore does not require any access to settings or files of the vulnerable system to carry out an attack." .


###  https://w3id.org/mknd/CVSS-RemediationLevel-NotDefined
mknd:CVSS-RemediationLevel-NotDefined rdf:type owl:NamedIndividual ,
                                               mknd:CVSS-RemediationLevel ;
                                      mknd:value "X" ;
                                      rdfs:label "Not Defined (X)" ;
                                      skos:altLabel "RL:X" ;
                                      skos:definition "Assigning this value indicates there is insufficient information to choose one of the other values, and has no impact on the overall Temporal Score, i.e., it has the same effect on scoring as assigning Unavailable." .


###  https://w3id.org/mknd/CVSS-RemediationLevel-OfficialFix
mknd:CVSS-RemediationLevel-OfficialFix rdf:type owl:NamedIndividual ,
                                                mknd:CVSS-RemediationLevel ;
                                       mknd:value "O" ;
                                       rdfs:label "Official Fix (O)" ;
                                       skos:altLabel "RL:O" ;
                                       skos:definition "A complete vendor solution is available. Either the vendor has issued an official patch, or an upgrade is available." .


###  https://w3id.org/mknd/CVSS-RemediationLevel-TemporaryFix
mknd:CVSS-RemediationLevel-TemporaryFix rdf:type owl:NamedIndividual ,
                                                 mknd:CVSS-RemediationLevel ;
                                        mknd:value "T" ;
                                        rdfs:label "Temporary Fix (T)" ;
                                        skos:altLabel "RL:T" ;
                                        skos:definition "There is an official but temporary fix available. This includes instances where the vendor issues a temporary hotfix, tool, or workaround." .


###  https://w3id.org/mknd/CVSS-RemediationLevel-Unavailable
mknd:CVSS-RemediationLevel-Unavailable rdf:type owl:NamedIndividual ,
                                                mknd:CVSS-RemediationLevel ;
                                       mknd:value "U" ;
                                       rdfs:label "Unavailable (U)" ;
                                       skos:altLabel "RL:U" ;
                                       skos:definition "There is either no solution available or it is impossible to apply." .


###  https://w3id.org/mknd/CVSS-RemediationLevel-Workaround
mknd:CVSS-RemediationLevel-Workaround rdf:type owl:NamedIndividual ,
                                               mknd:CVSS-RemediationLevel ;
                                      mknd:value "W" ;
                                      rdfs:label "Workaround (W)" ;
                                      skos:altLabel "RL:W" ;
                                      skos:definition "There is an unofficial, non-vendor solution available. In some cases, users of the affected technology will create a patch of their own or provide steps to work around or otherwise mitigate the vulnerability." .


###  https://w3id.org/mknd/CVSS-ReportConfidence-Confirmed
mknd:CVSS-ReportConfidence-Confirmed rdf:type owl:NamedIndividual ,
                                              mknd:CVSS-ReportConfidence ;
                                     mknd:value "CONFIRMED" ;
                                     mknd:version 3.1 ;
                                     rdfs:label "Confirmed" ;
                                     skos:altLabel "RC:C" ;
                                     skos:definition "Detailed reports exist, or functional reproduction is possible (functional exploits may provide this). Source code is available to independently verify the assertions of the research, or the author or vendor of the affected code has confirmed the presence of the vulnerability." .


###  https://w3id.org/mknd/CVSS-ReportConfidence-NotDefined
mknd:CVSS-ReportConfidence-NotDefined rdf:type owl:NamedIndividual ,
                                               mknd:CVSS-ReportConfidence ;
                                      mknd:value "X" ;
                                      rdfs:label "Not Defined (X)" ;
                                      skos:altLabel "RC:X" ;
                                      skos:definition "Assigning this value indicates there is insufficient information to choose one of the other values, and has no impact on the overall Temporal Score, i.e., it has the same effect on scoring as assigning Confirmed." .


###  https://w3id.org/mknd/CVSS-ReportConfidence-Reasonable
mknd:CVSS-ReportConfidence-Reasonable rdf:type owl:NamedIndividual ,
                                               mknd:CVSS-ReportConfidence ;
                                      mknd:value "R" ;
                                      rdfs:label "Reasonable (R)" ;
                                      skos:altLabel "RC:R" ;
                                      skos:definition "Significant details are published, but researchers either do not have full confidence in the root cause, or do not have access to source code to fully confirm all of the interactions that may lead to the result. Reasonable confidence exists, however, that the bug is reproducible and at least one impact is able to be verified (proof-of-concept exploits may provide this). An example is a detailed write-up of research into a vulnerability with an explanation (possibly obfuscated or “left as an exercise to the reader”) that gives assurances on how to reproduce the results." .


###  https://w3id.org/mknd/CVSS-ReportConfidence-Unknown
mknd:CVSS-ReportConfidence-Unknown rdf:type owl:NamedIndividual ,
                                            mknd:CVSS-ReportConfidence ;
                                   mknd:value "U" ;
                                   rdfs:label "Unknown (U)" ;
                                   skos:altLabel "RC:U" ;
                                   skos:definition "There are reports of impacts that indicate a vulnerability is present. The reports indicate that the cause of the vulnerability is unknown, or reports may differ on the cause or impacts of the vulnerability. Reporters are uncertain of the true nature of the vulnerability, and there is little confidence in the validity of the reports or whether a static Base Score can be applied given the differences described. An example is a bug report which notes that an intermittent but non-reproducible crash occurs, with evidence of memory corruption suggesting that denial of service, or possible more serious impacts, may result." .


###  https://w3id.org/mknd/CVSS-Scope-Changed
mknd:CVSS-Scope-Changed rdf:type owl:NamedIndividual ,
                                 mknd:CVSS-Scope ;
                        owl:differentFrom mknd:CVSS-Scope-Unchanged ;
                        mknd:value "CHANGED" ;
                        mknd:version 3.1 ;
                        rdfs:label "Changed" ;
                        skos:altLabel "S:C" ;
                        skos:definition "An exploited vulnerability can affect resources beyond the security scope managed by the security authority of the vulnerable component. In this case, the vulnerable component and the impacted component are different and managed by different security authorities." .


###  https://w3id.org/mknd/CVSS-Scope-Unchanged
mknd:CVSS-Scope-Unchanged rdf:type owl:NamedIndividual ,
                                   mknd:CVSS-Scope ;
                          mknd:value "UNCHANGED" ;
                          rdfs:label "Unchanged" ;
                          skos:altLabel "S:U" ;
                          skos:definition "An exploited vulnerability can only affect resources managed by the same security authority. In this case, the vulnerable component and the impacted component are either the same, or both are managed by the same security authority." .


###  https://w3id.org/mknd/CVSS-SecurityRequirement-High
mknd:CVSS-SecurityRequirement-High rdf:type owl:NamedIndividual ,
                                            mknd:CVSS-SecurityRequirement ;
                                   rdfs:label "High" ;
                                   skos:definition "Loss of [Confidentiality | Integrity | Availability] is likely to have a catastrophic adverse effect on the organization or individuals associated with the organization (e.g., employees, customers)." .


###  https://w3id.org/mknd/CVSS-SecurityRequirement-Low
mknd:CVSS-SecurityRequirement-Low rdf:type owl:NamedIndividual ,
                                           mknd:CVSS-SecurityRequirement ;
                                  rdfs:label "Low" ;
                                  skos:definition "Loss of [Confidentiality | Integrity | Availability] is likely to have only a limited adverse effect on the organization or individuals associated with the organization (e.g., employees, customers)." .


###  https://w3id.org/mknd/CVSS-SecurityRequirement-Medium
mknd:CVSS-SecurityRequirement-Medium rdf:type owl:NamedIndividual ,
                                              mknd:CVSS-SecurityRequirement ;
                                     rdfs:label "Medium" ;
                                     skos:definition "Loss of [Confidentiality | Integrity | Availability] is likely to have a serious adverse effect on the organization or individuals associated with the organization (e.g., employees, customers)." .


###  https://w3id.org/mknd/CVSS-SecurityRequirement-NotDefined
mknd:CVSS-SecurityRequirement-NotDefined rdf:type owl:NamedIndividual ,
                                                  mknd:CVSS-SecurityRequirement ;
                                         rdfs:label "Not Defined (X)" ;
                                         skos:definition "Assigning this value indicates there is insufficient information to choose one of the other values, and has no impact on the overall Environmental Score, i.e., it has the same effect on scoring as assigning Medium." .


###  https://w3id.org/mknd/CVSS-SeverityType-Critical
mknd:CVSS-SeverityType-Critical rdf:type owl:NamedIndividual ,
                                         mknd:CVSS-SeverityType ;
                                mknd:value "CRITICAL" ;
                                rdfs:label "Critical" .


###  https://w3id.org/mknd/CVSS-SeverityType-High
mknd:CVSS-SeverityType-High rdf:type owl:NamedIndividual ,
                                     mknd:CVSS-SeverityType ;
                            mknd:value "HIGH" ;
                            rdfs:label "High" .


###  https://w3id.org/mknd/CVSS-SeverityType-Low
mknd:CVSS-SeverityType-Low rdf:type owl:NamedIndividual ,
                                    mknd:CVSS-SeverityType ;
                           mknd:value "LOW" ;
                           rdfs:label "Low" .


###  https://w3id.org/mknd/CVSS-SeverityType-Medium
mknd:CVSS-SeverityType-Medium rdf:type owl:NamedIndividual ,
                                       mknd:CVSS-SeverityType ;
                              mknd:value "MEDIUM" ;
                              rdfs:label "Medium" .


###  https://w3id.org/mknd/CVSS-SeverityType-None
mknd:CVSS-SeverityType-None rdf:type owl:NamedIndividual ,
                                     mknd:CVSS-SeverityType ;
                            mknd:value "NONE" ;
                            rdfs:label "None" .


###  https://w3id.org/mknd/CVSS-UserInteraction-None
mknd:CVSS-UserInteraction-None rdf:type owl:NamedIndividual ,
                                        mknd:CVSS-UserInteraction ;
                               owl:differentFrom mknd:CVSS-UserInteraction-Required ;
                               mknd:value "NONE" ;
                               rdfs:label "None" ;
                               skos:altLabel "UI:N" ;
                               skos:definition "The vulnerable system can be exploited without interaction from any user." .


###  https://w3id.org/mknd/CVSS-UserInteraction-Required
mknd:CVSS-UserInteraction-Required rdf:type owl:NamedIndividual ,
                                            mknd:CVSS-UserInteraction ;
                                   mknd:value "REQUIRED" ;
                                   rdfs:label "Required" ;
                                   skos:altLabel "UI:R" ;
                                   skos:definition "Successful exploitation of this vulnerability requires a user to take some action before the vulnerability can be exploited. For example, a successful exploit may only be possible during the installation of an application by a system administrator." .


