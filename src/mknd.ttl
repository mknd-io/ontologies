###  https://w3id.org/mknd/MediumSeverityVulnerability
mknd:MediumSeverityVulnerability rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( d3f:Vulnerability
                                                                            [ rdf:type owl:Class ;
                                                                              owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                     owl:onProperty mknd:cvssBaseScore ;
                                                                                                                     owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                          owl:onDatatype xsd:decimal ;
                                                                                                                                          owl:withRestrictions ( [ xsd:minInclusive 4.0
                                                                                                                                                                 ]
                                                                                                                                                               )
                                                                                                                                        ]
                                                                                                                   ]
                                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                                     owl:onProperty mknd:cvssBaseScore ;
                                                                                                                     owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                          owl:onDatatype xsd:decimal ;
                                                                                                                                          owl:withRestrictions ( [ xsd:maxExclusive 7.0
                                                                                                                                                                 ]
                                                                                                                                                               )
                                                                                                                                        ]
                                                                                                                   ]
                                                                                                                 ) ;
                                                                                              rdf:type owl:Class
                                                                                            ]
                                                                                            [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty mknd:severityRating ;
                                                                                              owl:hasValue mknd:CVSS-SeverityType-Medium
                                                                                            ]
                                                                                          )
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf d3f:Vulnerability ;
                                 rdfs:label "Medium Severity Vulnerability" .


###  https://w3id.org/mknd/MekaThing
mknd:MekaThing rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty mknd:timeSeen ;
                                 owl:someValuesFrom xsd:dateTimeStamp
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mknd:firstSeen ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTimeStamp
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mknd:firstSeenEpoch ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:long
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mknd:lastSeen ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTimeStamp
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mknd:timeCreated ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTimeStamp
                               ] ;
               rdfs:label "Mekanoid Thing"@en ;
               skos:altLabel "Mekanoid Ontology Item" ;
               mknd:icon "mekanoid.svg"^^xsd:anyURI .


