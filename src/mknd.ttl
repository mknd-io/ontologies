@prefix : <https://w3id.org/mknd/> .
@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mknd: <https://w3id.org/mknd/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/mknd/> .

<https://w3id.org/mknd/> rdf:type owl:Ontology ;
                          owl:versionIRI <https://w3id.org/mknd/0.4.0/> ;
                          owl:imports <https://w3id.org/mknd/alignment/d3fend> ;
                          dcterms:created "2022-04-02"^^xsd:date ;
                          dcterms:creator <https://orcid.org/0000-0001-7399-6740> ;
                          dcterms:description "Mekanoid Ontology (MKND) is a public ontology for semantic knowledge graph applications. It is defined with a purpose to make trusted and autonomous cybersecurity prevention and response possible. It is a superset of the MITRE D3FEND ontology, and is designed to be used in conjunction with it. Mekanoid is a work in progress, and is subject to change."@en ;
                          dcterms:license <https://opensource.org/license/mit> ;
                          dcterms:modified "2026-10-29"^^xsd:date ;
                          dcterms:title "Mekanoid Ontology (MKND)"@en ;
                          vann:preferredNamespacePrefix "mknd" ;
                          vann:preferredNamespaceUri "https://w3id.org/mknd/"^^xsd:anyURI ;
                          rdfs:comment "Maintained by Anton Goncharov <anton.goncharov@gmail.com>. Released under the MIT License."@en ;
                          owl:priorVersion <https://mekanoid.io/ontology/0.3.0/> ;
                          owl:versionInfo "0.4.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  https://w3id.org/mknd/context
mknd:context rdf:type owl:AnnotationProperty ;
             rdfs:label "context"@en ;
             rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/mknd/icon
mknd:icon rdf:type owl:AnnotationProperty ;
          rdfs:label "has icon"@en ;
          rdfs:range xsd:anyURI ;
          rdfs:domain owl:Thing .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://d3fend.mitre.org/ontologies/d3fend.owl#connects
d3f:connects owl:inverseOf mknd:connected-by .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#provides
d3f:provides owl:inverseOf mknd:provided-by .


###  https://w3id.org/mknd/analyzed-by
mknd:analyzed-by rdf:type owl:ObjectProperty ;
                 rdfs:label "analyzed by"@en .


###  https://w3id.org/mknd/attackComplexity
mknd:attackComplexity rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf mknd:hasCVSSMetric ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:range mknd:CVSS-AttackComplexity ;
                      rdfs:label "attack complexity" .


###  https://w3id.org/mknd/attackVector
mknd:attackVector rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf mknd:hasCVSSMetric ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:range mknd:CVSS-AttackVector ;
                  rdfs:label "attack vector"@en .


###  https://w3id.org/mknd/availabilityImpact
mknd:availabilityImpact rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf mknd:hasCVSSMetric ;
                        rdf:type owl:FunctionalProperty ;
                        rdfs:range mknd:CVSS-AvailabilityImpact ;
                        rdfs:label "availability impact"@en .


###  https://w3id.org/mknd/confidentialityImpact
mknd:confidentialityImpact rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf mknd:hasCVSSMetric ;
                           rdf:type owl:FunctionalProperty ;
                           rdfs:label "confidentiality impact"@en .


###  https://w3id.org/mknd/connected-by
mknd:connected-by rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf d3f:d3fend-catalog-object-property ;
                  rdfs:label "connected by"@en .


###  https://w3id.org/mknd/exploitCodeMaturity
mknd:exploitCodeMaturity rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf mknd:hasCVSSMetric ;
                         rdf:type owl:FunctionalProperty ;
                         rdfs:range mknd:CVSS-ExploitCodeMaturity ;
                         rdfs:label "exploit code maturity" .


###  https://w3id.org/mknd/hasCVSSMetric
mknd:hasCVSSMetric rdf:type owl:ObjectProperty ;
                   rdfs:domain d3f:Vulnerability ;
                   rdfs:label "has CVSS metric" .


###  https://w3id.org/mknd/indicatedBy
mknd:indicatedBy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf mknd:mayBeIndicatedBy ;
                 owl:inverseOf mknd:indicates ;
                 rdfs:label "indicated by"@en .


###  https://w3id.org/mknd/indicates
mknd:indicates rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf mknd:mayIndicate ;
               rdfs:label "indicates"@en .


###  https://w3id.org/mknd/integrityImpact
mknd:integrityImpact rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf mknd:hasCVSSMetric ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:label "integrity impact"@en .


###  https://w3id.org/mknd/isolated-by
mknd:isolated-by rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf d3f:d3fend-catalog-object-property ;
                 rdfs:label "isolated by"@en .


###  https://w3id.org/mknd/mayBeIndicatedBy
mknd:mayBeIndicatedBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf mknd:mayIndicate ;
                      rdfs:label "may be indicated by"@en .


###  https://w3id.org/mknd/mayIndicate
mknd:mayIndicate rdf:type owl:ObjectProperty ;
                 rdfs:label "may indicate"@en .


###  https://w3id.org/mknd/mkndObjectProperty
mknd:mkndObjectProperty rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf mknd:supports ;
                        rdfs:label "MKND object property"@en .


###  https://w3id.org/mknd/privilegesRequired
mknd:privilegesRequired rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf mknd:hasCVSSMetric ;
                        rdf:type owl:FunctionalProperty ;
                        rdfs:label "privileges required"@en .


###  https://w3id.org/mknd/provided-by
mknd:provided-by rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf d3f:d3fend-catalog-object-property ;
                 rdfs:label "provided by"@en .


###  https://w3id.org/mknd/remediationLevel
mknd:remediationLevel rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf mknd:hasCVSSMetric ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:range mknd:CVSS-RemediationLevel ;
                      rdfs:label "remediation level" .


###  https://w3id.org/mknd/reportConfidence
mknd:reportConfidence rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf mknd:hasCVSSMetric ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:range mknd:CVSS-ReportConfidence ;
                      rdfs:label "report confidence" .


###  https://w3id.org/mknd/scope
mknd:scope rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf mknd:hasCVSSMetric ;
           rdf:type owl:FunctionalProperty ;
           rdfs:label "scope"@en .


###  https://w3id.org/mknd/severityRating
mknd:severityRating rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf mknd:hasCVSSMetric ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:range mknd:CVSS-SeverityType ;
                    rdfs:label "severity" .


###  https://w3id.org/mknd/supports
mknd:supports rdf:type owl:ObjectProperty ;
              rdfs:label "supports"@en ;
              skos:example "Integration x supports product or service y." .


###  https://w3id.org/mknd/updated-by
mknd:updated-by rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf d3f:modified-by ;
                rdfs:label "updated by" .


###  https://w3id.org/mknd/userInteraction
mknd:userInteraction rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf mknd:hasCVSSMetric ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:label "user interaction"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/mknd/cpe
mknd:cpe rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf d3f:identifier ;
         rdfs:range xsd:string ;
         rdfs:label "CPE" ;
         skos:example "cpe:2.3:a:apple:icloud:1.0:*:*:*:*:macos:*:*" .


###  https://w3id.org/mknd/cvssBaseScore
mknd:cvssBaseScore rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain d3f:Vulnerability ;
                   rdfs:range xsd:decimal ;
                   rdfs:label "base score" .


###  https://w3id.org/mknd/cvssExploitabilityScore
mknd:cvssExploitabilityScore rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf owl:topDataProperty ;
                             rdf:type owl:FunctionalProperty ;
                             rdfs:domain d3f:Vulnerability ;
                             rdfs:range xsd:decimal ;
                             rdfs:label "exploitability score" .


###  https://w3id.org/mknd/cvssImpactScore
mknd:cvssImpactScore rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain d3f:Vulnerability ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "impact score" .


###  https://w3id.org/mknd/dateTime
mknd:dateTime rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain mknd:MekaThing ;
              rdfs:range xsd:dateTimeStamp ;
              rdfs:label "has timestamp"@en ;
              skos:definition "A date and time associated with the entity"@en ;
              skos:example "2002-10-10T12:00:00-05:00" .


###  https://w3id.org/mknd/dateTimeEpoch
mknd:dateTimeEpoch rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:range xsd:long ;
                   rdfs:comment "A Unix epoch timestamp associated with the entity"@en ;
                   rdfs:label "has epoch"@en ;
                   skos:definition "A Unix epoch timestamp associated with the entity"@en ;
                   skos:example "990577200"^^xsd:long .


###  https://w3id.org/mknd/extCategory
mknd:extCategory rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf mknd:vendorProperty ;
                 rdfs:label "category" .


###  https://w3id.org/mknd/extClassification
mknd:extClassification rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf mknd:vendorProperty ;
                       rdfs:comment "An external classification that may apply to the artifact. Typically provided by a 3rd party vendor."@en ;
                       rdfs:label "classification"@en .


###  https://w3id.org/mknd/extPriority
mknd:extPriority rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf mknd:extClassification ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:comment "Priority as defined by the 3rd party vendor responsible for creating the Artifact."@en ;
                 rdfs:label "Priority"@en .


###  https://w3id.org/mknd/extRisk
mknd:extRisk rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf mknd:extClassification ;
             rdfs:comment "Risk as defined by the 3rd party vendor responsible for creating the Artifact."@en ;
             rdfs:label "Risk"@en .


###  https://w3id.org/mknd/extSeverity
mknd:extSeverity rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf mknd:extClassification ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:comment "Severity as defined by the 3rd party vendor responsible for creating the Artifact."@en ;
                 rdfs:label "Severity"@en .


###  https://w3id.org/mknd/extStatus
mknd:extStatus rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf mknd:vendorProperty ;
               rdfs:comment "Status of the Artifact as defined by the 3rd party vendor software responsible for generating it."@en ;
               rdfs:label "status"@en .


###  https://w3id.org/mknd/extThreat
mknd:extThreat rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf mknd:extClassification ;
               rdfs:comment "Threat Level as defined by the 3rd party vendor responcible for creating the Artifact."@en ;
               rdfs:label "Threat Level"@en .


###  https://w3id.org/mknd/extType
mknd:extType rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf mknd:vendorProperty ;
             rdfs:label "type" .


###  https://w3id.org/mknd/extUrgency
mknd:extUrgency rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf mknd:extClassification ;
                rdf:type owl:FunctionalProperty ;
                rdfs:comment "Urgency as defined by the 3rd party vendor responsible for generating the Artifact."@en ;
                rdfs:label "Urgency"@en .


###  https://w3id.org/mknd/external-id
mknd:external-id rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf d3f:identifier ,
                                    mknd:vendorProperty ;
                 rdfs:label "external ID"@en ;
                 skos:altLabel "vendor ID" ;
                 skos:definition "Mekanoid data property that represents an identifier assigned by an external system or vendor. It is applicable to entities such as hosts and user accounts, providing a unique string-based identifier that aligns with external records or systems. This property facilitates the integration and mapping of internal entities with external references, enhancing cross-system data coherence and identification." .


###  https://w3id.org/mknd/firstSeen
mknd:firstSeen rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf mknd:timeSeen ;
               rdfs:comment "The first time the enity had been observed by the application."@en ;
               rdfs:label "first seen"@en .


###  https://w3id.org/mknd/firstSeenEpoch
mknd:firstSeenEpoch rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf mknd:dateTimeEpoch ;
                    rdfs:label "first seen (epoch)"@en .


###  https://w3id.org/mknd/hasURL
mknd:hasURL rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf mknd:reference ;
            rdfs:domain d3f:File ,
                        mknd:Report ;
            rdfs:range xsd:anyURI ;
            rdfs:label "has URL"@en .


###  https://w3id.org/mknd/id
mknd:id rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf d3f:identifier ;
        rdfs:label "ID"@en ;
        skos:definition "Mekanoid ID" .


###  https://w3id.org/mknd/importBucketName
mknd:importBucketName rdf:type owl:DatatypeProperty ;
                      rdfs:label "S3 bucket name"@en .


###  https://w3id.org/mknd/importBucketUrl
mknd:importBucketUrl rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf mknd:hasURL ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:range xsd:anyURI ;
                     rdfs:label "S3 bucket URL"@en .


###  https://w3id.org/mknd/importFileName
mknd:importFileName rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:range xsd:anyURI ;
                    rdfs:label "filename"@en .


###  https://w3id.org/mknd/importId
mknd:importId rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf d3f:identifier ;
              rdfs:label "import ID"@en .


###  https://w3id.org/mknd/lastAccessedEpoch
mknd:lastAccessedEpoch rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf mknd:dateTimeEpoch ;
                       rdfs:label "last accessed"@en .


###  https://w3id.org/mknd/lastSeen
mknd:lastSeen rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf mknd:timeSeen ;
              rdfs:comment "The last time the entity had been observed by the application."@en ;
              rdfs:label "last seen"@en .


###  https://w3id.org/mknd/lastSeenEpoch
mknd:lastSeenEpoch rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf mknd:dateTimeEpoch ;
                   rdfs:label "last seen (epoch)"@en .


###  https://w3id.org/mknd/lastStatusChangeEpoch
mknd:lastStatusChangeEpoch rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf mknd:dateTimeEpoch ;
                           rdfs:label "last status change"@en .


###  https://w3id.org/mknd/lastUpdated
mknd:lastUpdated rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf mknd:updated ;
                 rdfs:label "last updated at" ;
                 skos:altLabel "last modified at" .


###  https://w3id.org/mknd/lastUpdatedEpoch
mknd:lastUpdatedEpoch rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf mknd:dateTimeEpoch ;
                      rdfs:label "last modified"@en .


###  https://w3id.org/mknd/last_modified
mknd:last_modified rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf mknd:updated ;
                   rdfs:label "last modified" .


###  https://w3id.org/mknd/reference
mknd:reference rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:label "has reference" .


###  https://w3id.org/mknd/size
mknd:size rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain d3f:File ;
          rdfs:range xsd:byte ;
          rdfs:label "has size"@en .


###  https://w3id.org/mknd/stringValue
mknd:stringValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain mknd:Observable ;
                 rdfs:range xsd:string ;
                 rdfs:comment "the object is represented by the following string value"@en ;
                 rdfs:label "is"@en .


###  https://w3id.org/mknd/teamId
mknd:teamId rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf d3f:identifier ;
            rdf:type owl:FunctionalProperty ;
            owl:propertyDisjointWith mknd:userId ;
            rdfs:label "team ID"@en .


###  https://w3id.org/mknd/templateId
mknd:templateId rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf d3f:identifier ;
                rdf:type owl:FunctionalProperty ;
                rdfs:label "template ID"@en .


###  https://w3id.org/mknd/timeCreated
mknd:timeCreated rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf mknd:dateTime ;
                 rdfs:comment "Time when the entity had been created at the point of origin."@en ;
                 rdfs:label "created at"@en .


###  https://w3id.org/mknd/timeCreatedEpoch
mknd:timeCreatedEpoch rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf mknd:dateTimeEpoch ;
                      rdfs:comment "Time when the entity had been created at the point of origin."@en ;
                      rdfs:label "created at (epoch)"@en .


###  https://w3id.org/mknd/timeSeen
mknd:timeSeen rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf mknd:dateTime ;
              rdfs:comment "A timestamp associated with a point in time when the entity had been observed by the application in some way."@en ;
              rdfs:label "seen at"@en .


###  https://w3id.org/mknd/updated
mknd:updated rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf mknd:dateTime ;
             rdfs:label "modified at" ,
                        "updated at" ;
             skos:altLabel "modified at" .


###  https://w3id.org/mknd/userId
mknd:userId rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf d3f:identifier ;
            rdf:type owl:FunctionalProperty ;
            rdfs:label "user ID"@en .


###  https://w3id.org/mknd/usesNetworkPort
mknd:usesNetworkPort rdf:type owl:DatatypeProperty ;
                     rdfs:range xsd:positiveInteger ;
                     rdfs:comment "uses network port number" ;
                     rdfs:label "uses port" .


###  https://w3id.org/mknd/value
mknd:value rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:comment "A value parameter to be passed to Tasks"@en ;
           rdfs:label "has value"@en .


###  https://w3id.org/mknd/vectorString
mknd:vectorString rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain d3f:Vulnerability ;
                  rdfs:range xsd:string ;
                  rdfs:label "vector" .


###  https://w3id.org/mknd/vendorProperty
mknd:vendorProperty rdf:type owl:DatatypeProperty ;
                    rdfs:label "vendor property" .


###  https://w3id.org/mknd/version
mknd:version rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:range xsd:decimal ;
             rdfs:label "CVSS version" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/mknd/ASN
mknd:ASN rdf:type owl:Class ;
         rdfs:subClassOf d3f:Identifier ,
                         mknd:MekaThing ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty mknd:value ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
         rdfs:comment "Autonomous System Number"@en ;
         rdfs:label "ASN"@en .


###  https://w3id.org/mknd/ActionableItem
mknd:ActionableItem rdf:type owl:Class ;
                    rdfs:subClassOf d3f:Record ,
                                    mknd:MekaThing ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty d3f:created-by ;
                                      owl:someValuesFrom d3f:ApplicationRule
                                    ] ;
                    rdfs:comment "A foundational element for analyst workflows."@en ;
                    rdfs:label "Actionable Item"@en .


###  https://w3id.org/mknd/Advisory
mknd:Advisory rdf:type owl:Class ;
              rdfs:subClassOf d3f:Document ,
                              mknd:MekaThing ;
              rdfs:isDefinedBy "https://csrc.nist.gov/glossary/term/advisory"^^xsd:anyURI ;
              rdfs:label "Advisory"@en ;
              skos:definition "Notification of significant new trends or developments regarding the threat to the information systems of an organization. This notification may include analytical insights into trends, intentions, technologies, or tactics of an adversary targeting information systems. Rationale: General definition of a commonly understood term."@en .


###  https://w3id.org/mknd/AppUser
mknd:AppUser rdf:type owl:Class ;
             rdfs:subClassOf mknd:ApplicationUserAccount ,
                             mknd:SystemObject ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty d3f:accessed-by ;
                               owl:someValuesFrom d3f:User
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty d3f:creates ;
                               owl:someValuesFrom mknd:Filter
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty d3f:creates ;
                               owl:someValuesFrom mknd:TaskPattern
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty d3f:executes ;
                               owl:someValuesFrom mknd:ManualTaskRun
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty d3f:may-access ;
                               owl:someValuesFrom mknd:Tenant
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mknd:userId ;
                               owl:someValuesFrom xsd:string
                             ] ;
             rdfs:comment "Mekanoid User Account" ;
             rdfs:label "Mekanoid User Account" .


###  https://w3id.org/mknd/ApplicationUserAccount
mknd:ApplicationUserAccount rdf:type owl:Class ;
                            rdfs:subClassOf d3f:UserAccount ;
                            rdfs:label "Application User Account" .


###  https://w3id.org/mknd/AutomatedTaskRun
mknd:AutomatedTaskRun rdf:type owl:Class ;
                      rdfs:subClassOf mknd:MachineAction ,
                                      mknd:TaskRun ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty d3f:invoked-by ;
                                        owl:allValuesFrom mknd:TaskPattern
                                      ] ;
                      rdfs:label "Automated Task Run" .


###  https://w3id.org/mknd/CVSS
mknd:CVSS rdf:type owl:Class ;
          rdfs:isDefinedBy "https://www.first.org/cvss/v3.1/specification-document"^^xsd:anyURI ;
          rdfs:label "CVSS Metric" .


###  https://w3id.org/mknd/CVSS-AttackComplexity
mknd:CVSS-AttackComplexity rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( mknd:CVSS-AttackComplexity-High
                                                             mknd:CVSS-AttackComplexity-Low
                                                           )
                                               ] ;
                           rdfs:subClassOf mknd:CVSS ;
                           rdfs:label "Attack Complexity" ;
                           skos:altLabel "AC" ;
                           skos:definition "This metric describes the conditions beyond the attacker’s control that must exist in order to exploit the vulnerability. As described below, such conditions may require the collection of more information about the target, or computational exceptions. Importantly, the assessment of this metric excludes any requirements for user interaction in order to exploit the vulnerability (such conditions are captured in the User Interaction metric). If a specific configuration is required for an attack to succeed, the Base metrics should be scored assuming the vulnerable component is in that configuration. The Base Score is greatest for the least complex attacks." .


###  https://w3id.org/mknd/CVSS-AttackVector
mknd:CVSS-AttackVector rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:oneOf ( mknd:CVSS-AttackVector-Adjacent
                                                         mknd:CVSS-AttackVector-Local
                                                         mknd:CVSS-AttackVector-Network
                                                         mknd:CVSS-AttackVector-Physical
                                                       )
                                           ] ;
                       rdfs:subClassOf mknd:CVSS ;
                       rdfs:label "Attack Vector" ;
                       skos:altLabel "AV" ;
                       skos:definition "This metric reflects the context by which vulnerability exploitation is possible. This metric value (and consequently the Base Score) will be larger the more remote (logically, and physically) an attacker can be in order to exploit the vulnerable component. The assumption is that the number of potential attackers for a vulnerability that could be exploited from across a network is larger than the number of potential attackers that could exploit a vulnerability requiring physical access to a device, and therefore warrants a greater Base Score." .


###  https://w3id.org/mknd/CVSS-AvailabilityImpact
mknd:CVSS-AvailabilityImpact rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( mknd:CVSS-AvailabilityImpact-High
                                                               mknd:CVSS-AvailabilityImpact-Low
                                                               mknd:CVSS-AvailabilityImpact-None
                                                             )
                                                 ] ;
                             rdfs:subClassOf mknd:CVSS ;
                             rdfs:label "Availability Impact" ;
                             skos:altLabel "A" ;
                             skos:definition "This metric measures the impact to the availability of the impacted component resulting from a successfully exploited vulnerability. While the Confidentiality and Integrity impact metrics apply to the loss of confidentiality or integrity of data (e.g., information, files) used by the impacted component, this metric refers to the loss of availability of the impacted component itself, such as a networked service (e.g., web, database, email). Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component. The Base Score is greatest when the consequence to the impacted component is highest." .


###  https://w3id.org/mknd/CVSS-ConfidentialityImpact
mknd:CVSS-ConfidentialityImpact rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Class ;
                                                      owl:oneOf ( mknd:CVSS-ConfidentialityImpact-High
                                                                  mknd:CVSS-ConfidentialityImpact-Low
                                                                  mknd:CVSS-ConfidentialityImpact-None
                                                                )
                                                    ] ;
                                rdfs:subClassOf mknd:CVSS ;
                                rdfs:label "Confidentiality Impact" ;
                                skos:altLabel "C" ;
                                skos:definition "This metric measures the impact to the confidentiality of the information resources managed by a software component due to a successfully exploited vulnerability. Confidentiality refers to limiting information access and disclosure to only authorized users, as well as preventing access by, or disclosure to, unauthorized ones. The Base Score is greatest when the loss to the impacted component is highest." .


###  https://w3id.org/mknd/CVSS-ExploitCodeMaturity
mknd:CVSS-ExploitCodeMaturity rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( mknd:CVSS-ExploitCodeMaturity-Functional
                                                                mknd:CVSS-ExploitCodeMaturity-High
                                                                mknd:CVSS-ExploitCodeMaturity-NotDefined
                                                                mknd:CVSS-ExploitCodeMaturity-ProofOfConcept
                                                                mknd:CVSS-ExploitCodeMaturity-Unproven
                                                              )
                                                  ] ;
                              rdfs:subClassOf mknd:CVSS ;
                              rdfs:label "Exploit Code Maturity" ;
                              skos:altLabel "E" ;
                              skos:definition "This metric measures the likelihood of the vulnerability being attacked, and is typically based on the current state of exploit techniques, exploit code availability, or active, “in-the-wild” exploitation. Public availability of easy-to-use exploit code increases the number of potential attackers by including those who are unskilled, thereby increasing the severity of the vulnerability. Initially, real-world exploitation may only be theoretical. Publication of proof-of-concept code, functional exploit code, or sufficient technical details necessary to exploit the vulnerability may follow. Furthermore, the exploit code available may progress from a proof-of-concept demonstration to exploit code that is successful in exploiting the vulnerability consistently. In severe cases, it may be delivered as the payload of a network-based worm or virus or other automated attack tools." .


###  https://w3id.org/mknd/CVSS-IntegrityImpact
mknd:CVSS-IntegrityImpact rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( mknd:CVSS-IntegrityImpact-High
                                                            mknd:CVSS-IntegrityImpact-Low
                                                            mknd:CVSS-IntegrityImpact-None
                                                          )
                                              ] ;
                          rdfs:subClassOf mknd:CVSS ;
                          rdfs:label "Integrity Impact" ;
                          skos:altLabel "I" ;
                          skos:definition "This metric measures the impact to integrity of a successfully exploited vulnerability. Integrity refers to the trustworthiness and veracity of information. The Base Score is greatest when the consequence to the impacted component is highest." .


###  https://w3id.org/mknd/CVSS-PrivilegesRequired
mknd:CVSS-PrivilegesRequired rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( mknd:CVSS-PrivilegesRequired-High
                                                               mknd:CVSS-PrivilegesRequired-Low
                                                               mknd:CVSS-PrivilegesRequired-None
                                                             )
                                                 ] ;
                             rdfs:subClassOf mknd:CVSS ;
                             rdfs:label "Privileges Required" ;
                             skos:altLabel "PR" ;
                             skos:definition "This metric describes the level of privileges an attacker must possess before successfully exploiting the vulnerability. The Base Score is greatest if no privileges are required." .


###  https://w3id.org/mknd/CVSS-RemediationLevel
mknd:CVSS-RemediationLevel rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( mknd:CVSS-RemediationLevel-NotDefined
                                                             mknd:CVSS-RemediationLevel-OfficialFix
                                                             mknd:CVSS-RemediationLevel-TemporaryFix
                                                             mknd:CVSS-RemediationLevel-Unavailable
                                                             mknd:CVSS-RemediationLevel-Workaround
                                                           )
                                               ] ;
                           rdfs:subClassOf mknd:CVSS ;
                           rdfs:label "Remediation Level" ;
                           skos:altLabel "RL" ;
                           skos:definition "The Remediation Level of a vulnerability is an important factor for prioritization. The typical vulnerability is unpatched when initially published. Workarounds or hotfixes may offer interim remediation until an official patch or upgrade is issued. Each of these respective stages adjusts the Temporal Score downwards, reflecting the decreasing urgency as remediation becomes final. The list of possible values is presented in Table 10. The less official and permanent a fix, the higher the vulnerability score." .


###  https://w3id.org/mknd/CVSS-ReportConfidence
mknd:CVSS-ReportConfidence rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( mknd:CVSS-ReportConfidence-Confirmed
                                                             mknd:CVSS-ReportConfidence-NotDefined
                                                             mknd:CVSS-ReportConfidence-Reasonable
                                                             mknd:CVSS-ReportConfidence-Unknown
                                                           )
                                               ] ;
                           rdfs:subClassOf mknd:CVSS ;
                           rdfs:label "Report Confidence" ;
                           skos:altLabel "RC" ;
                           skos:definition "This metric measures the degree of confidence in the existence of the vulnerability and the credibility of the known technical details. Sometimes only the existence of vulnerabilities is publicized, but without specific details. For example, an impact may be recognized as undesirable, but the root cause may not be known. The vulnerability may later be corroborated by research which suggests where the vulnerability may lie, though the research may not be certain. Finally, a vulnerability may be confirmed through acknowledgment by the author or vendor of the affected technology. The urgency of a vulnerability is higher when a vulnerability is known to exist with certainty. This metric also suggests the level of technical knowledge available to would-be attackers. The more a vulnerability is validated by the vendor or other reputable sources, the higher the score." .


###  https://w3id.org/mknd/CVSS-Scope
mknd:CVSS-Scope rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( mknd:CVSS-Scope-Changed
                                                  mknd:CVSS-Scope-Unchanged
                                                )
                                    ] ;
                rdfs:subClassOf mknd:CVSS ;
                rdfs:label "Scope" ;
                skos:altLabel "S" ;
                skos:definition """The Scope metric captures whether a vulnerability in one vulnerable component impacts resources in components beyond its security scope.

Formally, a security authority is a mechanism (e.g., an application, an operating system, firmware, a sandbox environment) that defines and enforces access control in terms of how certain subjects/actors (e.g., human users, processes) can access certain restricted objects/resources (e.g., files, CPU, memory) in a controlled manner. All the subjects and objects under the jurisdiction of a single security authority are considered to be under one security scope. If a vulnerability in a vulnerable component can affect a component which is in a different security scope than the vulnerable component, a Scope change occurs. Intuitively, whenever the impact of a vulnerability breaches a security/trust boundary and impacts components outside the security scope in which vulnerable component resides, a Scope change occurs.

The security scope of a component encompasses other components that provide functionality solely to that component, even if these other components have their own security authority. For example, a database used solely by one application is considered part of that application’s security scope even if the database has its own security authority, e.g., a mechanism controlling access to database records based on database users and associated database privileges.

The Base Score is greatest when a scope change occurs.""" .


###  https://w3id.org/mknd/CVSS-SecurityRequirement
mknd:CVSS-SecurityRequirement rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( mknd:CVSS-SecurityRequirement-High
                                                                mknd:CVSS-SecurityRequirement-Low
                                                                mknd:CVSS-SecurityRequirement-Medium
                                                                mknd:CVSS-SecurityRequirement-NotDefined
                                                              )
                                                  ] ;
                              rdfs:subClassOf mknd:CVSS ;
                              rdfs:label "Security Requirement" ;
                              skos:definition """These metrics enable the analyst to customize the CVSS score depending on the importance of the affected IT asset to a user’s organization, measured in terms of Confidentiality, Integrity, and Availability. That is, if an IT asset supports a business function for which Availability is most important, the analyst can assign a greater value to Availability relative to Confidentiality and Integrity. Each Security Requirement has three possible values: Low, Medium, or High.

The full effect on the environmental score is determined by the corresponding Modified Base Impact metrics. That is, these metrics modify the environmental score by reweighting the Modified Confidentiality, Integrity, and Availability impact metrics. For example, the Modified Confidentiality impact (MC) metric has increased weight if the Confidentiality Requirement (CR) is High. Likewise, the Modified Confidentiality impact metric has decreased weight if the Confidentiality Requirement is Low. The Modified Confidentiality impact metric weighting is neutral if the Confidentiality Requirement is Medium. This same process is applied to the Integrity and Availability requirements.

Note that the Confidentiality Requirement will not affect the Environmental score if the (Modified Base) confidentiality impact is set to None. Also, increasing the Confidentiality Requirement from Medium to High will not change the Environmental score when the (Modified Base) impact metrics are set to High. This is because the Modified Impact Sub-Score (part of the Modified Base Score that calculates impact) is already at a maximum value of 10.""" .


###  https://w3id.org/mknd/CVSS-SeverityType
mknd:CVSS-SeverityType rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:oneOf ( mknd:CVSS-SeverityType-Critical
                                                         mknd:CVSS-SeverityType-High
                                                         mknd:CVSS-SeverityType-Low
                                                         mknd:CVSS-SeverityType-Medium
                                                         mknd:CVSS-SeverityType-None
                                                       )
                                           ] ;
                       rdfs:subClassOf mknd:CVSS ;
                       rdfs:comment "Qualitative Severity Rating" ;
                       rdfs:label "Severity Type" ;
                       skos:definition "Specifies the CVSS base, temporal, threat, or environmental severity type." .


###  https://w3id.org/mknd/CVSS-UserInteraction
mknd:CVSS-UserInteraction rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( mknd:CVSS-UserInteraction-None
                                                            mknd:CVSS-UserInteraction-Required
                                                          )
                                              ] ;
                          rdfs:subClassOf mknd:CVSS ;
                          rdfs:label "User Interaction" ;
                          skos:altLabel "UI" ;
                          skos:definition "This metric captures the requirement for a human user, other than the attacker, to participate in the successful compromise of the vulnerable component. This metric determines whether the vulnerability can be exploited solely at the will of the attacker, or whether a separate user (or user-initiated process) must participate in some manner. The Base Score is greatest when no user interaction is required." .


###  https://w3id.org/mknd/CommunicationProtocol
mknd:CommunicationProtocol rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( mknd:ICMP
                                                             mknd:TCP
                                                             mknd:UDP
                                                           )
                                               ] ;
                           rdfs:subClassOf mknd:MekaThing ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty d3f:used-by ;
                                             owl:someValuesFrom d3f:NetworkPackets
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty d3f:used-by ;
                                             owl:someValuesFrom d3f:NetworkService
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty d3f:used-by ;
                                             owl:someValuesFrom d3f:NetworkSession
                                           ] ;
                           rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Communication_protocol" ;
                           rdfs:label "Communication Protocol"@en .


###  https://w3id.org/mknd/Connection
mknd:Connection rdf:type owl:Class ;
                rdfs:subClassOf mknd:SystemObject ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty d3f:enables ;
                                  owl:someValuesFrom mknd:Task
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty mknd:supports ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( d3f:SoftwareProduct
                                                                     d3f:SoftwareService
                                                                   )
                                                     ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty d3f:enables ;
                                  owl:allValuesFrom mknd:Integration
                                ] ;
                rdfs:label "Connection"@en ;
                mknd:icon "connection.svg"^^xsd:anyURI .


###  https://w3id.org/mknd/Control
mknd:Control rdf:type owl:Class ;
             rdfs:subClassOf mknd:MekaThing ;
             rdfs:label "Control"@en .


###  https://w3id.org/mknd/CriticalVulnerability
mknd:CriticalVulnerability rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( d3f:Vulnerability
                                                                      [ rdf:type owl:Class ;
                                                                        owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                               owl:onProperty mknd:cvssBaseScore ;
                                                                                                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                    owl:onDatatype xsd:decimal ;
                                                                                                                                    owl:withRestrictions ( [ xsd:minInclusive 9.0
                                                                                                                                                           ]
                                                                                                                                                         )
                                                                                                                                  ]
                                                                                                             ]
                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                               owl:onProperty mknd:cvssBaseScore ;
                                                                                                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                    owl:onDatatype xsd:decimal ;
                                                                                                                                    owl:withRestrictions ( [ xsd:maxInclusive 10.0
                                                                                                                                                           ]
                                                                                                                                                         )
                                                                                                                                  ]
                                                                                                             ]
                                                                                                           ) ;
                                                                                        rdf:type owl:Class
                                                                                      ]
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty mknd:severityRating ;
                                                                                        owl:hasValue mknd:CVSS-SeverityType-Critical
                                                                                      ]
                                                                                    )
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf d3f:Vulnerability ;
                           rdfs:label "Critical Severity Vulnerability" .


###  https://w3id.org/mknd/DataTemplate
mknd:DataTemplate rdf:type owl:Class ;
                  rdfs:subClassOf mknd:SystemObject ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty d3f:invoked-by ;
                                    owl:someValuesFrom mknd:TaskRun
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty d3f:maps ;
                                    owl:someValuesFrom d3f:WebAPIResource
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty d3f:used-by ;
