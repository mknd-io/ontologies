#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( mknd:CVSS-AttackComplexity
                mknd:CVSS-AttackVector
                mknd:CVSS-AvailabilityImpact
                mknd:CVSS-ConfidentialityImpact
                mknd:CVSS-ExploitCodeMaturity
                mknd:CVSS-IntegrityImpact
                mknd:CVSS-PrivilegesRequired
                mknd:CVSS-RemediationLevel
                mknd:CVSS-ReportConfidence
                mknd:CVSS-Scope
                mknd:CVSS-SecurityRequirement
                mknd:CVSS-SeverityType
                mknd:CVSS-UserInteraction
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( mknd:Task
                mknd:TaskPattern
                mknd:TaskRun
                mknd:TaskRunLog
                mknd:TaskTemplate
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( mknd:CVSS-AttackVector-Adjacent
                        mknd:CVSS-AttackVector-Local
                        mknd:CVSS-AttackVector-Network
                        mknd:CVSS-AttackVector-Physical
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( mknd:CVSS-AvailabilityImpact-High
                        mknd:CVSS-AvailabilityImpact-Low
                        mknd:CVSS-AvailabilityImpact-None
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( mknd:CVSS-ConfidentialityImpact-High
                        mknd:CVSS-ConfidentialityImpact-Low
                        mknd:CVSS-ConfidentialityImpact-None
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( mknd:CVSS-ExploitCodeMaturity-Functional
                        mknd:CVSS-ExploitCodeMaturity-High
                        mknd:CVSS-ExploitCodeMaturity-NotDefined
                        mknd:CVSS-ExploitCodeMaturity-ProofOfConcept
                        mknd:CVSS-ExploitCodeMaturity-Unproven
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( mknd:CVSS-IntegrityImpact-High
                        mknd:CVSS-IntegrityImpact-Low
                        mknd:CVSS-IntegrityImpact-None
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( mknd:CVSS-PrivilegesRequired-High
                        mknd:CVSS-PrivilegesRequired-Low
                        mknd:CVSS-PrivilegesRequired-None
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( mknd:CVSS-RemediationLevel-NotDefined
