    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_docker ;
    mknd:provides mknd:function_file-write ;
    mknd:value """CONTAINER_ID="$(docker run -d alpine)" # or existing
TF=$(mktemp)
echo "DATA" > $TF
docker cp $TF $CONTAINER_ID:$TF
docker cp $CONTAINER_ID:$TF file_to_write
""" .

