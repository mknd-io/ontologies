mknd:command_lualatex-limited-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lualatex-limited-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_lualatex ;
