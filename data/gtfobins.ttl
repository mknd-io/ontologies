mknd:command_bundle-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "bundle-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This invokes the default pager, which is likely to be  [`less`](/gtfobins/less/), other functions may apply.",
        "This spawns an interactive shell via [`irb`](/gtfobins/irb/)." ;
    d3f:uses mknd:executable_bundle ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_bundle ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp -d)
echo 'system("/bin/sh")' > $TF/Gemfile
cd $TF
bundle install
""",
        """TF=$(mktemp -d)
touch $TF/Gemfile
cd $TF
bundle console
system('/bin/sh -c /bin/sh')
""",
        """TF=$(mktemp -d)
touch $TF/Gemfile
cd $TF
bundle exec /bin/sh
""",
        """bundle help
!/bin/sh
""",
        """export BUNDLE_GEMFILE=x
bundle exec /bin/sh
""" .

