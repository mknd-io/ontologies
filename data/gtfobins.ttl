    d3f:uses mknd:executable_arj ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_arj ;
    mknd:provides mknd:function_sudo ;
    mknd:value """TF=$(mktemp -d)
LFILE=file_to_write
LDIR=where_to_write
echo DATA >"$TF/$LFILE"
arj a "$TF/a" "$TF/$LFILE"
sudo arj e "$TF/a" $LDIR
""" .

mknd:command_arj-suid a d3f:Command,
