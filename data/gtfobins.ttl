mknd:command_nohup-command a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nohup-command" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_nohup ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nohup ;
    mknd:provides mknd:function_command ;
    mknd:value """COMMAND='/usr/bin/id'
nohup "$COMMAND"
cat nohup.out
""" .

mknd:command_nohup-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nohup-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_nohup ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nohup ;
    mknd:provides mknd:function_shell ;
    mknd:value "nohup /bin/sh -c \"sh <$(tty) >$(tty) 2>$(tty)\"" .

mknd:command_nohup-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nohup-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
