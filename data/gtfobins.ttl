mknd:command_octave-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "octave-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_octave ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_octave ;
    mknd:provides mknd:function_file-read ;
    mknd:value "octave-cli --eval 'format none; fid = fopen(\"file_to_read\"); while(!feof(fid)); txt = fgetl(fid); disp(txt); endwhile; fclose(fid);'" .

mknd:command_octave-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "octave-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_octave ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_octave ;
    mknd:provides mknd:function_file-write ;
    mknd:value "octave-cli --eval 'filename = \"file_to_write\"; fid = fopen(filename, \"w\"); fputs(fid, \"DATA\"); fclose(fid);'" .

