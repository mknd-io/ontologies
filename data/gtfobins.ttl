mknd:command_yarn-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "yarn-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Additionally, arbitrary script names can be used in place of `preinstall` and triggered by name with, e.g., `yarn --cwd $TF run preinstall`." ;
    d3f:uses mknd:executable_yarn ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_yarn ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp -d)
echo '{"scripts": {"preinstall": "/bin/sh"}}' > $TF/package.json
yarn --cwd $TF install
""",
        "yarn exec /bin/sh" .

