        owl:NamedIndividual ;
    rdfs:label "dstat" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """`dstat` allows you to run arbitrary [`python`](/gtfobins/python/) scripts loaded as "external plugins" if they are located in one of the directories stated in the `dstat` man page under "FILES":

1. `~/.dstat/`
2. `(path of binary)/plugins/`
3. `/usr/share/dstat/`
4. `/usr/local/share/dstat/`

Pick the one that you can write into.
""" ;
    d3f:used-by mknd:command_dstat-shell,
        mknd:command_dstat-sudo ;
    mknd:operating-system "Unix" ;
    mknd:provides mknd:function_shell,
        mknd:function_sudo ;
    mknd:value "dstat" .

