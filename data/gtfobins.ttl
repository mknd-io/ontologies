        owl:NamedIndividual ;
    rdfs:label "socat-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``socat -u tcp-listen:12345,reuseaddr open:file_to_save,creat`` on the attacker box to collect the file." ;
