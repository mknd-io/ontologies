mknd:command_ansible-playbook-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ansible-playbook-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_ansible-playbook ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ansible-playbook ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp)
echo '[{hosts: localhost, tasks: [shell: /bin/sh </dev/tty >/dev/tty 2>/dev/tty]}]' >$TF
ansible-playbook $TF
""" .

mknd:command_ansible-playbook-sudo a d3f:Command,
