mknd:command_gem-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "gem-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This executes the specified file as [`ruby`](/gtfobins/ruby/) code.",
        "This invokes the default editor, which is likely to be [`vi`](/gtfobins/vi/), other functions may apply. This requires the name of an installed gem to be provided (`rdoc` is usually installed).",
        "This requires the name of an installed gem to be provided (`rdoc` is usually installed)." ;
    d3f:uses mknd:executable_gem ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_gem ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp -d)
echo 'system("/bin/sh")' > $TF/x
gem build $TF/x
""",
        """TF=$(mktemp -d)
echo 'system("/bin/sh")' > $TF/x
gem install --file $TF/x
""",
        "gem open -e \"/bin/sh -c /bin/sh\" rdoc",
        """gem open rdoc
:!/bin/sh
""" .

