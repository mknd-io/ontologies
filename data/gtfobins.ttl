mknd:command_split-command a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "split-command" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Command execution using an existing or newly created file.",
        "Command execution using stdin (and close it directly)." ;
    d3f:uses mknd:executable_split ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_split ;
    mknd:provides mknd:function_command ;
    mknd:value """COMMAND=id
TF=$(mktemp)
split --filter=$COMMAND $TF
""",
        """COMMAND=id
echo | split --filter=$COMMAND /dev/stdin
""" .

mknd:command_split-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "split-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
