mknd:command_mail-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "mail-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "GNU version only.",
        "This creates a valid Mbox file which may be required by the binary." ;
    d3f:uses mknd:executable_mail ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_mail ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp)
