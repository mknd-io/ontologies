mknd:command_nroff-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nroff-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_nroff ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nroff ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp -d)
echo '#!/bin/sh' > $TF/groff
