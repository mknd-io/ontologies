mknd:command_sysctl-command a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "sysctl-command" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The command is executed by root in the background when a core dump occurs." ;
    d3f:uses mknd:executable_sysctl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_sysctl ;
    mknd:provides mknd:function_command ;
    mknd:value """COMMAND='/bin/sh -c id>/tmp/id'
sysctl "kernel.core_pattern=|$COMMAND"
sleep 9999 &
kill -QUIT $!
cat /tmp/id
""" .

