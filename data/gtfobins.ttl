mknd:command_arj-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "arj-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The file appears amid some other textual information. The archive can also be downloaded then extracted offline." ;
    d3f:uses mknd:executable_arj ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_arj ;
    mknd:provides mknd:function_file-read ;
    mknd:value """TF=$(mktemp -u)
LFILE=file_to_read
arj a "$TF" "$LFILE"
arj p "$TF"
""" .

mknd:command_arj-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "arj-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The archive can also be prepared offline then uploaded." ;
    d3f:uses mknd:executable_arj ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_arj ;
    mknd:provides mknd:function_file-write ;
    mknd:value """TF=$(mktemp -d)
LFILE=file_to_write
LDIR=where_to_write
echo DATA >"$TF/$LFILE"
arj a "$TF/a" "$TF/$LFILE"
arj e "$TF/a" $LDIR
""" .

mknd:command_arj-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "arj-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
