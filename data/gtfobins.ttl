        owl:NamedIndividual ;
    rdfs:label "puppet-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The file path must be absolute." ;
    d3f:uses mknd:executable_puppet ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_puppet ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE="/tmp/file_to_write"
puppet apply -e "file { '$LFILE': content => 'DATA' }"
""" .

