    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This adds timestamps to the output file. This relies on the external `echo` command." ;
    d3f:uses mknd:executable_rlwrap ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_rlwrap ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
rlwrap -l "$LFILE" echo DATA
""" .

