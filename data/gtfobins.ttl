    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ar ;
    mknd:provides mknd:function_file-read ;
    mknd:value """TF=$(mktemp -u)
LFILE=file_to_read
ar r "$TF" "$LFILE"
cat "$TF"
""" .

