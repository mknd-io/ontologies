    d3f:description "The file is parsed and displayed as a Java `.properties` file, so this may not be suitable to read arbitrary binary data. `/bin/cat` can be replaced with any other *filter* program." ;
    d3f:uses mknd:executable_msgfilter ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_msgfilter ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
msgfilter -P -i "LFILE" /bin/cat
""" .

mknd:command_msgfilter-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "msgfilter-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Any text file will do as the input (use `-i`). `kill` is needed to spawn the shell only once." ;
    d3f:uses mknd:executable_msgfilter ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_msgfilter ;
    mknd:provides mknd:function_shell ;
    mknd:value """echo x | msgfilter -P /bin/sh -c '/bin/sh 0<&2 1>&2; kill $PPID'
""" .

