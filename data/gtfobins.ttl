mknd:command_check_ssl_cert-command a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "check_ssl_cert-command" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The host example.net must return a certificate via TLS" ;
    d3f:uses mknd:executable_check_ssl_cert ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_check_ssl_cert ;
    mknd:provides mknd:function_command ;
    mknd:value """COMMAND=id
OUTPUT=output_file
TF=$(mktemp)
echo "$COMMAND | tee $OUTPUT" > $TF
chmod +x $TF
check_ssl_cert --curl-bin $TF -H example.net
cat $OUTPUT
""" .

mknd:command_check_ssl_cert-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "check_ssl_cert-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "The host example.net must return a certificate via TLS" ;
    d3f:uses mknd:executable_check_ssl_cert ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_check_ssl_cert ;
    mknd:provides mknd:function_sudo ;
    mknd:value """COMMAND=id
OUTPUT=output_file
TF=$(mktemp)
echo "$COMMAND | tee $OUTPUT" > $TF
chmod +x $TF
umask 022
check_ssl_cert --curl-bin $TF -H example.net
cat $OUTPUT
""" .

