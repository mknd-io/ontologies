mknd:command_php-command a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "php-command" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_php ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_php ;
    mknd:provides mknd:function_command ;
    mknd:value """export CMD="id"
php -r '$p = array(array("pipe","r"),array("pipe","w"),array("pipe", "w"));$h = @proc_open(getenv("CMD"), $p, $pipes);if($h&&$pipes){while(!feof($pipes[1])) echo(fread($pipes[1],4096));while(!feof($pipes[2])) echo(fread($pipes[2],4096));fclose($pipes[0]);fclose($pipes[1]);fclose($pipes[2]);proc_close($h);}'
""" .

