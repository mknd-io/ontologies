mknd:command_apt-get-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "apt-get-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This invokes the default pager, which is likely to be [`less`](/gtfobins/less/), other functions may apply." ;
    d3f:uses mknd:executable_apt-get ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_apt-get ;
    mknd:provides mknd:function_shell ;
    mknd:value """apt-get changelog apt
!/bin/sh
""" .

mknd:command_apt-get-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "apt-get-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "For this to work the target package (e.g., `sl`) must not be installed.",
        "This invokes the default pager, which is likely to be [`less`](/gtfobins/less/), other functions may apply.",
        "When the shell exits the `update` command is actually executed." ;
    d3f:uses mknd:executable_apt-get ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_apt-get ;
    mknd:provides mknd:function_sudo ;
    mknd:value """TF=$(mktemp)
echo 'Dpkg::Pre-Invoke {"/bin/sh;false"}' > $TF
sudo apt-get install -c $TF sl
""",
        """sudo apt-get changelog apt
!/bin/sh
""",
        "sudo apt-get update -o APT::Update::Pre-Invoke::=/bin/sh" .

mknd:command_apt-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "apt-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This invokes the default pager, which is likely to be [`less`](/gtfobins/less/), other functions may apply." ;
    d3f:uses mknd:executable_apt ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_apt ;
    mknd:provides mknd:function_shell ;
    mknd:value """apt changelog apt
!/bin/sh
""" .

mknd:command_apt-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "apt-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "For this to work the target package (e.g., `sl`) must not be installed.",
        "This invokes the default pager, which is likely to be [`less`](/gtfobins/less/), other functions may apply.",
        "When the shell exits the `update` command is actually executed." ;
    d3f:uses mknd:executable_apt ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_apt ;
    mknd:provides mknd:function_sudo ;
    mknd:value """TF=$(mktemp)
echo 'Dpkg::Pre-Invoke {"/bin/sh;false"}' > $TF
sudo apt install -c $TF sl
""",
        """sudo apt changelog apt
!/bin/sh
""",
        "sudo apt update -o APT::Update::Pre-Invoke::=/bin/sh" .

mknd:command_ar-file-read a d3f:Command,
        owl:NamedIndividual ;
