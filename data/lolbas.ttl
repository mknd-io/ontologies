    mknd:id "OneDriveStandaloneUpdater" ;
    mknd:operating-system "Windows 10" ;
    mknd:required-privileges "User" ;
    mknd:use-case "Download a file from the Internet without executing any anomalous executables with suspicious arguments" ;
    mknd:value "OneDriveStandaloneUpdater" .

