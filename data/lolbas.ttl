    d3f:enables mknd:technique_T1218 ;
    d3f:may-be-detected-by mknd:detect_Sigma-https%3A%2F%2Fgithub.com%2FSigmaHQ%2Fsigma%2Fblob%2F08ca62cc8860f4660e945805d0dd615ce75258c1%2Frules%2Fwindows%2Fprocess_creation%2Fwin_using_settingsynchost_as_lolbin.yml ;
