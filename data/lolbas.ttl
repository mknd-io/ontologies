    mknd:extCategory "Execute" ;
    mknd:id "SettingSyncHost -LoadAndRunDiagScriptNoCab anything" ;
    mknd:operating-system "Windows 8, Windows 8.1, Windows 10" ;
    mknd:required-privileges "User" ;
    mknd:use-case "Can be used to evade defensive countermeasures or to hide as a persistence mechanism. Additionally, effectively act as a -WindowStyle Hidden option (as there is in PowerShell) for any arbitrary batch file." ;
    mknd:value "SettingSyncHost -LoadAndRunDiagScriptNoCab anything" .

