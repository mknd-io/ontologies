# Every MKND class, object property and datatype property has a definition: skos:definition, rdfs:comment or d3f:definition.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#>
SELECT DISTINCT ?entity ?type WHERE {
  VALUES ?type { owl:Class owl:ObjectProperty owl:DatatypeProperty }
  ?entity a ?type .
  FILTER(isIRI(?entity) && STRSTARTS(STR(?entity), "https://w3id.org/mknd/"))
  FILTER NOT EXISTS {
    VALUES ?property { skos:definition rdfs:comment d3f:definition }
    ?entity ?property ?d .
    FILTER(STR(?d) != "")
  }
}
ORDER BY ?entity
